@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dlo: <http://ns.inria.fr/datalens/ontology/> .
@prefix dlt: <http://ns.inria.fr/datalens/thesaurus/> .

dlt:SubjectScheme a skos:ConceptScheme, dlo:Subject ;
    skos:prefLabel "Subject"@en ;
    skos:definition "Subject concept scheme."@en .

dlt:SubjectScheme skos:hasTopConcept dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment a skos:Concept, dlo:Subject ;
    skos:prefLabel "arts and entertainment"@en ;
    skos:definition "Activities that holds the attention and interest of an audience, or gives pleasure and delight. It can be an idea or a task, but is more likely to be one of the activities or events that have developed over thousands of years specifically for the purpose of keeping an audience's attention."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:topConceptOf dlt:SubjectScheme .

dlt:ArtsAndEntertainment skos:narrower dlt:Art .

dlt:Art a skos:Concept, dlo:Subject ;
    skos:prefLabel "art"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:Celebrities .

dlt:Celebrities a skos:Concept, dlo:Subject ;
    skos:prefLabel "celebrities"@en ;
    skos:definition "Celebrity is the fame and public attention we give to superstars of popular culture like the Kardashian family and Jeff Dean."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:ComicsAndAnimation .

dlt:ComicsAndAnimation a skos:Concept, dlo:Subject ;
    skos:prefLabel "comics and animation"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ComicsAndAnimation skos:narrower dlt:AnimeAndManga .

dlt:AnimeAndManga a skos:Concept, dlo:Subject ;
    skos:prefLabel "anime and manga"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ComicsAndAnimation .

dlt:ArtsAndEntertainment skos:narrower dlt:Dance .

dlt:Dance a skos:Concept, dlo:Subject ;
    skos:prefLabel "dance"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:Literature .

dlt:Literature a skos:Concept, dlo:Subject ;
    skos:prefLabel "literature"@en ;
    skos:definition "This tag is your digital library for varius copora such as Southern Literature, Paranormal Romance novels, and Urban Dictionary spelling variations."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:MoviesAndTvShows .

dlt:MoviesAndTvShows a skos:Concept, dlo:Subject ;
    skos:prefLabel "movies and tv shows"@en ;
    skos:definition "Grab a bucket of popcorn and come analyze these movie ratings. The world must know which blockbuster film is the blockbuster film of all time!"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:Museums .

dlt:Museums a skos:Concept, dlo:Subject ;
    skos:prefLabel "museums"@en ;
    skos:definition "Fun place to hang on a Saturday afternoon and think deep thoughts about deep things. Find datasets and kernels related to various museum collections here."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:Music .

dlt:Music a skos:Concept, dlo:Subject ;
    skos:prefLabel "music"@en ;
    skos:definition "With all the music data out there, it's hard to believe someone hasn't trained robots to perform on stage yet. Or have they?"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:ArtsAndEntertainment skos:narrower dlt:Philosophy .

dlt:Philosophy a skos:Concept, dlo:Subject ;
    skos:prefLabel "philosophy"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:ArtsAndEntertainment .

dlt:SubjectScheme skos:hasTopConcept dlt:CultureAndHumanities .

dlt:CultureAndHumanities a skos:Concept, dlo:Subject ;
    skos:prefLabel "culture and humanities"@en ;
    skos:definition "What is it to be human? What activities and patterns of behavior define us and our societies? This tag will help you tackle these questions."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:topConceptOf dlt:SubjectScheme .

dlt:CultureAndHumanities skos:narrower dlt:Games .

dlt:Games a skos:Concept, dlo:Subject ;
    skos:prefLabel "games"@en ;
    skos:definition "One of the hallmarks of intelligence is the use of games and toys to occupy free time and develop intellectually. Often stored in Mom's basement."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:CultureAndHumanities .

dlt:Games skos:narrower dlt:BoardGames .

dlt:BoardGames a skos:Concept, dlo:Subject ;
    skos:prefLabel "board games"@en ;
    skos:definition "A board game is a tabletop game that involves counters or pieces moved or placed on a pre-marked surface or \"board\", according to a set of rules."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Games .

dlt:Games skos:narrower dlt:CardGames .

dlt:CardGames a skos:Concept, dlo:Subject ;
    skos:prefLabel "card games"@en ;
    skos:definition "A card game is any game using playing cards as the primary device with which the game is played, be they traditional or game-specific. Countless card games exist, including families of related games (such as poker)."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Games .

dlt:Games skos:narrower dlt:Gambling .

dlt:Gambling a skos:Concept, dlo:Subject ;
    skos:prefLabel "gambling"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Games .

dlt:Games skos:narrower dlt:Puzzles .

dlt:Puzzles a skos:Concept, dlo:Subject ;
    skos:prefLabel "puzzles"@en ;
    skos:definition "A puzzle is a game, problem, or toy that tests a person's ingenuity or knowledge. In a puzzle, the solver is expected to put pieces together in a logical way, in order to arrive at the correct solution of the puzzle."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Games .

dlt:Games skos:narrower dlt:VideoGames .

dlt:VideoGames a skos:Concept, dlo:Subject ;
    skos:prefLabel "video games"@en ;
    skos:definition "Video games were originally created to prevent people from going to college and getting good jobs. That back-fired and now we have data centers full of GPUs training models to tell the difference between cats and dogs. All thanks to gamers."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Games .

dlt:VideoGames skos:narrower dlt:Simulations .

dlt:Simulations a skos:Concept, dlo:Subject ;
    skos:prefLabel "simulations"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:VideoGames .

dlt:CultureAndHumanities skos:narrower dlt:Languages .

dlt:Languages a skos:Concept, dlo:Subject ;
    skos:prefLabel "languages"@en ;
    skos:definition "Language is a method of communication that consists of using words arranged into meaningful patterns. This is a good place to find natural language processing datasets and kernels to study languages and train your chat bots."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:CultureAndHumanities .

dlt:CultureAndHumanities skos:narrower dlt:PopularCulture .

dlt:PopularCulture a skos:Concept, dlo:Subject ;
    skos:prefLabel "popular culture"@en ;
    skos:definition "Popular culture datasets and kernels are associated with topics like TV shows, movies, music, and video games. The greatest screenwriters come here to train their AI to write movie scripts."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:CultureAndHumanities .

dlt:SubjectScheme skos:hasTopConcept dlt:CyberSecurity .

dlt:CyberSecurity a skos:Concept, dlo:Subject ;
    skos:prefLabel "cyber security"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:topConceptOf dlt:SubjectScheme .

dlt:SubjectScheme skos:hasTopConcept dlt:EarthAndNature .

dlt:EarthAndNature a skos:Concept, dlo:Subject ;
    skos:prefLabel "earth and nature"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:topConceptOf dlt:SubjectScheme .

dlt:EarthAndNature skos:narrower dlt:Animals .

dlt:Animals a skos:Concept, dlo:Subject ;
    skos:prefLabel "animals"@en ;
    skos:definition "The animals tag is as diverse as a rainforest. Is there a correlation between animal bites and NYC rat sightings? We're not sure. But the data is here and the world needs to know."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:Animals skos:narrower dlt:FishAndAquaria .

dlt:FishAndAquaria a skos:Concept, dlo:Subject ;
    skos:prefLabel "fish and aquaria"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Animals .

dlt:EarthAndNature skos:narrower dlt:Biology .

dlt:Biology a skos:Concept, dlo:Subject ;
    skos:prefLabel "biology"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:Biology skos:narrower dlt:Genetics .

dlt:Genetics a skos:Concept, dlo:Subject ;
    skos:prefLabel "genetics"@en ;
    skos:definition "Human genetics encompasses a variety of overlapping fields including: classical genetics, cytogenetics, molecular genetics, biochemical genetics, genomics, population genetics, developmental genetics, clinical genetics, and genetic counseling."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Biology .

dlt:EarthAndNature skos:narrower dlt:EarthScience .

dlt:EarthScience a skos:Concept, dlo:Subject ;
    skos:prefLabel "earth science"@en ;
    skos:definition "Geology, geography and oceanography. If it's on the Earth and not a plant or animal, this the tag for it."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:EarthScience skos:narrower dlt:AtmosphericScience .

dlt:AtmosphericScience a skos:Concept, dlo:Subject ;
    skos:prefLabel "atmospheric science"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthScience .

dlt:EarthScience skos:narrower dlt:Geography .

dlt:Geography a skos:Concept, dlo:Subject ;
    skos:prefLabel "geography"@en ;
    skos:definition "The geography tag contains datasets and kernels that showcase geospatial analysis and mapping."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthScience .

dlt:EarthScience skos:narrower dlt:Geology .

dlt:Geology a skos:Concept, dlo:Subject ;
    skos:prefLabel "geology"@en ;
    skos:definition "Geology is an earth science concerned with the solid Earth, the rocks of which it is composed, and the processes by which they change over time"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthScience .

dlt:EarthAndNature skos:narrower dlt:Environment .

dlt:Environment a skos:Concept, dlo:Subject ;
    skos:prefLabel "environment"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:Environment skos:narrower dlt:Agriculture .

dlt:Agriculture a skos:Concept, dlo:Subject ;
    skos:prefLabel "agriculture"@en ;
    skos:definition "You could be well on your way to creating the next big precision agriculture company with the resources in this tag. At the very least, you can use Weekly Corn Prices to make more informed decisions about your purchases at the store."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:CitiesAndUrbanAreas .

dlt:CitiesAndUrbanAreas a skos:Concept, dlo:Subject ;
    skos:prefLabel "cities and urban areas"@en ;
    skos:definition "In this tag you will find datasets and kernels about various cities around the world."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:Deserts .

dlt:Deserts a skos:Concept, dlo:Subject ;
    skos:prefLabel "deserts"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:Forestry .

dlt:Forestry a skos:Concept, dlo:Subject ;
    skos:prefLabel "forestry"@en ;
    skos:definition "Forestry is the management of forests. Whether this means planting trees or cutting them down depends a lot on who owns the forest."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:Mountains .

dlt:Mountains a skos:Concept, dlo:Subject ;
    skos:prefLabel "mountains"@en ;
    skos:definition "From the Appalachians to Zwiselbacher Rosskogel, this tag has all the info you need about mountains."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:NaturalDisasters .

dlt:NaturalDisasters a skos:Concept, dlo:Subject ;
    skos:prefLabel "natural disasters"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:Pollution .

dlt:Pollution a skos:Concept, dlo:Subject ;
    skos:prefLabel "pollution"@en ;
    skos:definition "Pollution is the introduction of contaminants into the natural environment that cause adverse change."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:WaterBodies .

dlt:WaterBodies a skos:Concept, dlo:Subject ;
    skos:prefLabel "water bodies"@en ;
    skos:definition "Lakes, oceans, rivers, streams, and infamous puddles."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:Environment skos:narrower dlt:WeatherAndClimate .

dlt:WeatherAndClimate a skos:Concept, dlo:Subject ;
    skos:prefLabel "weather and climate"@en ;
    skos:definition "Weather datasets and kernels come in all wind speeds and directions. You have weather data about hurricanes and other inclement phenomena, hourly readings, and general weather for various cities."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Environment .

dlt:EarthAndNature skos:narrower dlt:PhysicalScience .

dlt:PhysicalScience a skos:Concept, dlo:Subject ;
    skos:prefLabel "physical science"@en ;
    skos:definition "Physical science is a branch of natural science that studies non-living systems, in contrast to life science."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:PhysicalScience skos:narrower dlt:Astronomy .

dlt:Astronomy a skos:Concept, dlo:Subject ;
    skos:prefLabel "astronomy"@en ;
    skos:definition "There are lots of fun datasets here for you to analyze, and who knows, maybe you'll find a habitable planet hidden in the data that no one else saw. Then you could have a planet named after you!"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:PhysicalScience .

dlt:PhysicalScience skos:narrower dlt:Chemistry .

dlt:Chemistry a skos:Concept, dlo:Subject ;
    skos:prefLabel "chemistry"@en ;
    skos:definition "Chemistry addresses topics such as how atoms and molecules interact via chemical bonds to form new chemical compounds."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:PhysicalScience .

dlt:PhysicalScience skos:narrower dlt:Physics .

dlt:Physics a skos:Concept, dlo:Subject ;
    skos:prefLabel "physics"@en ;
    skos:definition "Physics is the natural science that involves the study of matter and its motion and behavior through space and time, along with related concepts such as energy and force."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:PhysicalScience .

dlt:EarthAndNature skos:narrower dlt:Plants .

dlt:Plants a skos:Concept, dlo:Subject ;
    skos:prefLabel "plants"@en ;
    skos:definition "Datasets don't grow on trees but you will find plant-related datasets and kernels here."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:EarthAndNature .

dlt:SubjectScheme skos:hasTopConcept dlt:HealthAndFitness .

dlt:HealthAndFitness a skos:Concept, dlo:Subject ;
    skos:prefLabel "health and fitness"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:topConceptOf dlt:SubjectScheme .

dlt:HealthAndFitness skos:narrower dlt:Exercise .

dlt:Exercise a skos:Concept, dlo:Subject ;
    skos:prefLabel "exercise"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthAndFitness .

dlt:Exercise skos:narrower dlt:Running .

dlt:Running a skos:Concept, dlo:Subject ;
    skos:prefLabel "running"@en ;
    skos:definition "Running will get you nowhere in data science because you have to stand still to analyze data. So let the runners run and let the analysts analyze the runners. The only time a data scientist needs to run is when they're running a model."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Exercise .

dlt:Exercise skos:narrower dlt:Sports .

dlt:Sports a skos:Concept, dlo:Subject ;
    skos:prefLabel "sports"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Exercise .

dlt:Sports skos:narrower dlt:AutoRacing .

dlt:AutoRacing a skos:Concept, dlo:Subject ;
    skos:prefLabel "auto racing"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Baseball .

dlt:Baseball a skos:Concept, dlo:Subject ;
    skos:prefLabel "baseball"@en ;
    skos:definition "Baseball is a bat-and-ball game played between two teams of nine players each who take turns batting and fielding."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Basketball .

dlt:Basketball a skos:Concept, dlo:Subject ;
    skos:prefLabel "basketball"@en ;
    skos:definition "Basketball is one of the world's most popular and widely viewed sports. Analyze Kobe Bryant's shot selections and peruse our annual March Mania competitions."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Cricket .

dlt:Cricket a skos:Concept, dlo:Subject ;
    skos:prefLabel "cricket"@en ;
    skos:definition "Cricket is a sport, but I don't see any reason why there shouldn't be a dataset about crickets here, too."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Football .

dlt:Football a skos:Concept, dlo:Subject ;
    skos:prefLabel "football"@en ;
    skos:definition "Some call it association football, some call it soccer, most call it sport ball. Come analyze the teams and players of the beautiful game."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Golf .

dlt:Golf a skos:Concept, dlo:Subject ;
    skos:prefLabel "golf"@en ;
    skos:definition "Golf is a club and ball sport in which players use various clubs to hit balls into a series of holes on a course in as few strokes as possible."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Hockey .

dlt:Hockey a skos:Concept, dlo:Subject ;
    skos:prefLabel "hockey"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:MartialArts .

dlt:MartialArts a skos:Concept, dlo:Subject ;
    skos:prefLabel "martial arts"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Tennis .

dlt:Tennis a skos:Concept, dlo:Subject ;
    skos:prefLabel "tennis"@en ;
    skos:definition "Tennis is a racket sport that enjoys worldwide popularity among athletes, recreational players, and sports analytics junkies."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:Volleyball .

dlt:Volleyball a skos:Concept, dlo:Subject ;
    skos:prefLabel "volleyball"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:Sports skos:narrower dlt:WaterSports .

dlt:WaterSports a skos:Concept, dlo:Subject ;
    skos:prefLabel "water sports"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Sports .

dlt:HealthAndFitness skos:narrower dlt:Food .

dlt:Food a skos:Concept, dlo:Subject ;
    skos:prefLabel "food"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthAndFitness .

dlt:Food skos:narrower dlt:Alcohol .

dlt:Alcohol a skos:Concept, dlo:Subject ;
    skos:prefLabel "alcohol"@en ;
    skos:definition "Here's to alcohol: the cause of, and solution to, all of life's problems. -- Homer J. Simpson"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Food .

dlt:Food skos:narrower dlt:CookingAndRecipes .

dlt:CookingAndRecipes a skos:Concept, dlo:Subject ;
    skos:prefLabel "cooking and recipes"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Food .

dlt:Food skos:narrower dlt:Restaurants .

dlt:Restaurants a skos:Concept, dlo:Subject ;
    skos:prefLabel "restaurants"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Food .

dlt:HealthAndFitness skos:narrower dlt:Health .

dlt:Health a skos:Concept, dlo:Subject ;
    skos:prefLabel "health"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthAndFitness .

dlt:Health skos:narrower dlt:EarsAndHearing .

dlt:EarsAndHearing a skos:Concept, dlo:Subject ;
    skos:prefLabel "ears and hearing"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Health .

dlt:Health skos:narrower dlt:EyesAndVision .

dlt:EyesAndVision a skos:Concept, dlo:Subject ;
    skos:prefLabel "eyes and vision"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Health .

dlt:Health skos:narrower dlt:HealthConditions .

dlt:HealthConditions a skos:Concept, dlo:Subject ;
    skos:prefLabel "health conditions"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Health .

dlt:HealthConditions skos:narrower dlt:Cancer .

dlt:Cancer a skos:Concept, dlo:Subject ;
    skos:prefLabel "cancer"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthConditions .

dlt:HealthConditions skos:narrower dlt:Diabetes .

dlt:Diabetes a skos:Concept, dlo:Subject ;
    skos:prefLabel "diabetes"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthConditions .

dlt:HealthConditions skos:narrower dlt:Diseases .

dlt:Diseases a skos:Concept, dlo:Subject ;
    skos:prefLabel "diseases"@en ;
    skos:definition "Datasets and kernels related to various diseases. Make sure you wear goggles and gloves before touching these datasets. Also wash your hands."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthConditions .

dlt:Diseases skos:narrower dlt:Covid19 .

dlt:Covid19 a skos:Concept, dlo:Subject ;
    skos:prefLabel "covid19"@en ;
    skos:definition "COVID-19 is a disease that is caused by the SARS-CoV-2 virus. In 2020 there was a global COVID-19 pandemic."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Diseases .

dlt:HealthConditions skos:narrower dlt:HeartConditions .

dlt:HeartConditions a skos:Concept, dlo:Subject ;
    skos:prefLabel "heart conditions"@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:HealthConditions .

dlt:HealthConditions skos:narrower dlt:MentalHealth .

dlt:MentalHealth a skos:Concept, dlo:Subject ;
    skos:prefLabel "mental health"@en ;
