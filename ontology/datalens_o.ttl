@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix mlso: <http://w3id.org/mlso#> .

@prefix dlo: <http://ns.inria.fr/datalens/ontology/> .


dlo: a owl:Ontology ;
    dcterms:title "Datalens Ontology"@en ;
    dcterms:creator "Aline Menin", "Zachari Arnaud", "Catherine Faron", "Anaïs Ollagnier" ;
    dcterms:modified "2026-07-16" ;
    dcterms:description "The Datalens Ontology defines concepts and relationships for describing datasets and machine learning models."@en ;
    owl:versionInfo "1.0" ;
    dcat:landingPage <https://github.com/Wimmics/datalens> ;
    dcterms:license  <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:created "2026"^^xsd:gYear ;
    dcterms:publisher "Inria", "University Côte d'Azur", "CNRS" .


# Class MLResource

dlo:MLResource a owl:Class ;
    rdfs:label "Machine Learning Resource"@en ;
    rdfs:comment "A resource like a dataset or a machine learning model."@en ;
    rdfs:subClassOf prov:Entity .

## Classes related to Resource
dlo:SubTask a owl:Class ;
    rdfs:label "Subtask"@en ;
    rdfs:comment "A specific sub-task or problem that a machine learning model is designed to solve."@en .

dlo:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "A machine learning task, such as text classification, linear regression, etc."@en . 

dlo:Modality a owl:Class ;
    rdfs:label "Modality"@en ;
    rdfs:comment "A type of data modality used in the context of machine learning."@en .

dlo:Library a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment "A machine learning library."@en .

## Properties for Resource
dlo:downloadCount a owl:DatatypeProperty ;
    rdfs:label "download count"@en ;
    rdfs:comment "The number of times a resource has been downloaded."@en ;
    rdfs:domain  dlo:MLResource;
    rdfs:range xsd:integer .

dlo:likesCount a owl:DatatypeProperty ;
    rdfs:label "likes count"@en ;
    rdfs:comment "The number of likes or positive feedback a resource has received."@en ;
    rdfs:domain  dlo:MLResource;    
    rdfs:range xsd:integer .

dlo:viewCount a owl:DatatypeProperty ;
    rdfs:label "view count"@en ;
    rdfs:comment "The number of times a resource has been viewed."@en ;
    rdfs:domain  dlo:MLResource;    
    rdfs:range xsd:integer .

dlo:kernelCount a owl:DatatypeProperty ;
    rdfs:label "kernel count"@en ;
    rdfs:comment "The number of times a resource has been used in a kernel."@en ;
    rdfs:domain  dlo:MLResource;    
    rdfs:range xsd:integer .

dlo:hasModality a owl:ObjectProperty ;
    rdfs:label "has modality"@en ;
    rdfs:comment "Relates a dataset to a specific modality or type of data used in the context of machine learning."@en ;
    rdfs:domain  dlo:MLResource;
    rdfs:range dlo:Modality .

dlo:hasSubTask a owl:ObjectProperty ;
    rdfs:label "has ML subtask"@en ;
    rdfs:comment "Relates a resource to a specific sub-task."@en ;
    rdfs:domain  dlo:MLResource;
    rdfs:range dlo:SubTask .

dlo:hasTask a owl:ObjectProperty ;
    rdfs:label "has ML task"@en ;
    rdfs:comment "Relates a resource to a machine learning task."@en ;
    rdfs:domain  dlo:MLResource;
    rdfs:range dlo:Task .

dlo:hasLibrary a owl:ObjectProperty ;
    rdfs:label "has library"@en ;
    rdfs:comment "Relates a resource to a machine learning library."@en ;
    rdfs:domain  dlo:MLResource;
    rdfs:range dlo:Library .

dlo:hasAcademicArticle a owl:ObjectProperty ;
    rdfs:label "has scientific article"@en ;
    rdfs:comment "Relates a resource to a scholarly article or paper that describes it."@en ;
    rdfs:domain  dlo:MLResource;    
    rdfs:range bibo:AcademicArticle .

# dlo:isAvailable a owl:DatatypeProperty ;
#     rdfs:label "availability status"@en ;
#     rdfs:comment "The availability status of a resource, indicating whether it is enabled or disabled."@en ;
#     rdfs:domain  dlo:MLResource ;
#     rdfs:range  xsd:boolean .


# Class Dataset

dlo:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A dataset published on a platform such as Hugging Face."@en ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:subClassOf dlo:MLResource .

## Classes related to datasets
dlo:SizeCategory a owl:Class ;
    rdfs:label "Size Category"@en ;
    rdfs:comment "Categories for the size of a dataset, according to HuggingFace definition."@en .

dlo:Multilinguality a owl:Class ;
    rdfs:label "Multilinguality"@en ;
    rdfs:comment "A classification of datasets based on the number of languages they cover."@en .

dlo:Annotation a owl:Class ;
    rdfs:subClassOf oa:Annotation ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "A comment or note related to a dataset or a machine learning model."@en .

### Properties for annotations
dlo:annotationMethod a owl:DatatypeProperty ;
    rdfs:label "annotation method"@en ;
    rdfs:comment "The method or technique used to create an annotation for a dataset or a machine learning model."@en ;
    rdfs:domain dlo:Annotation ;
    rdfs:range rdfs:Literal .

dlo:linguisticMethod a owl:DatatypeProperty ;
    rdfs:label "linguistic method"@en ;
    rdfs:comment "The linguistic creation method or approach used in the context of a dataset or a machine learning model."@en ;
    rdfs:domain dlo:Annotation ;
    rdfs:range rdfs:Literal .

## Properties for datasets
dlo:hasAnnotation a owl:ObjectProperty ;
    rdfs:label "has annotation"@en ;
    rdfs:comment "Relates a dataset to its annotations, which provide additional information or context."@en ;
    rdfs:domain dlo:Dataset ;
    rdfs:range dlo:Annotation .

dlo:hasSize a owl:ObjectProperty ;
    rdfs:label "has size"@en ;
    rdfs:comment "Relates a dataset to a size category"@en ;
    rdfs:domain dlo:Dataset ;
    rdfs:range dlo:SizeCategory .

dlo:hasSizeCompressed a owl:DatatypeProperty ;
    rdfs:label "has size compressed"@en ;
    rdfs:comment "Relates a dataset to its compressed size in bytes."@en ;
    rdfs:domain dlo:Dataset ;
    rdfs:range xsd:integer .

dlo:hasSizeUncompressed a owl:DatatypeProperty ;
    rdfs:label "has size uncompressed"@en ;
    rdfs:comment "Relates a dataset to its uncompressed size in bytes."@en ;
    rdfs:domain dlo:Dataset ;
    rdfs:range xsd:integer .

dlo:hasMultilinguality a owl:ObjectProperty ;
    rdfs:label "has multilinguality"@en ;
    rdfs:comment "Relates a dataset to its multilinguality classification."@en ;
    rdfs:domain dlo:Dataset ;
    rdfs:range dlo:Multilinguality .


# Class Model

dlo:Model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "A machine learning model published on a platform such as Hugging Face."@en ;
    rdfs:subClassOf schema:SoftwareSourceCode ;
    rdfs:subClassOf dlo:MLResource .

## Classes related to models
dlo:Transformation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Model Transformation"@en ;
    rdfs:comment "A transformation or modification applied to a machine learning model."@en .

dlo:Diffuser a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Diffuser"@en ;
    rdfs:comment "A process or activity that diffuses or distributes a machine learning model."@en .

dlo:Loss a owl:Class ;
    rdfs:label "Loss"@en ;
    rdfs:comment "A loss function used in the training or evaluation of a machine learning model."@en .

dlo:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    rdfs:comment "The implementation of a machine learning model."@en .
    
dlo:ModelFamily a owl:Class ;
    rdfs:label "Model Family"@en ;
    rdfs:comment "A family or category of machine learning models."@en .

## Properties for models
dlo:wasTrainedOn a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    rdfs:label "was trained on"@en ;
    rdfs:comment "Relates a machine learning model to a dataset used for training or pretraining."@en ;
    rdfs:domain dlo:Model ;
    rdfs:range dlo:Dataset .

dlo:hasModelFamily a owl:ObjectProperty ;
    rdfs:label "has model family"@en ;
    rdfs:comment "Relates a machine learning model to its family."@en ;
    rdfs:domain dlo:Model ;
    rdfs:range dlo:ModelFamily .

dlo:hasImplementation a owl:ObjectProperty ;
    rdfs:label "has implementation"@en ;
    rdfs:comment "Relates a machine learning model to its implementation."@en ;
    rdfs:domain dlo:Model ;
    rdfs:range dlo:Implementation .

dlo:hasLoss a owl:ObjectProperty ;
    rdfs:label "has loss"@en ;
    rdfs:comment "Relates a machine learning model to its loss function."@en ;
    rdfs:domain dlo:Model ;
    rdfs:range dlo:Loss .

dlo:hasDiffuser a owl:ObjectProperty ;
    rdfs:label "has diffuser"@en ;
    rdfs:comment "Relates a machine learning model to its diffuser."@en ;
    rdfs:domain dlo:Model ;
    rdfs:range dlo:Diffuser .

# Class alignments

dlo:MLResource rdfs:subClassOf mls:InformationEntity .
dlo:Dataset rdfs:subClassOf mls:Dataset .
dlo:Model rdfs:subClassOf mls:Model .
dlo:Task rdfs:subClassOf mls:Task .
dlo:Modality rdfs:subClassOf mlso:DataModality .

# Property alignments

dlo:wasTrainedOn rdfs:subPropertyOf mlso:trainedOn .
dlo:hasAcademicArticle rdfs:subPropertyOf mlso:hasScientificReference .
dlo:hasModality rdfs:subPropertyOf mlso:hasModality .