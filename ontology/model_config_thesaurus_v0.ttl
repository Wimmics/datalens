dlt:A2DSarvamMoe a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "A 2 D Sarvam Moe"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:A2N a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "A 2 N"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:A2Zchromatin a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "A 2 Zchromatin"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AaravGpt a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Aarav Gpt"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Abbfn2MultimodalBfn a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Abbfn 2 Multimodal Bfn"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

