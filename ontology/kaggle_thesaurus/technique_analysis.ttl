dlt:ModelExplainability a skos:Concept, dlo:Technique ;
    skos:prefLabel "Model Explainability"@en ;
    skos:definition "Some see machine learning models as \"black boxes\" that are difficult to interpret and explain. For this challenge, you're encouraged to use concepts such as feature importance, perturbation importance, and partial dependence plots to explain the predictions of an ML model."@en ;
