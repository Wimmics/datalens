dlt:PackagesScheme a skos:ConceptScheme ;
    skos:prefLabel "Packages"@en ;
    skos:definition "Controlled vocabulary for the 'Packages' tag category."@en .

dlt:Xgboost a skos:Concept, dlo:Packages ;
    skos:prefLabel "Xgboost"@en ;
    skos:definition "A library that implements the gradient boosting framework onto a wide range of problems including regression and classification. It is optimized for speed and efficiency."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Torchvision a skos:Concept, dlo:Packages ;
    skos:prefLabel "Torchvision"@en ;
    skos:definition "A PyTorch library providing datasets, pretrained model architectures, and image transformations for computer vision tasks."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Seaborn a skos:Concept, dlo:Packages ;
    skos:prefLabel "Seaborn"@en ;
    skos:definition "A Python data visualization library built on Matplotlib, providing high-level functions to create statistical graphics for exploring data and communicating model results."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Sklearn a skos:Concept, dlo:Packages ;
    skos:prefLabel "Sklearn"@en ;
    skos:definition "A Python library providing simple and efficient tools for classical machine learning, including classification, regression, clustering, and model evaluation."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:HuggingFace a skos:Concept, dlo:Packages ;
    skos:prefLabel "Hugging Face"@en ;
    skos:definition "An ecosystem of libraries and pretrained models, most notably Transformers, for natural language processing and other deep learning tasks."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:RapidsAi a skos:Concept, dlo:Packages ;
    skos:prefLabel "Rapids"@en ;
    skos:definition "A suite of open-source libraries that use GPU acceleration to speed up data science and machine learning workflows, such as data processing and model training."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Caret a skos:Concept, dlo:Packages ;
    skos:prefLabel "Caret"@en ;
    skos:definition "An R package (Classification And REgression Training) providing a unified interface for training, tuning, and evaluating a wide range of machine learning models."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Cv2 a skos:Concept, dlo:Packages ;
    skos:prefLabel "Cv 2"@en ;
    skos:definition "The Python interface to OpenCV, a library providing algorithms and tools for image and video processing, widely used in computer vision tasks."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Lightgbm a skos:Concept, dlo:Packages ;
    skos:prefLabel "Lightgbm"@en ;
    skos:definition "A gradient boosting framework based on tree learning algorithms, designed for high performance and low memory usage on large datasets."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Catboost a skos:Concept, dlo:Packages ;
    skos:prefLabel "Catboost"@en ;
    skos:definition "A gradient boosting library that handles categorical features natively, while providing strong out-of-the-box predictive performance."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:RandomForest2 a skos:Concept, dlo:Packages ;
    skos:prefLabel "Random Forest"@en ;
    skos:definition "An R package implementing the random forest algorithm, an ensemble method that combines multiple decision trees for classification and regression."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Rpart a skos:Concept, dlo:Packages ;
    skos:prefLabel "Rpart"@en ;
    skos:definition "An R package implementing recursive partitioning for building classification and regression trees."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Nltk a skos:Concept, dlo:Packages ;
    skos:prefLabel "Nltk"@en ;
    skos:definition "A Python library providing tools and resources for natural language processing, such as tokenization, part-of-speech tagging, and text classification."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Wandb a skos:Concept, dlo:Packages ;
    skos:prefLabel "Wandb"@en ;
    skos:definition "A platform for tracking, visualizing, and comparing machine learning experiments, including metrics, hyperparameters, and model artifacts."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Numpy a skos:Concept, dlo:Packages ;
    skos:prefLabel "Numpy"@en ;
    skos:definition "A Python library providing support for multidimensional arrays and efficient numerical computation, forming the basis of most scientific and machine learning workflows."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Scipy a skos:Concept, dlo:Packages ;
    skos:prefLabel "Scipy"@en ;
    skos:definition "A Python library built on Numpy that provides algorithms for scientific and technical computing, such as optimization, statistics, and linear algebra, commonly used in data science pipelines."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Matplotlib a skos:Concept, dlo:Packages ;
    skos:prefLabel "Matplotlib"@en ;
    skos:definition "A Python library for creating static, animated, and interactive visualizations, widely used to explore data and present machine learning results."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:Plotly a skos:Concept, dlo:Packages ;
    skos:prefLabel "Plotly"@en ;
    skos:definition "A library for building interactive, publication-quality visualizations and dashboards, commonly used to explore data and communicate model results."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .

dlt:PIL a skos:Concept, dlo:Packages ;
    skos:prefLabel "PIL"@en ;
    skos:definition "A Python library (Python Imaging Library, distributed as Pillow) for opening, manipulating, and saving image files, commonly used to prepare image data for computer vision models."@en ;
    skos:topConceptOf dlt:PackagesScheme ;
    skos:inScheme dlt:PackagesScheme .
    



