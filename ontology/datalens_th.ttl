      skos:definition "Abstractive question answering is the task of generating an answer from context that correctly answers the question."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Abstractive QA"@en .

dlt:InstanceSegmentation
      a       skos:Concept , dlo:SubTask ;
