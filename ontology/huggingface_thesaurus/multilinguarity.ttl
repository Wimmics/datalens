dlt:MultilingualityScheme a skos:ConceptScheme ;
    skos:prefLabel "Multilinguality"@en ;
    skos:definition "Controlled vocabulary for describing the number of languages covered by a dataset."@en .

dlt:Monolingual a skos:Concept, dlo:Multilinguality ;
    skos:prefLabel "Monolingual"@en ;
    skos:definition "A dataset whose content is expressed in a single natural language."@en ;
    skos:topConceptOf dlt:MultilingualityScheme ;
    skos:inScheme dlt:MultilingualityScheme .

dlt:Bilingual a skos:Concept, dlo:Multilinguality ;
    skos:prefLabel "Bilingual"@en ;
    skos:definition "A dataset whose content is expressed in exactly two natural languages."@en ;
    skos:topConceptOf dlt:MultilingualityScheme ;
    skos:inScheme dlt:MultilingualityScheme .

dlt:Multilingual a skos:Concept, dlo:Multilinguality ;
    skos:prefLabel "Multilingual"@en ;
    skos:definition "A dataset whose content is expressed in more than two natural languages."@en ;
    skos:topConceptOf dlt:MultilingualityScheme ;
    skos:inScheme dlt:MultilingualityScheme .

dlt:Translation a skos:Concept, dlo:Multilinguality ;
    skos:prefLabel "Translation"@en ;
    skos:definition "A dataset whose content is expressed as a translation from one language to another."@en ;
    skos:topConceptOf dlt:MultilingualityScheme ;
    skos:inScheme dlt:MultilingualityScheme .