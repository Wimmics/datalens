    skos:prefLabel "medicine"@en ;
    skos:definition "Medicine is the science and practice of the diagnosis, treatment, and prevention of disease. We recommend you take two datasets and analyze them in the morning. If that doesn't work, analyze one dataset every four hours."@en ;
    skos:inScheme dlt:SubjectScheme ;
    skos:broader dlt:Health .

