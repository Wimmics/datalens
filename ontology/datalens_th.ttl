dlt:ModelFamilyScheme a skos:ConceptScheme ;
    skos:prefLabel "Model Family Scheme"@en ;
    skos:definition "A controlled vocabulary for describing families of machine learning models that share a common architecture, design principles, or development lineage."@en .

dlt:AFMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "AFMoE"@en ;
    skos:definition "AFMoE (Arcee Foundational Mixture of Experts) is a decoder-only transformer model that extends the Llama architecture with a sparse Mixture of Experts (MoE) approach. The model combines token-choice routing with shared experts and employs several architectural innovations for efficient inference and improved performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/afmoe> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ALBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ALBERT"@en ;
    skos:definition "ALBERT is designed to address memory limitations of scaling and training of BERT. It adds two parameter reduction techniques. The first, factorized embedding parametrization, splits the larger vocabulary embedding matrix into two smaller matrices so you can grow the hidden size without adding a lot more parameters. The second, cross-layer parameter sharing, allows layer to share parameters which keeps the number of learnable parameters lower."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/albert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Apertus a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Apertus"@en ;
    skos:definition "Apertus The model is a decoder-only transformer, pretrained on 15T tokens with a staged curriculum of web, code and math data. The model uses a new xIELU activation function and is trained from scratch with the AdEMAMix optimizer. Post-training included supervised fine-tuning and alignment via QRPO."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/apertus>, <https://huggingface.co/swiss-ai/Apertus-8B-2509> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Arcee a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Arcee"@en ;
    skos:definition "Arcee is a decoder-only transformer model based on the Llama architecture with a key modification: it uses ReLU² (ReLU-squared) activation in the MLP blocks instead of SiLU, following recent research showing improved training efficiency with squared activations. This architecture is designed for efficient training and inference while maintaining the proven stability of the Llama design."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/arcee> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Bamba a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Bamba"@en ;
    skos:definition "Bamba is a 9B parameter decoder-only language model built on the Mamba-2 architecture. It is pretrained in two stages - it starts by training on 2T tokens from the Dolma v1.7 dataset and then trained on an additional 200B tokens from FineWeb and Cosmopedia."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bamba> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BART a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BART"@en ;
    skos:definition "BART is a sequence-to-sequence model that combines the pretraining objectives from BERT and GPT. It's pretrained by corrupting text in different ways like deleting words, shuffling sentences, or masking tokens and learning how to fix it. The encoder encodes the corrupted document and the corrupted text is fixed by the decoder. As it learns to recover the original text, BART gets really good at both understanding and generating language."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bart> ;
    skos:related dlt:BERT, dlt:GPT;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BARThez a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BARThez"@en ;
    skos:definition "BARThez is a BART model designed for French language tasks. Unlike existing French BERT models, BARThez includes a pretrained encoder-decoder, allowing it to generate text as well. This model is also available as a multilingual variant, mBARThez, by continuing pretraining multilingual BART on a French corpus."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/barthez> ;
    skos:related dlt:BART ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BARTpho a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BARTpho"@en ;
    skos:definition "BARTpho is a large-scale Vietnamese sequence-to-sequence model. It offers a word-based and syllable-based version. This model is built on the BART large architecture with its denoising pretraining."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bartpho> ;
    skos:related dlt:BART ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BERT"@en ;
    skos:definition "BERT is a bidirectional transformer pretrained on unlabeled text to predict masked tokens in a sentence and to predict whether one sentence follows another. The main idea is that by randomly masking some tokens, the model can train on text to the left and right, giving it a more thorough understanding. BERT is also very versatile because its learned language representations can be adapted for other NLP tasks by fine-tuning an additional layer or head."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bert> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BertGeneration a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BertGeneration"@en ;
    skos:definition "BertGeneration leverages pretrained BERT checkpoints for sequence-to-sequence tasks with the EncoderDecoderModel architecture. BertGeneration adapts the BERT for generative tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bert-generation> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BertJapanese a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BertJapanese"@en ;
    skos:definition "BERTJapanese is a varient of the BERT model trained on Japanese text."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bert-japanese> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BERTweet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BERTweet"@en ;
    skos:definition "BERTweet shares the same architecture as BERT-base, but it's pretrained like RoBERTa on English Tweets. It performs really well on Tweet-related tasks like part-of-speech tagging, named entity recognition, and text classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bertweet> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BigBird a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BigBird"@en ;
    skos:definition "BigBird is a transformer model built to handle sequence lengths up to 4096 compared to 512 for BERT. Traditional transformers struggle with long inputs because attention gets really expensive as the sequence length grows. BigBird fixes this by using a sparse attention mechanism, which means it doesn’t try to look at everything at once. Instead, it mixes in local attention, random attention, and a few global tokens to process the whole input. This combination gives it the best of both worlds. It keeps the computation efficient while still capturing enough of the sequence to understand it well. Because of this, BigBird is great at tasks involving long documents, like question answering, summarization, and genomic applications."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/big_bird> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BigBirdPegasus a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BigBirdPegasus"@en ;
    skos:definition "BigBirdPegasus is an encoder-decoder (sequence-to-sequence) transformer model for long-input summarization. It extends the BigBird architecture with an additional pretraining objective borrowed from Pegasus called gap sequence generation (GSG). Whole sentences are masked and the model has to fill in the gaps in the document. BigBirdPegasus's ability to keep track of long contexts makes it effective at summarizing lengthy inputs, surpassing the performance of base Pegasus models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bigbird_pegasus> ;
    skos:related dlt:BigBird, dlt:Pegasus ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BioGPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BioGPT"@en ;
    skos:definition "BioGPT is a generative Transformer model based on GPT-2 and pretrained on 15 million PubMed abstracts. It is designed for biomedical language tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/biogpt> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BitNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BitNet"@en ;
    skos:definition "BitNet is an open-source, native 1-bit Large Language Model (LLM) with 2 billions parameters. BitNet is transformer-based, modified with BitLinear layers (BitNet framework). It uses Rotary Position Embeddings (RoPE), squared ReLU (ReLU²) activation in FFN layers and employs subln normalization."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bitnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Blenderbot a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Blenderbot"@en ;
    skos:definition "BlenderBot is a family of encoder-decoder Transformer models designed for open-domain dialogue generation by combining conversational skills, knowledge grounding, and retrieval-based information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/blenderbot> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BlenderbotSmall a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Blenderbot Small"@en ;
    skos:definition "Blenderbot Small is a smaller variant (in numbers of parameters) of the Blanderbot model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/blenderbot-small> ;
    skos:related dlt:Blenderbot ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BLOOM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BLOOM"@en ;
    skos:definition "The BLOOM model has been proposed with its various versions through the BigScience Workshop. BigScience is inspired by other open science initiatives where researchers have pooled their time and resources to collectively achieve a higher impact. The architecture of BLOOM is essentially similar to GPT3 (auto-regressive model for next token prediction), but has been trained on 46 different languages and 13 programming languages. Several smaller versions of the models have been trained on the same dataset."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bloom> ;
    skos:related dlt:GPT3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BLT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BLT"@en ;
    skos:definition "BLT is a byte-level LLM that achieves tokenization-level performance through entropy-based dynamic patching."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/blt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ByT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ByT5"@en ;
    skos:definition "ByT5 is tokenizer-free version of the T5 model designed to works directly on raw UTF-8 bytes. This means it can process any language, more robust to noise like typos, and simpler to use because it doesn't require a preprocessing pipeline."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/byt5> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CamemBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CamemBERT"@en ;
    skos:definition "CamemBERT is a language model based on RoBERTa, but trained specifically on French text from the OSCAR dataset, making it more effective for French language tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/camembert> ;
    skos:related dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CANINE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CANINE"@en ;
    skos:definition "CANINE is a tokenization-free Transformer. It skips the usual step of splitting text into subwords or wordpieces and processes text character by character. That means it works directly with raw Unicode, making it especially useful for languages with complex or inconsistent tokenization rules and even noisy inputs like typos. Since working with characters means handling longer sequences, CANINE uses a smart trick. The model compresses the input early on (called downsampling) so the transformer doesn't have to process every character individually. This keeps things fast and efficient."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/canine> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CodeGen a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CodeGen"@en ;
    skos:definition "CodeGen is an autoregressive language model for program synthesis trained sequentially on The Pile, BigQuery, and BigPython."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/codegen> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CodeLlama a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Code Llama"@en ;
    skos:definition "Code Llama is a specialized family of large language models based on Llama 2 for coding tasks. It comes in different flavors - general code, Python-specific, and instruction-following variant - all available in 7B, 13B, 34B, and 70B parameters. Code Llama models can generate, explain, and even fill in missing parts of your code (called \"infilling\"). It can also handle very long contexts with stable generation up to 100k tokens, even though it was trained on sequences of 16K tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/code_llama> ;
    skos:related dlt:Llama2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cohere a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cohere"@en ;
    skos:definition "Cohere Command-R (Cohere) is a 35B parameter multilingual large language model designed for long context tasks like retrieval-augmented generation (RAG) and calling external APIs and tools. The model is specifically trained for grounded generation and supports both single-step and multi-step tool use. It supports a context length of 128K tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cohere> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cohere2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cohere 2"@en ;
    skos:definition "Cohere Command R7B (Cohere 2) is an open weights research release of a 7B billion parameter model. It is a multilingual model trained on 23 languages and has a context window of 128k. The model features three layers with sliding window attention and ROPE for efficient local context modeling and relative positional encoding. A fourth layer uses global attention without positional embeddings, enabling unrestricted token interactions across the entire sequence."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cohere2> ;
    skos:related dlt:Cohere ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cohere2MoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cohere 2 MoE"@en ;
    skos:definition "Cohere Command A+ (Cohere 2 MoE) is a Mixture-of-Experts (MoE) language model from Cohere. It features a hybrid attention pattern combining sliding window and full attention layers, shared and routed experts, and supports a very large context window."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cohere2_moe> ;
    skos:related dlt:Cohere ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ConvBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ConvBERT"@en ;
    skos:definition "ConvBERT is a variant of the BERT model that combines self-attention with dynamic convolution. Instead of using self-attention for every part of the input, ConvBERT replaces some attention heads with convolution layers to better capture local context (nearby words)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/convbert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CPM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CPM"@en ;
    skos:definition "CPM is a family of decoder-only Transformer language models designed for Chinese natural language understanding and generation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cpm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CPMAnt a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CPMAnt"@en ;
    skos:definition "CPMAnt is based on CPM but scales the model to 10B parameters and supports delta tuning for efficient adaptation to downstream Chinese language tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cpmant> ;
    skos:related dlt:CPM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CTRL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CTRL"@en ;
    skos:definition "CTRL is a causal (unidirectional) transformer pre-trained using language modeling on a very large corpus of ~140 GB of text data with the first token reserved as a control code (such as Links, Books, Wikipedia etc.)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ctrl> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DBRX a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DBRX"@en ;
    skos:definition "DBRX is a transformer-based decoder-only large language model (LLM) that was trained using next-token prediction. It uses a fine-grained mixture-of-experts (MoE) architecture with 132B total parameters of which 36B parameters are active on any input. It was pre-trained on 12T tokens of text and code data. Compared to other open MoE models like Mixtral-8x7B and Grok-1, DBRX is fine-grained, meaning it uses a larger number of smaller experts. DBRX has 16 experts and chooses 4, while Mixtral-8x7B and Grok-1 have 8 experts and choose 2. This provides 65x more possible combinations of experts and we found that this improves model quality. DBRX uses rotary position encodings (RoPE), gated linear units (GLU), and grouped query attention (GQA). It is a BPE based model and uses the GPT-4 tokenizer as described in the tiktoken repository. We made these choices based on exhaustive evaluation and scaling experiments."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dbrx> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeBERTa a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeBERTa"@en ;
    skos:definition "DeBERTa improves the pretraining efficiency of BERT and RoBERTa with two key ideas, disentangled attention and an enhanced mask decoder. Instead of mixing everything together like BERT, DeBERTa separates a word's content from its position and processes them independently. This gives it a clearer sense of what's being said and where in the sentence it's happening."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deberta> ;
    skos:related dlt:BERT, dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeBERTaV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeBERTa-v2"@en ;
    skos:definition "DeBERTa-v2 improves on the original DeBERTa architecture by using a SentencePiece-based tokenizer and a new vocabulary size of 128K. It also adds an additional convolutional layer within the first transformer layer to better learn local dependencies of input tokens. Finally, the position projection and content projection matrices are shared in the attention layer to reduce the number of parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deberta-v2> ;
    skos:related dlt:DeBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepSeekOCR2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeepSeek-OCR-2"@en ;
    skos:definition "DeepSeek-OCR-2 is an OCR-specialized vision-language model built on a distinctive architecture: a SAM ViT-B vision encoder feeds into a Qwen2 hybrid attention encoder, which is connected through an MLP projector to a DeepSeek-V2 Mixture-of-Experts (MoE) language model. A key feature of the model is its hybrid attention mechanism, which applies bidirectional attention over image tokens and causal attention over query tokens, enabling efficient and accurate document understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_ocr2> ;
    skos:related dlt:DeepseekV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepSeekV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeepSeek-V2"@en ;
    skos:definition "DeepSeek-V2 is a Transformer-based Mixture-of-Experts language model that uses Multi-head Latent Attention and DeepSeekMoE to improve inference efficiency and reduce training costs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_v2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepSeekV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeepSeek-V3"@en ;
    skos:definition "DeepSeek-V3 is based on DeepSeek-V2 but improves the Mixture-of-Experts architecture with auxiliary-loss-free load balancing and introduces multi-token prediction for enhanced performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_v3> ;
    skos:related dlt:DeepSeekV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepSeekV32 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeepSeek-V3.2"@en ;
    skos:definition "DeepSeek-V3.2-Exp is an experimental release from DeepSeek-AI that introduces DeepSeek Sparse Attention (DSA), a trainable, fine-grained sparse attention mechanism designed to improve training and inference efficiency in long-context scenarios. It is built directly on top of DeepSeek-V3.1-Terminus: the model keeps the same 685B-parameter Mixture-of-Experts (MoE) backbone and Multi-head Latent Attention (MLA), and is obtained through continued training that adds the sparse-attention indexer while deliberately aligning the training distribution with V3.1-Terminus so the two models can be compared head-to-head."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_v32> ;
    skos:related dlt:DeepSeekV3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepSeekV4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeepSeek-V4"@en ;
    skos:definition "DeepSeek-V4 is the next-generation MoE language model from DeepSeek (paper). The architecture replaces DeepSeek-V3's Multi-head Latent Attention (MLA) with a hybrid local + long-range design, swaps residual connections for Manifold-Constrained Hyper-Connections (mHC), and bootstraps the first few MoE layers with a static token-id → expert-id hash table."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_v4> ;
    skos:related dlt:DeepSeekV3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DialoGPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DialoGPT"@en ;
    skos:definition "DialoGPT is a GPT2 Model trained on 147M conversation-like exchanges extracted from Reddit."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dialogpt> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DiffLlama a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DiffLlama"@en ;
    skos:definition "DiffLlama is a variant of the Llama language model that integrates the Differential Transformer attention mechanism."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/diffllama> ;
    skos:related dlt:Llama ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DistilBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DistilBERT"@en ;
    skos:definition "DistilBERT is pretrained by knowledge distillation to create a smaller model with faster inference and requires less compute to train. Through a triple loss objective during pretraining, language modeling loss, distillation loss, cosine-distance loss, DistilBERT demonstrates similar performance to a larger transformer language model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/distilbert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Doge a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Doge"@en ;
    skos:definition "Doge is a series of small language models based on the Doge architecture, aiming to combine the advantages of state-space and self-attention algorithms, calculate dynamic masks from cached value states using the zero-order hold method, and solve the problem of existing mainstream language models getting lost in context. It uses the wsd_scheduler scheduler to pre-train on the smollm-corpus, and can continue training on new datasets or add sparse activation feedforward networks from stable stage checkpoints."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/doge> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Dots1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "dots.llm1"@en ;
    skos:definition "dots.llm1 is a 142B-parameter mixture-of-experts model that activates 14B parameters per token, using top-6-of-128 routed experts plus 2 shared experts. It delivers performance on par with Qwen2.5-72B while significantly reducing training and inference costs. Notably, no synthetic data was used during pretraining."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dots1> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DPR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DPR"@en ;
    skos:definition "Dense Passage Retrieval (DPR) is a set of tools and models for question-answering. DPR consists in three models: a Question encoder that encodes questions as vectors, a Context encoder that encodes contexts as vectors and a Reader that extracts the answer of the questions inside retrieved contexts, along with a relevance score (high if the inferred span actually answers the question)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dpr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ELECTRA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ELECTRA"@en ;
    skos:definition "ELECTRA modifies the pretraining objective of traditional masked language models like BERT. Instead of just masking tokens and asking the model to predict them, ELECTRA trains two models, a generator and a discriminator. The generator replaces some tokens with plausible alternatives and the discriminator (the model you'll actually use) learns to detect which tokens are original and which were replaced. This training approach is very efficient and scales to larger models while using considerably less compute."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/electra> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ERNIE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ERNIE"@en ;
    skos:definition "ERNIE (Enhanced Representation through kNowledge IntEgration) is designed to learn language representation enhanced by knowledge masking strategies, which includes entity-level masking and phrase-level masking. ERNIE1.0, ERNIE2.0, ERNIE3.0, ERNIE-Gram, ERNIE-health are a series of powerful models proposed by baidu, especially in Chinese tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ernie> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ernie45 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ernie 4.5"@en ;
    skos:definition "The Ernie 4.5 model was released in the Ernie 4.5 Model Family release by baidu. This family of models contains multiple different architectures and model sizes. This model in specific targets the base text model without mixture of experts (moe) with 0.3B parameters in total. It uses the standard Llama at its core."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ernie4_5> ;
    skos:related dlt:ERNIE ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ernie45MoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ernie 4.5 MoE"@en ;
    skos:definition "The Ernie 4.5 MoE model was released in the Ernie 4.5 Model Family release by baidu. This family of models contains multiple different architectures and model sizes. This model in specific targets the base text model with mixture of experts (moe) - one with 21B total, 3B active parameters and another one with 300B total, 47B active parameters. It uses the standard Llama at its core combined with a specialized MoE based on Mixtral with additional shared experts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ernie4_5_moe> ;
    skos:related dlt:Ernie45 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ESM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ESM"@en ;
    skos:definition "ESM (Evolutionary Scale Modeling) is a family of transformer-based protein language models trained on large-scale protein sequence data using self-supervised learning. ESM models learn rich representations of protein sequences that can be used for tasks such as protein structure prediction, function prediction, and mutation effect prediction. The ESM family includes ESM-1, ESM-2, and ESMFold, with ESMFold enabling fast and accurate prediction of 3D protein structures directly from amino acid sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/esm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EuroBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EuroBERT"@en ;
    skos:definition "EuroBERT is a multilingual encoder model based on a refreshed transformer architecture, akin to Llama but with bidirectional attention. It supports a mixture of European and widely spoken languages, with sequences of up to 8192 tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/eurobert> ;
    skos:related dlt:BERT, dlt:Llama ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EXAONE4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EXAONE 4.0"@en ;
    skos:definition "EXAONE 4.0 model is the language model, which integrates a Non-reasoning mode and Reasoning mode to achieve both the excellent usability of EXAONE 3.5 and the advanced reasoning abilities of EXAONE Deep. To pave the way for the agentic AI era, EXAONE 4.0 incorporates essential features such as agentic tool use, and its multilingual capabilities are extended to support Spanish in addition to English and Korean."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/exaone4> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EXAONE45 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EXAONE 4.5"@en ;
    skos:definition "EXAONE 4.5 model is the first open-weight vision language model developed by LG AI Research. Integrating a dedicated visual encoder into the existing EXAONE 4.0 framework, we expand the model's capability toward multimodality. EXAONE 4.5 features 33 billion parameters in total, including 1.2 billion parameters from the vision encoder. EXAONE 4.5 achieves competitive performance in general benchmark while outperforming SOTA models of similar size in document understanding and Korean contextual reasoning, inheriting powerful language capabilities from our previous language models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/exaone4_5> ;
    skos:related dlt:EXAONE4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EXAONEMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "K-EXAONE"@en ;
    skos:definition "K-EXAONE model is a large-scale multilingual language model developed by LG AI Research. Built using a Mixture-of-Experts architecture named EXAONE-MoE, K-EXAONE features 236 billion total parameters, with 23 billion active during inference. Performance evaluations across various benchmarks demonstrate that K-EXAONE excels in reasoning, agentic capabilities, general knowledge, multilingual understanding, and long-context processing."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/exaone_moe> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Falcon a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Falcon"@en ;
    skos:definition "Falcon is a family of large language models, available in 7B, 40B, and 180B parameters, as pretrained and instruction tuned variants. This model focuses on scaling pretraining over three categories, performance, data, and hardware. Falcon uses multigroup attention to significantly reduce inference memory requirements and rotary positional embeddings (RoPE). These models are pretrained on RefinedWeb, a high-quality and deduplicated 5T token dataset."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/falcon> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Falcon3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Falcon 3"@en ;
    skos:definition "Falcon3 represents a natural evolution from previous releases, emphasizing expanding the models' science, math, and code capabilities. This iteration includes five base models: Falcon3-1B-Base, Falcon3-3B-Base, Falcon3-Mamba-7B-Base, Falcon3-7B-Base, and Falcon3-10B-Base. In developing these models, we incorporated several key innovations aimed at improving the models' performances while reducing training costs:"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/falcon3> ;
    skos:related dlt:Falcon ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FalconH1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FalconH1"@en ;
    skos:definition "FalconH1 is a family of hybrid language models that combines Transformer attention with Mamba-based state space model (SSM) components"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/falcon_h1>, <https://github.com/tiiuae/Falcon-H1> ;
    skos:related dlt:Falcon, dlt:Mamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FalconMamba a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FalconMamba"@en ;
    skos:definition "FalconMamba is a 7B large language model, available as pretrained and instruction-tuned variants, based on the Mamba. This model implements a pure Mamba design that focuses on computational efficiency while maintaining strong performance. FalconMamba is significantly faster at inference and requires substantially less memory for long sequence generation. The models are pretrained on a diverse 5.8T token dataset including RefinedWeb, technical content, code, and mathematical data."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/falcon_mamba> ;
    skos:related dlt:Falcon, dlt:Mamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FLANT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FLAN-T5"@en ;
    skos:definition "FLAN-T5 is an instruction-tuned version of the T5 model that is fine-tuned in a mixture of tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/flan-t5> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FLANUL2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FLAN-UL2"@en ;
    skos:definition "Flan-UL2 is an encoder decoder model based on the T5 architecture. It uses the same configuration as the UL2 model released earlier last year. It was fine tuned using the \"Flan\" prompt tuning and dataset collection. Similar to Flan-T5, one can directly use FLAN-UL2 weights without finetuning the model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/flan-ul2> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FlauBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FlauBERT"@en ;
    skos:definition "FlauBERT is a French transformer-based language model based on the BERT architecture and pre-trained on a large-scale French corpus using masked language modeling."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/flaubert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FlexOlmo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FlexOlmo"@en ;
    skos:definition "FlexOlmo is a new class of language models (LMs) that supports (1) distributed training without data sharing, where different model parameters are independently trained on closed datasets, and (2) data-flexible inference, where these parameters along with their associated data can be flexibly included or excluded from model inferences with no further training. FlexOlmo employs a mixture-of-experts (MoE) architecture where each expert is trained independently on closed datasets and later integrated through a new domain-informed routing without any joint training. FlexOlmo is trained on FlexMix, a corpus we curate comprising publicly available datasets alongside seven domain-specific sets, representing realistic approximations of closed sets."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/flex_olmo> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FNet"@en ;
    skos:definition "The FNet model replaces the self-attention layer in a BERT model with a fourier transform which returns only the real parts of the transform. The model is significantly faster than the BERT model because it has fewer parameters and is more memory efficient. The model achieves about 92-97% accuracy of BERT counterparts on GLUE benchmark, and trains much faster than the BERT model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/fnet> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FSMT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FSMT"@en ;
    skos:definition "FSMT (FairSeq MachineTranslation) model is based on the Transformer encoder-decoder architecture and uses large BPE-based Transformer models trained with the Fairseq sequence modeling toolkit for neural machine translation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/fsmt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Funnel a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Funnel Transformer"@en ;
    skos:definition "The Funnel Transformer model is a bidirectional transformer model, like BERT, but with a pooling operation after each block of layers, a bit like in traditional convolutional neural networks (CNN) in computer vision."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/funnel> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Fuyu a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Fuyu"@en ;
    skos:definition "Fuyu-8B, a decoder-only multimodal model based on the classic transformers architecture, with query and key normalization. A linear encoder is added to create multimodal embeddings from image inputs. By treating image tokens like text tokens and using a special image-newline character, the model knows when an image line ends. Image positional embeddings are removed. This avoids the need for different training phases for various image resolutions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/fuyu> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma"@en ;
    skos:definition "Gemma is a family of lightweight language models with pretrained and instruction-tuned variants, available in 2B and 7B parameters. The architecture is based on a transformer decoder-only design. It features Multi-Query Attention, rotary positional embeddings (RoPE), GeGLU activation functions, and RMSNorm layer normalization."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 2"@en ;
    skos:definition "Gemma 2 is a family of language models with pretrained and instruction-tuned variants, available in 2B, 9B, 27B parameters. The architecture is similar to the previous Gemma, except it features interleaved local attention (4096 tokens) and global attention (8192 tokens) and grouped-query attention (GQA) to increase inference performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma2> ;
    skos:related dlt:Gemma ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-4"@en ;
    skos:definition "GLM-4 is a family of multilingual large language models optimized through large-scale pretraining and multi-stage alignment for reasoning, instruction following, long-context processing, and tool-assisted tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4Moe a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-4 MoE"@en ;
    skos:definition "GLM-4 MoE is a Mixture-of-Experts language model in the GLM-4 family that combines sparse expert activation with hybrid reasoning to support reasoning, coding, and autonomous agent tasks efficiently."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm4_moe> ;
    skos:related dlt:GLM4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4MoeLite a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-4 Moe Lite"@en ;
    skos:definition "GLM4MoeLite (GLM-4.7-Flash) is a 30B-parameter mixture-of-experts model with approximately 3B active parameters per token, designed for lightweight deployment that balances performance and efficiency. It is part of the GLM-4.7 family and supports interleaved thinking capabilities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm4_moe_lite> ;
    skos:related dlt:GLM4Moe ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4Image a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-Image"@en ;
    skos:definition "GLM-Image is an image generation model adopts a hybrid autoregressive + diffusion decoder architecture, effectively pushing the upper bound of visual fidelity and fine-grained details. In general image generation quality, it aligns with industry-standard LDM-based approaches, while demonstrating significant advantages in knowledge-intensive image generation scenarios."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm_image> ;
    skos:related dlt:GLM4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4MoEDSA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM MoE DSA"@en ;
    skos:definition "GLM MoE DSA is a Mixture-of-Experts language model that uses DeepSeek Sparse Attention to enable efficient long-context processing for reasoning, coding, and autonomous agent tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm_moe_dsa> ;
    skos:related dlt:GLM4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT"@en ;
    skos:definition "GPT (Generative Pre-trained Transformer) focuses on effectively learning text representations and transferring them to tasks. This model trains the Transformer decoder to predict the next word, and then fine-tuned on labeled data. GPT can generate high-quality text, making it well-suited for a variety of natural language understanding tasks such as textual entailment, question answering, semantic similarity, and document classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/openai-gpt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTNeo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-Neo"@en ;
    skos:definition "GPT-Neo is an open-source alternative to GPT-2 and GPT-3 models, built with Mesh TensorFlow for TPUs. GPT-Neo uses local attention in every other layer for more efficiency. It is trained on the Pile, a diverse dataset consisting of 22 smaller high-quality datasets."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt_neo> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTNeox a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-Neox"@en ;
    skos:definition "GPT-NeoX extends GPT-3-like architectures with rotary positional embeddings, parallel residual connections, and large-scale distributed training to improve scalability and performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt_neox> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTNeoxJapanese a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-NeoX-Japanese"@en ;
    skos:definition "GPT-NeoX-Japanese, a Japanese language model based on GPT-NeoX. Japanese uses three types of characters (hiragana, katakana, kanji) and has a huge vocabulary. This model uses BPEEncoder V2, a sub-word tokenizer to handle the different characters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt_neox_japanese> ;
    skos:related dlt:GPTNeox ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTJ a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-J"@en ;
    skos:definition "The GPT-J is a GPT-2-like causal language model trained on the Pile dataset."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gptj> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPT2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-2"@en ;
    skos:definition "GPT-2 is a scaled up version of GPT, a causal transformer language model, with 10x more parameters and training data. The model was pretrained on a 40GB dataset to predict the next word in a sequence based on all the previous words. This approach enabled the model to perform many downstream tasks in a zero-shot setting."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt2> ;
    skos:related dlt:GPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTBigCode a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPTBigCode"@en ;
    skos:definition "The GPTBigCode model is an optimized GPT2 model designed for code understanding and generation with support for Multi-Query Attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt_bigcode> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTOss a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPTOss"@en ;
    skos:definition "GPTOss is a sparse mixture-of-experts (MoE) language model from OpenAI that routes each token to 4 of 128 experts. It uses attention sinks — learnable auxiliary tokens appended to each attention head — and YaRN rotary embeddings for sequences up to 131k tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt_oss> ;
    skos:related dlt:GPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GPTSw3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT-Sw3"@en ;
    skos:definition "GPT-Sw3 is a collection of large decoder-only pretrained transformer language models developed for multilingual language understanding and generation, with emphasis on the Nordic languages. GPT-Sw3 has been trained on a dataset containing 320B tokens in Swedish, Norwegian, Danish, Icelandic, English, and programming code. The model was pretrained using a causal language modeling (CLM) objective utilizing the NeMo Megatron GPT implementation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt-sw3> ;
    skos:related dlt:GPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Granite a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Granite"@en ;
    skos:definition "Granite is a 3B parameter language model trained with the Power scheduler. Discovering a good learning rate for pretraining large language models is difficult because it depends on so many variables (batch size, number of training tokens, etc.) and it is expensive to perform a hyperparameter search. The Power scheduler is based on a power-law relationship between the variables and their transferability to larger models. Combining the Power scheduler with Maximum Update Parameterization (MUP) allows a model to be pretrained with one set of hyperparameters regardless of all the variables."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granite> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GraniteMoE"@en ;
    skos:definition "PowerMoE-3B (GraniteMoE) is a 3B sparse Mixture-of-Experts (sMoE) language model trained with the Power learning rate scheduler. It sparsely activates 800M parameters for each token. It is trained on a mix of open-source and proprietary datasets. PowerMoE-3B has shown promising results compared to other dense models with 2x activate parameters across various benchmarks, including natural language multi-choices, code generation, and math reasoning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granitemoe> ;
    skos:related dlt:Granite ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteMoEHybrid a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GraniteMoEHybrid"@en ;
    skos:definition "The GraniteMoEHybrid model builds on top of GraniteMoESharedModel and Bamba. Its decoding layers consist of state space layers or MoE attention layers with shared experts. By default, the attention layers do not use positional encoding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granitemoehybrid> ;
    skos:related dlt:GraniteMoEShared, dlt:Bamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteMoEShared a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GraniteMoEShared"@en ;
    skos:definition "Granite MoE Shared is a variant of the GraniteMoE model that adds shared experts for Moe."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granitemoeshared> ;
    skos:related dlt:GraniteMoE ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Helium a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Helium-1"@en ;
    skos:definition "Helium-1 preview is a lightweight language model with 2B parameters, targeting edge and mobile devices. It supports the following languages: English, French, German, Italian, Portuguese, Spanish."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/helium> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HerBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HerBERT"@en ;
    skos:definition "The HerBERT model is a BERT-based Language Model trained on Polish Corpora using only MLM objective with dynamic masking of whole words."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/herbert> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HRMText a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HRM-Text"@en ;
    skos:definition "HRM-Text is the improved autoregressive language-modeling variant of the Hierarchical Reasoning Model (HRM, Hierarchical Reasoning Model) by the Sapient AI team. It is a base model that uses a hierarchical recurrent forward — two transformer stacks (H for slow, abstract planning, and L for fast, detailed computation) are reused inside a nested recurrence:"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hrm_text> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HunYuanDenseV1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HunYuanDenseV1"@en ;
    skos:definition "HunYuanDenseV1 is Tencent's dense language model series, available in sizes from 0.5B to 7B parameters. It supports chain-of-thought reasoning and long-context processing, and is designed for efficient deployment across a range of hardware configurations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hunyuan_v1_dense> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HunYuanMoEV1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HunYuanMoEV1"@en ;
    skos:definition "HunYuanMoEV1 is Tencent's mixture-of-experts language model with 80B total parameters and 13B active parameters per token. It uses fine-grained expert routing with Grouped Query Attention, supports 256K context length, and offers dual-mode reasoning (fast and slow thinking)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hunyuan_v1_moe> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HunYuanVL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Hunyuan Vl"@en ;
    skos:definition "HunYuanVL is a vision-language model for image-text understanding and generation proposed in HunyuanOCR Technical Report . The open-source hunyuan_vl integration in Transformers is a dense-only image-text variant tailored for OCR and document understanding style workloads such as tencent/HunyuanOCR)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hunyuan_vl> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HyperCLOVAX a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HyperCLOVA X"@en ;
    skos:definition "HyperCLOVA X SEED Think is NAVER Cloud's language model combining pruning and knowledge distillation with advanced reasoning capabilities. The 14B model features a Transformer-based architecture with Peri-Layer Normalization and Maximal Update Parameterization (μP), 14.74B parameters, and 32k context length. It supports dual-mode reasoning (think / non-think) and function calling via a ChatML-based format."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hyperclovax> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HYV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Hy3-preview"@en ;
    skos:definition "Hy3-preview is a large-scale Mixture-of-Experts (MoE) language model developed by the Tencent HunYuan team. It features a dense-MoE hybrid architecture with 192 routed experts and 1 always-active shared expert per MoE layer, achieving strong performance with efficient inference via sparse expert activation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hy_v3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:IBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "I-BERT"@en ;
    skos:definition "The I-BERT model is a quantized version of RoBERTa running inference up to four times faster."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ibert> ;
    skos:related dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Jais2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Jais2"@en ;
    skos:definition "Jais2 a next-generation Arabic open-weight LLM trained on the richest Arabic-first dataset to date. Built from the ground up with 8B and 70B parameters, Jais 2 understands Arabic the way it's truly spoken across dialects, cuulutre, and modern expression. It is developed by MBZUAI, Inception and Cerebras Systems and based on the transformer architecture with modifications including:"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/jais2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Jamba a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Jamba"@en ;
    skos:definition "Jamba is a hybrid Transformer-Mamba mixture-of-experts (MoE) language model ranging from 52B to 398B total parameters. This model aims to combine the advantages of both model families, the performance of transformer models and the efficiency and longer context (256K tokens) of state space models (SSMs) like Mamba."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/jamba> ;
    skos:related dlt:Mamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:JetMoe a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "JetMoe"@en ;
    skos:definition "JetMoe-8B is an 8B Mixture-of-Experts (MoE) language model developed by Yikang Shen and MyShell. JetMoe project aims to provide a LLaMA2-level performance and efficient language model with a limited budget. To achieve this goal, JetMoe uses a sparsely activated architecture inspired by the ModuleFormer. Each JetMoe block consists of two MoE layers: Mixture of Attention Heads and Mixture of MLP Experts. Given the input tokens, it activates a subset of its experts to process them. This sparse activation schema enables JetMoe to achieve much better training throughput than similar size dense models. The training throughput of JetMoe-8B is around 100B tokens per day on a cluster of 96 H100 GPUs with a straightforward 3-way pipeline parallelism strategy."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/jetmoe> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:JinaEmbeddingsV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Jina-Embeddings-v3"@en ;
    skos:definition "The Jina-Embeddings-v3 is a multilingual, multi-task text embedding model designed for a variety of NLP applications. Based on the XLM-RoBERTa architecture, this model supports Rotary Position Embeddings (RoPE) replacing absolute position embeddings to support long input sequences up to 8192 tokens. Additionally, it features 5 built-in Task-Specific LoRA Adapters: that allow the model to generate task-specific embeddings (e.g., for retrieval vs. classification) without increasing inference latency significantly."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/jina_embeddings_v3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Laguna a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Laguna"@en ;
    skos:definition "Laguna is a SwiGLU Mixture-of-Experts Transformer language model family that uses per-layer attention head counts and an auxiliary-loss-free sigmoid MoE router for improved routing efficiency."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/laguna> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LED a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LED"@en ;
    skos:definition "Longformer-Encoder-Decoder (LED) is an encoder-decoder transformer model for sequence-to-sequence tasks like summarization. It extends Longformer, an encoder-only model designed to handle long inputs, by adding a decoder layer. The decoder uses full self-attention on the encoded tokens and previously decoded locations. Because of Longformer's linear self-attention mechanism, LED is more efficient than standard encoder-decoder models when processing long sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/led> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LFM2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LFM2"@en ;
    skos:definition "LFM2 represents a new generation of Liquid Foundation Models developed by Liquid AI, specifically designed for edge AI and on-device deployment. The architecture consists of blocks of gated short convolution blocks and blocks of grouped query attention with QK layernorm. This design stems from the concept of dynamical systems, where linear operations are modulated by input-dependent gates. The short convolutions are particularly optimized for embedded SoC CPUs, making them ideal for devices that require fast, local inference without relying on cloud connectivity."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lfm2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LFM2MoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LFM2-MoE"@en ;
    skos:definition "LFM2-MoE is a Mixture-of-Experts (MoE) variant of LFM2. The LFM2 family is optimized for on-device inference by combining short‑range, input‑aware gated convolutions with grouped‑query attention (GQA) in a layout tuned to maximize quality under strict speed and memory constraints."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lfm2_moe> ;
    skos:related dlt:LFM2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Llama a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Llama"@en ;
    skos:definition "Llama is a family of large language models ranging from 7B to 65B parameters. These models are focused on efficient inference (important for serving language models) by training a smaller model on more tokens rather than training a larger model on fewer tokens. The Llama model is based on the GPT architecture, but it uses pre-normalization to improve training stability, replaces ReLU with SwiGLU to improve performance, and replaces absolute positional embeddings with rotary positional embeddings (RoPE) to better handle longer sequence lengths."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llama> ;
    skos:inScheme dlt:ModelFamilyScheme .
    
dlt:Llama2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Llama 2"@en ;
    skos:definition "Llama 2 is a family of large language models, Llama 2 and Llama 2-Chat, available in 7B, 13B, and 70B parameters. The Llama 2 model mostly keeps the same architecture as Llama, but it is pretrained on more tokens, doubles the context length, and uses grouped-query attention (GQA) in the 70B model to improve inference."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llama2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Llama3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Llama 3"@en ;
    skos:definition "Llama 3 is a family of large language models that extends Llama 2 with an improved tokenizer. It is also pretrained on more tokens and doubles the context length."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llama3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LongCatFlash a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LongCat-Flash"@en ;
    skos:definition "LongCat-Flash is a 560B parameter Mixture-of-Experts (MoE) model that activates 18.6B-31.3B parameters dynamically (average ~27B). The model features a shortcut-connected architecture enabling high inference speed (>100 tokens/second) and advanced reasoning capabilities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/longcat_flash> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Longformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Longformer"@en ;
    skos:definition "Longformer is a transformer model designed for processing long documents. The self-attention operation usually scales quadratically with sequence length, preventing transformers from processing longer sequences. The Longformer attention mechanism overcomes this by scaling linearly with sequence length. It combines local windowed attention with task-specific global attention, enabling efficient processing of documents with thousands of tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/longformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LongT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LongT5"@en ;
    skos:definition "The LongT5 model is an encoder-decoder transformer pre-trained in a text-to-text denoising generative setting. LongT5 model is an extension of T5 model, and it enables using one of the two different efficient attention mechanisms - (1) Local attention, or (2) Transient-Global attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/longt5> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LUKE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LUKE"@en ;
    skos:definition "The LUKE model is based on RoBERTa and adds entity embeddings as well as an entity-aware self-attention mechanism, which helps improve performance on various downstream tasks involving reasoning about entities such as named entity recognition, extractive and cloze-style question answering, entity typing, and relation classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/luke> ;
    skos:related dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:M2M100 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "M2M100"@en ;
    skos:definition "M2M-100 is a multilingual encoder-decoder Transformer model designed for many-to-many machine translation that directly translates between 100 languages without relying on English as an intermediate language."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/m2m_100> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MADLAD400 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MADLAD-400"@en ;
    skos:definition "MADLAD-400 is a multilingual encoder-decoder Transformer model trained on the MADLAD-400 dataset, a manually audited multilingual corpus covering over 400 languages, and designed for large-scale multilingual machine translation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/madlad-400> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mamba a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mamba"@en ;
    skos:definition "Mamba is a selective structured state space model (SSMs) designed to work around Transformers computational inefficiency when dealing with long sequences. It is a completely attention-free architecture, and comprised of a combination of H3 and gated MLP blocks (Mamba block). Mamba's \"content-based reasoning\" allows it to focus on specific parts of an input depending on the current token. Mamba also uses a new hardware-aware parallel algorithm to compensate for the lack of convolutional operations. As a result, Mamba has fast inference and can scale to very long sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mamba> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mamba2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mamba2"@en ;
    skos:definition "Mamba 2 is based on the state space duality (SSD) framework which connects structured state space models (SSMs) and attention variants. It uses a more efficient SSD algorithm that is 2-8x faster than Mamba and modifies the architecture to enable tensor parallelism and a grouped-value attention (GVA) head structure."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mamba2> ;
    skos:related dlt:Mamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MarianMT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MarianMT"@en ;
    skos:definition "MarianMT is a machine translation model trained with the Marian framework which is written in pure C++. The framework includes its own custom auto-differentiation engine and efficient meta-algorithms to train encoder-decoder models like BART."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/marian> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MarkupLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MarkupLM"@en ;
    skos:definition "MarkupLM is BERT, but applied to HTML pages instead of raw text documents. The model incorporates additional embedding layers to improve performance, similar to LayoutLM."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/markuplm> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MBART a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "mBART"@en ;
    skos:definition "mBART is a multilingual machine translation model that pretrains the entire translation model (encoder-decoder) unlike previous methods that only focused on parts of the model. The model is trained on a denoising objective which reconstructs the corrupted text. This allows mBART to handle the source language and the target text to translate to."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mbart> ;
    skos:related dlt:BART ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MegatronBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MegatronBERT"@en ;
    skos:definition "MegatronBERT is based on the BERT architecture but uses Megatron-LM parallelism techniques to scale encoder-only Transformer models to larger sizes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/megatron-bert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MegatronGPT2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MegatronGPT2"@en ;
    skos:definition "MegatronGPT2 is based on the GPT-2 architecture but uses Megatron-LM parallelism techniques to scale decoder-only Transformer models to larger sizes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/megatron_gpt2> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mellum a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mellum"@en ;
    skos:definition "Mellum is a code-focused Mixture-of-Experts language model developed by JetBrains. It is derived from the Qwen3-MoE architecture with per-layer-type RoPE and interleaved sliding window attention. The model has 12B total parameters with 2.5B active parameters per token, using 64 routed experts with 8 activated per token across 28 layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mellum> ;
    skos:related dlt:Qwen3Moe ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiMoV2Flash a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiMo-V2-Flash"@en ;
    skos:definition "MiMo-V2-Flash is a Mixture-of-Experts (MoE) language model developed by the Xiaomi MiMo team. Designed to establish a new balance between long-context modeling capabilities and inference efficiency, the model is built for strong performance in complex reasoning and agentic tasks. Trained on 27T tokens with native 32k sequence lengths, MiMo-V2-Flash seamlessly supports an extended 256K context window while significantly reducing KV-cache storage compared to standard global attention models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mimo_v2_flash> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiniCPM3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiniCPM3"@en ;
    skos:definition "MiniCPM3 is the third-generation MiniCPM dense language model from OpenBMB. It combines Multi-head Latent Attention (MLA), SwiGLU feed-forward networks, and optimized signal-scaling mechanisms"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/minicpm3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiniMax a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiniMax"@en ;
    skos:definition "MiniMax is a powerful language model with 456 billion total parameters, of which 45.9 billion are activated per token. To better unlock the long context capabilities of the model, MiniMax adopts a hybrid architecture that combines Lightning Attention, Softmax Attention and Mixture-of-Experts (MoE). Leveraging advanced parallel strategies and innovative compute-communication overlap methods—such as Linear Attention Sequence Parallelism Plus (LASP+), varlen ring attention, Expert Tensor Parallel (ETP), etc., MiniMax’s training context length is extended to 1 million tokens, and it can handle a context of up to 4 million tokens during the inference. On various academic benchmarks, MiniMax also demonstrates the performance of a top-tier model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/minimax> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiniMaxM2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiniMax-M2"@en ;
    skos:definition "MiniMax-M2 is a compact, fast, and cost-effective MoE model (230 billion total parameters with 10 billion active parameters) built for elite performance in coding and agentic tasks, all while maintaining powerful general intelligence. With just 10 billion activated parameters, MiniMax-M2 provides the sophisticated, end-to-end tool use performance expected from today's leading models, but in a streamlined form factor that makes deployment and scaling easier than ever."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/minimax_m2> ;
    skos:related dlt:MiniMax ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiniMaxM3VL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiniMax-M3-VL"@en ;
    skos:definition "MiniMax-M3-VL is the vision-language member of the MiniMax-M3 family. It pairs a CLIP-style vision tower (Conv3d patch embedding with 3D rotary position embeddings) with the MiniMax-M3 text backbone, a mixed dense/sparse Mixture-of-Experts decoder that uses SwiGLU-OAI gated experts and a lightning indexer for block-sparse attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/minimax_m3_vl> ;
    skos:related dlt:MiniMax ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ministral a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ministral"@en ;
    skos:definition "Ministral is a 8B parameter language model that extends the Mistral architecture with alternating attention pattern. Unlike Mistral, that uses either full attention or sliding window attention consistently, Ministral alternates between full attention and sliding window attention layers, in a pattern of 1 full attention layer followed by 3 sliding window attention layers. This allows for a 128K context length support."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ministral> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ministral3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ministral 3"@en ;
    skos:definition "Ministral 3 is an improved Ministral model family that adds vision capabilities, extended context handling, and agentic functions while maintaining efficient deployment on edge devices."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ministral3> ;
    skos:related dlt:Ministral ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mistral a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mistral"@en ;
    skos:definition "Mistral is a 7B parameter language model, available as a pretrained and instruction-tuned variant, focused on balancing the scaling costs of large models with performance and efficient inference. This model uses sliding window attention (SWA) trained with a 8K context length and a fixed cache size to handle longer sequences more effectively. Grouped-query attention (GQA) speeds up inference and reduces memory requirements. Mistral also features a byte-fallback BPE tokenizer to improve token handling and efficiency by ensuring characters are never mapped to out-of-vocabulary tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mistral> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mixtral a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mixtral"@en ;
    skos:definition "Mixtral-8x7B is based on the Mistral architecture but introduces a sparse Mixture-of-Experts design with eight routed experts per layer, combined with Sliding Window Attention and Grouped Query Attention for efficient large-scale language modeling."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mixtral> ;
    skos:related dlt:Mistral ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MLUKE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "mLUKE"@en ;
    skos:definition "The mLUKE model is a multilingual extension of the LUKE model trained on the basis of XLM-RoBERTa. It is based on XLM-RoBERTa and adds entity embeddings, which helps improve performance on various downstream tasks involving reasoning about entities such as named entity recognition, extractive question answering, relation classification, cloze-style knowledge completion."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mluke> ;
    skos:related dlt:LUKE, dlt:XLMRoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MobileBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MobileBERT"@en ;
    skos:definition "MobileBERT is a lightweight and efficient variant of BERT, specifically designed for resource-limited devices such as mobile phones. It retains BERT's architecture but significantly reduces model size and inference latency while maintaining strong performance on NLP tasks. MobileBERT achieves this through a bottleneck structure and carefully balanced self-attention and feedforward networks. The model is trained by knowledge transfer from a large BERT model with an inverted bottleneck structure."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mobilebert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ModernBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ModernBERT"@en ;
    skos:definition "ModernBERT is a modernized version of [BERT] trained on 2T tokens. It brings many improvements to the original architecture such as rotary positional embeddings to support sequences of up to 8192 tokens, unpadding to avoid wasting compute on padding tokens, GeGLU layers, and alternating attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/modernbert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ModernBERTDecoder a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ModernBERT Decoder"@en ;
    skos:definition "ModernBERT Decoder has the same architecture as ModernBERT but it is trained from scratch with a causal language modeling objective from the Ettin paper. This allows for using the same architecture to compare encoders and decoders. This model is the decoder architecture implementation of ModernBERT, designed for autoregressive text generation tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/modernbert-decoder> ;
    skos:related dlt:ModernBERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ModernVBert a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ModernVBert"@en ;
    skos:definition "ModernVBert is a Vision-Language encoder that combines ModernBERT with a SigLIP vision encoder. It is optimized for visual document understanding and retrieval tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/modernvbert> ;
    skos:related dlt:ModernBERT, dlt:SigLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MPNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MPNet"@en ;
    skos:definition "MPNet uses a BERT-like Transformer encoder architecture but introduces masked and permuted language modeling (MPLM) to model dependencies among predicted tokens while preserving full positional information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mpnet> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MPT"@en ;
    skos:definition "MPT models are GPT-style decoder-only transformers with several improvements: performance-optimized layer implementations, architecture changes that provide greater training stability, and the elimination of context length limits by replacing positional embeddings with ALiBi."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mpt> ;
    skos:related dlt:GPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MRA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MRA"@en ;
    skos:definition "MRA is a Transformer-based architecture that uses Multiresolution Analysis to approximate self-attention, improving the efficiency of Transformer models across different sequence lengths."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mra> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "mT5"@en ;
    skos:definition "mT5 is a multilingual variant of T5, training on 101 languages. It also incorporates a new \"accidental translation\" technique to prevent the model from incorrectly translating predictions into the wrong language."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mt5> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MVP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MVP"@en ;
    skos:definition "MVP follows a standard Transformer encoder-decoder architecture that combines supervised pretraining with task-specific soft prompts. It is specially designed for natural language generation and can be adapted to a wide range of generation tasks, including but not limited to summarization, data-to-text generation, open-ended dialogue system, story generation, question answering, question generation, task-oriented dialogue system, commonsense generation, paraphrase generation, text style transfer, and text simplification. It can also be adapted to natural language understanding tasks such as sequence classification and (extractive) question answering."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mvp> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MyT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MyT5"@en ;
    skos:definition "MyT5 (Myte T5) is a multilingual language model based on T5 architecture. The model uses a morphologically-driven byte (MYTE) representation described in our paper. MYTE uses codepoints corresponding to morphemes in contrast to characters used in UTF-8 encoding. As a pre-requisite, we used unsupervised morphological segmentation (Morfessor) to obtain morpheme inventories for 99 languages. However, the morphological segmentation step is not needed when using the pre-defined morpheme inventory from the hub (see: Tomli/myt5-base)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/myt5> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NanoChat a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "NanoChat"@en ;
    skos:definition "NanoChat is a compact decoder-only transformer model designed for educational purposes and efficient training. The model features several fundamental architectural innovations which are common in modern transformer models. Therefore, it is a good model to use as a starting point to understand the principles of modern transformer models. NanoChat is a variant of the Llama architecture, with simplified attention mechanism and normalization layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nanochat> ;
    skos:related dlt:Llama ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Nemotron a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Nemotron"@en ;
    skos:definition "Nemotron is a family of Transformer-based large language models developed by NVIDIA for instruction following, reasoning, and generative AI applications."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nemotron> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NemotronH a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Nemotron H"@en ;
    skos:definition "NemotronH is a hybrid architecture combining attention and state-space layers for efficient long-context language modeling. It interleaves Mamba2 and transformer blocks, using a fixed ratio to balance expressiveness with linear-time sequence processing."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nemotron_h> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NLLB a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "NLLB"@en ;
    skos:definition "NLLB (No Language Left Behind) is a multilingual translation model. It's trained on data using data mining techniques tailored for low-resource languages and supports over 200 languages. NLLB features a conditional compute architecture using a Sparsely Gated Mixture of Experts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nllb> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NLLBMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "NLLB-MoE"@en ;
    skos:definition "NLLB-MoE has the same architecture as NLLB but replaces the standard feed-forward layers with Switch Transformer-based Mixture-of-Experts (MoE) feed-forward layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nllb-moe> ;
    skos:related dlt:NLLB, dlt:SwitchTransformer ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NomicBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "NomicBERT"@en ;
    skos:definition "NomicBERT has the same architecture as BERT but uses Rotary Position Embeddings (RoPE) instead of learned absolute positional embeddings."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nomic_bert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Nystromformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Nyströmformer"@en ;
    skos:definition "Nyströmformer is based on the Transformer architecture but approximates standard self-attention using a Nyström method, reducing the computational complexity of attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nystromformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OLMo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OLMo"@en ;
    skos:definition "OLMo is a 7B-parameter dense language model. It uses SwiGLU activations, non-parametric layer normalization, rotary positional embeddings, and a BPE tokenizer that masks personally identifiable information. It is pretrained on Dolma, a 3T-token dataset. OLMo was released to provide complete transparency of not just the model weights but the training data, training code, and evaluation code to enable more research on language models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/olmo> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OLMo2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OLMo2"@en ;
    skos:definition "OLMo2 improves on OLMo by changing the architecture and training recipes of the original models. This includes excluding all biases to improve training stability, non-parametric layer norm, SwiGLU activation function, rotary positional embeddings, and a modified BPE-based tokenizer that masks personal identifiable information. It is pretrained on Dolma, a dataset of 3T tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/olmo2> ;
    skos:related dlt:OLMo ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OLMo3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OLMo3"@en ;
    skos:definition "OLMo3 is an improvement on OLMo2. It increases the context length to 8,192 tokens and uses an improved training pipeline to enhance long-context reasoning, instruction following, coding, and function calling."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/olmo3> ;
    skos:related dlt:OLMo2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OLMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OLMoE"@en ;
    skos:definition "OLMoE is a sparse Mixture-of-Experts (MoE) language model with 7B parameters but only 1B parameters are used per input token. It has similar inference costs as dense models but trains ~3x faster. OLMoE uses fine-grained routing with 64 small experts in each layer and uses a dropless token-based routing algorithm."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/olmoe> ;
    skos:related dlt:OLMoE ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OLMoHybrid a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OLMo Hybrid"@en ;
    skos:definition "OLMo Hybrid is a hybrid architecture model from Ai2 that combines standard transformer attention layers with linear attention layers using the Gated Deltanet. This hybrid approach aims to improve efficiency while maintaining model quality by interleaving full attention layers with linear attention layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/olmo_hybrid> ;
    skos:related dlt:OLMo ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OpenAIPrivacyFilter a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OpenAI Privacy Filter"@en ;
    skos:definition "OpenAI Privacy Filter is a bidirectional token-classification model for personally identifiable information (PII) detection and masking in text. It is intended for high-throughput data sanitization workflows where teams need a model that they can run on-premises that is fast, context-aware, and tunable."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/openai_privacy_filter> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OPT"@en ;
    skos:definition "OPT is a suite of open-source decoder-only pre-trained transformers whose parameters range from 125M to 175B. OPT models are designed for causal language modeling and aim to enable responsible and reproducible research at scale. OPT-175B is comparable in performance to GPT-3 with only 1/7th the carbon footprint."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/opt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Pegasus a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Pegasus"@en ;
    skos:definition "Pegasus is an encoder-decoder (sequence-to-sequence) transformer model pretrained on unlabeled text to perform abstractive summarization. Pegasus is trained jointly on two self-supervised objective functions, masked language modeling (MLM) and gap sentence generation (GSG). Whole sentences are masked and the model has to fill in the gaps in the document. It can be fine-tuned with good performance even on small datasets with only 1000 examples."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pegasus> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PegasusX a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PEGASUS-X"@en ;
    skos:definition "PEGASUS-X is an encoder-decoder (sequence-to-sequence) transformer model for long-input summarization. It extends the Pegasus model with staggered block-local attention, global encoder tokens, and additional pretraining on long text sequences, enabling it to handle inputs of up to 16,000 tokens. PEGASUS-X matches the performance of much larger models while using fewer parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pegasus_x> ;
    dlt:related dlt:Pegasus ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Persimmon a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Persimmon"@en ;
    skos:definition "Persimmon-8B is a decoder model based on the classic transformers architecture, with query and key normalization. It is a fully permissively-licensed model with approximately 8 billion parameters, released under the Apache license. Some of the key attributes of Persimmon-8B are long context size (16K), performance, and capabilities for multimodal extensions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/persimmon> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Phi a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Phi"@en ;
    skos:definition "Phi is a 1.3B parameter transformer model optimized for Python code generation. It focuses on \"textbook-quality\" training data of code examples, exercises and synthetic Python problems rather than scaling the model size or compute."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/phi> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Phi3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Phi-3"@en ;
    skos:definition "Phi-3 is a extension of Phi-2 that uses an expanded high-quality training dataset and additional alignment techniques to improve performance, robustness, and instruction-following capabilities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/phi3> ;
    skos:related dlt:Phi ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PhiMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PhiMoE"@en ;
    skos:definition "Phi-MoE is a variant of Phi-3 that uses a sparse Mixture-of-Experts design to scale model capacity with efficient expert routing."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/phimoe> ;
    skos:related dlt:Phi3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PhoBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PhoBERT"@en ;
    skos:definition "PhoBERT is a RoBERTa-based language model pretrained on large-scale Vietnamese text data for Vietnamese natural language understanding tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/phobert> ;
    skos:related dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PLBART a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PLBART"@en ;
    skos:definition "The PLBART model is a BART-like model which can be used to perform code-summarization, code-generation, and code-translation tasks. The pre-trained model plbart-base has been trained using multilingual denoising task on Java, Python and English."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/plbart> ;
    skos:related dlt:BART ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ProphetNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ProphetNet"@en ;
    skos:definition "ProphetNet is an encoder-decoder model and can predict n-future tokens for “ngram” language modeling instead of just the next token."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/prophetnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2"@en ;
    skos:definition "Qwen2 is a family of large language models (pretrained, instruction-tuned and mixture-of-experts) available in sizes from 0.5B to 72B parameters. The models are built on the Transformer architecture featuring enhancements like group query attention (GQA), rotary positional embeddings (RoPE), a mix of sliding window and full attention, and dual chunk attention with YARN for training stability. Qwen2 models support multiple languages and context lengths up to 131,072 tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen2MoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2MoE"@en ;
    skos:definition "Qwen2MoE is a Mixture-of-Experts (MoE) variant of Qwen2, available as a base model and an aligned chat model. It uses SwiGLU activation, group query attention and a mixture of sliding window attention and full attention. The tokenizer can also be adapted to multiple languages and codes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2_moe> ;
    skos:related dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3"@en ;
    skos:definition "Qwen3 is the dense model architecture in the Qwen3 family, available in sizes from 0.6B to 32B parameters. It supports both thinking mode (multi-step reasoning) and non-thinking mode, with seamless switching between the two. Qwen3 was trained on approximately 36T tokens covering 119 languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3> ;
    skos:related dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen35 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3.5"@en ;
    skos:definition "Qwen3.5 is Qwen's natively multimodal foundation model family, trained from scratch on interleaved text, image, and video tokens. It uses a 3:1 hybrid attention stack — three Gated DeltaNet (linear attention) layers for every one Gated Attention (full attention) layer — so long context and vision tokens can be served without paying full quadratic cost on every block."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_5> ;
    skos:related dlt:Qwen3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3MoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3MoE"@en ;
    skos:definition "Qwen3MoE is the mixture-of-experts variant in the Qwen3 family, with 30.5B total parameters and 3.3B active parameters per token. It uses 128 routed experts with 8 activated per token across 48 layers, and supports up to 131K context with YaRN. See also the dense variant Qwen3."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_moe> ;
    skos:related dlt:Qwen3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3Next a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3-Next"@en ;
    skos:definition "Qwen3-Next is based on the Qwen3 architecture but replaces standard attention with a hybrid attention mechanism, adopts a highly sparse Mixture-of-Experts (MoE) architecture, and introduces multi-token prediction and training stability optimizations to improve training and inference efficiency, particularly for long-context processing."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_next> ;
    skos:related dlt:Qwen3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RAG a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RAG"@en ;
    skos:definition "Retrieval-Augmented Generation (RAG) combines a pretrained language model (parametric memory) with access to an external data source (non-parametric memory) by means of a pretrained neural retriever. RAG fetches relevant passages and conditions its generation on them during inference. This often makes the answers more factual and lets you update knowledge by changing the index instead of retraining the whole model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rag> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RecurrentGemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Recurrent Gemma"@en ;
    skos:definition "RecurrentGemma is based on the Gemma architecture but uses the Griffin architecture, which combines linear recurrences with local attention instead of relying entirely on self-attention, reducing memory usage and enabling more efficient inference on long sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/recurrent_gemma> ;
    skos:related dlt:Gemma ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Reformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Reformer"@en ;
    skos:definition "Reformer is based on the Transformer architecture but replaces dot-product attention with locality-sensitive hashing (LSH) attention and uses reversible residual layers to reduce memory usage and improve efficiency on long sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/reformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RemBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RemBERT"@en ;
    skos:definition "RemBERT is a BERT-based model that uses decoupled input and output embeddings to improve parameter allocation and cross-lingual transfer performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rembert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RoBERTa a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RoBERTa"@en ;
    skos:definition "RoBERTa improves BERT with new pretraining objectives, demonstrating BERT was undertrained and training design is important. The pretraining objectives include dynamic masking, sentence packing, larger batches and a byte-level BPE tokenizer."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/roberta> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RoBERTaPrelayernorm a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RoBERTa Prelayernorm"@en ;
    skos:definition "RoBERTa-PreLayerNorm is based on the RoBERTa architecture but uses Pre-Layer Normalization instead of Post-Layer Normalization. It applies layer normalization before each attention and feed-forward sublayer instead of after the residual connections."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/roberta-prelayernorm> ;
    skos:related dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RoCBert a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RoCBert"@en ;
    skos:definition "RoCBert is a pretrained Chinese BERT model designed against adversarial attacks like typos and synonyms. It is pretrained with a contrastive learning objective to align normal and adversarial text examples. The examples include different semantic, phonetic, and visual features of Chinese. This makes RoCBert more robust against manipulation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/roc_bert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Roformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Roformer"@en ;
    skos:definition "RoFormer introduces Rotary Position Embedding (RoPE) to encode token positions by rotating the inputs in 2D space. This allows a model to track absolute positions and model relative relationships. RoPE can scale to longer sequences, account for the natural decay of token dependencies, and works with the more efficient linear self-attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/roformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RWKV a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RWKV"@en ;
    skos:definition "RWKV is a language model architecture that combines the parallel training efficiency of Transformers with the constant-memory inference efficiency of RNNs using a linear attention mechanism."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rwkv>, <https://huggingface.co/papers/2305.13048> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SeedOss a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SeedOss"@en ;
    skos:definition "SeedOss is ByteDance Seed's 36B-parameter dense language model with native 512K context length. It features flexible thinking budget control and strong reasoning and agent capabilities, trained on 12T tokens."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/seed_oss> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SmolLM3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SmolLM3"@en ;
    skos:definition "SmolLM3 is a fully open, compact language model designed for efficient deployment while maintaining strong performance. It uses a Transformer decoder architecture with Grouped Query Attention (GQA) to reduce the kv cache, and no RoPE, enabling improved performance on long-context tasks. It is trained using a multi-stage training approach on high-quality public datasets across web, code, and math domains. The model is multilingual and supports very large context lengths. The instruct variant is optimized for reasoning and tool use."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/smollm3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SolarOpen a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SolarOpen"@en ;
    skos:definition "Solar Open is a bilingual Mixture-of-Experts language model designed for underserved languages that combines large-scale data synthesis, curriculum training, and reinforcement learning optimization."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/solar_open> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Splinter a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Splinter"@en ;
    skos:definition "Splinter is an encoder-only transformer (similar to BERT) pretrained using the recurring span selection task on a large corpus comprising Wikipedia and the Toronto Book Corpus."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/splinter> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SqueezeBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SqueezeBERT"@en ;
    skos:definition "The SqueezeBERT model is a bidirectional transformer similar to the BERT model. The key difference between the BERT architecture and the SqueezeBERT architecture is that SqueezeBERT uses grouped convolutions instead of fully-connected layers for the Q, K, V and FFN layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/squeezebert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:StableLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "StableLM"@en ;
    skos:definition "StableLM 3B 4E1T is a decoder-only base language model pre-trained on 1 trillion tokens of diverse English and code datasets for four epochs. The model architecture is transformer-based with partial Rotary Position Embeddings, SwiGLU activation, LayerNorm, etc."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/stablelm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:StarCoder2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "StarCoder2"@en ;
    skos:definition "StarCoder2 is a family of open LLMs for code and comes in 3 different sizes with 3B, 7B and 15B parameters. The flagship StarCoder2-15B model is trained on over 4 trillion tokens and 600+ programming languages from The Stack v2. All models use Grouped Query Attention, a context window of 16,384 tokens with a sliding window attention of 4,096 tokens, and were trained using the Fill-in-the-Middle objective."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/starcoder2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SwitchTransformers a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Switch Transformers"@en ;
    skos:definition "Switch Transformers is a sparse T5 model where the MLP layer is replaced by a Mixture-of-Experts (MoE). A routing mechanism associates each token with an expert and each expert is a dense MLP. Sparsity enables better scaling and the routing mechanism allows the model to select relevant weights on the fly which increases model capacity."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/switch_transformers> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:T5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "T5"@en ;
    skos:definition "T5 (Text-to-Text Transfer Transformer) is a encoder-decoder transformer available in a range of sizes from 60M to 11B parameters. It is designed to handle a wide range of NLP tasks by treating them all as text-to-text problems. This eliminates the need for task-specific architectures because T5 converts every NLP task into a text generation task."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/t5> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:T5Gemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "T5gemma"@en ;
    skos:definition "T5Gemma (aka encoder-decoder Gemma) is a family of encoder-decoder large language models, developed by adapting pretrained decoder-only models into encoder-decoder. T5Gemma includes pretrained and instruction-tuned variants. The architecture is based on transformer encoder-decoder design following T5, with improvements from Gemma 2: GQA, RoPE, GeGLU activation, RMSNorm, and interleaved local/global attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/t5gemma> ;
    skos:related dlt:T5, dlt:Gemma2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:T5Gemma2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "T5gemma2"@en ;
    skos:definition "T5Gemma 2 is a family of pretrained encoder-decoder large language models with strong multilingual, multimodal and long-context capability, available in 270M-270M, 1B-1B and 4B-4B parameters. Following T5Gemma, it is built via model adaptation (based on Gemma 3) using UL2. The architecture is similar to T5Gemma and Gemma 3, enhanced with tied word embeddings and merged self- and cross-attention to save model parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/t5gemma2> ;
    skos:related dlt:T5Gemma, dlt:Gemma3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:T5V1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "T5v1.1"@en ;
    skos:definition "T5v1.1 improves T5 by replacing ReLU with GEGLU feed-forward activations, disabling dropout during pretraining, using C4-only pretraining and removing parameter sharing between the embedding and classifiers layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/t5v1> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UL2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UL2"@en ;
    skos:definition "UL2 has the same architecture as T5v1.1 but uses the Gated-SiLU activation function instead of Gated-GELU."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ul2> ;
    skos:relates dlt:T5V1 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UMT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "umT5"@en ;
    skos:definition "umT5 has the same architecture as mT5 but uses layer-specific relative positional biases instead of sharing relative positional bias parameters across Transformer layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/umt5> ;
    skos:related dlt:mT5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VaultGemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VaultGemma"@en ;
    skos:definition "VaultGemma is a text-only decoder model derived from Gemma 2, notably it drops the norms after the Attention and MLP blocks, and uses full attention for all layers instead of alternating between full attention and local sliding attention. VaultGemma is available as a pretrained model with 1B parameters that uses a 1024 token sequence length."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vaultgemma> ;
    skos:related dlt:Gemma2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XMOD a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "X-MOD"@en ;
    skos:definition "X-MOD extends multilingual masked language models like XLM-R to include language-specific modular components (language adapters) during pre-training. For fine-tuning, the language adapters in each transformer layer are frozen."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xmod> ;
    skos:related dlt:XLMRoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XGLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XGLM"@en ;
    skos:definition "XGLM is a GPT-style multilingual decoder-only Transformer model trained on a balanced multilingual corpus to improve cross-lingual few-shot and zero-shot language understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xglm> ;
    skos:related dlt:GPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLM"@en ;
    skos:definition "XLM demonstrates cross-lingual pretraining with two approaches, unsupervised training on a single language and supervised training on more than one language with a cross-lingual language model objective. The XLM model supports the causal language modeling objective, masked language modeling, and translation language modeling (an extension of the BERT) masked language modeling objective to multiple language inputs)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLMRoBERTa a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLM-RoBERTa"@en ;
    skos:definition "XLM-RoBERTa is a large multilingual masked language model trained on 2.5TB of filtered CommonCrawl data across 100 languages. It shows that scaling the model provides strong performance gains on high-resource and low-resource languages. The model uses the RoBERTa pretraining objectives on the XLM model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlm-roberta> ;
    skos:related dlt:XLM, dlt:RoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLMRobertaXL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLM-RoBERTa-XL"@en ;
    skos:definition "XLM-RoBERTa-XL is a 3.5B parameter multilingual masked language model pretrained on 100 languages. It shows that by scaling model capacity, multilingual models demonstrates strong performance on high-resource languages and can even zero-shot low-resource languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlm-roberta-xl> ;
    skos:related dlt:XLMRoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLMV a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLM-V"@en ;
    skos:definition "XLM-V is based on the XLM-R architecture but uses a one-million-token multilingual vocabulary that reduces unnecessary token sharing between languages and improves language-specific representation capacity."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlm-v> ;
    skos:related dlt:XLMRoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLNet"@en ;
    skos:definition "XLnet is an extension of the Transformer-XL model pre-trained using an autoregressive method to learn bidirectional contexts by maximizing the expected likelihood over all permutations of the input sequence factorization order."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLSTM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "xLSTM"@en ;
    skos:definition "xLSTM updates the original LSTM architecture to be competitive with Transformer models by introducing exponential gating, matrix memory expansion, and parallelizable training and ingestion."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlstm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:YOSO a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "YOSO"@en ;
    skos:definition "YOSO approximates standard softmax self-attention via a Bernoulli sampling scheme based on Locality Sensitive Hashing (LSH). In principle, all the Bernoulli random variables can be sampled with a single hash."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/yoso> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Youtu a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Youtu"@en ;
    skos:definition "Youtu-LLM is a dense MLA-based language model designed for efficient long-context reasoning and agentic tasks through specialized architecture and curriculum-based training."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/youtu> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Zamba a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Zamba"@en ;
    skos:definition "Zamba-7B-v1 is a hybrid between state-space models (Specifically Mamba) and transformer, and was trained using next-token prediction. Zamba uses a shared transformer layer after every 6 mamba blocks. It uses the Mistral v0.1 tokenizer. Zamba-7B-v1 was pre-trained on 1T tokens of text and code data."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/zamba> ;
    skos:related dlt:Mamba ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Zamba2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Zamba2"@en ;
    skos:definition "Zamba2-1.2B, Zamba2-2.7B and Zamba2-7B are hybrid models combining state-space models (Specifically Mamba2) and transformer, and were trained using next-token prediction. Zamba2 uses shared transformer layers after every 6 mamba blocks. It uses the Mistral v0.1 tokenizer. Zamba2-1.2B, Zamba2-2.7B and Zamba2-7B were pre-trained on 2T and 3T tokens, respectively."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/zamba2> ;
    skos:related dlt:Zamba, dlt:Mamba2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ZAYA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ZAYA1"@en ;
    skos:definition "ZAYA1-8B is a small mixture of experts language model with 760M active parameters and 8.4B total parameters trained end-to-end by Zyphra. It combines Compressed Convolutional Attention (CCA), a nonlinear ZAYA1 router, and residual scaling."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/zaya> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AIMv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "AIMv2"@en ;
    skos:definition "AIMv2 is a family of vision encoders pretrained using an autoregressive multimodal framework that jointly models image patches and text tokens for vision and vision-language tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/aimv2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BEiT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BEiT"@en ;
    skos:definition "Inspired by BERT, BEiT models are regular Vision Transformers, but pre-trained in a self-supervised way rather than supervised. Rather than pre-training the model to predict the class of an image (as done in the original ViT paper), BEiT models are pre-trained to predict visual tokens from the codebook of OpenAI’s DALL-E model given masked patches."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/beit> ;
    skos:related dlt:BERT, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BiT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BiT"@en ;
    skos:definition "BiT (Big Transfer) models are equivalent to ResNetv2 in terms of architecture, except that all batch normalization layers are replaced by group normalization and weight standardization is used for convolutional layers. The authors show that the combination of both is useful for training with large batch sizes, and has a significant impact on transfer learning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bit> ;
    skos:related dlt:ResNet ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CHMv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CHMv2"@en ;
    skos:definition "The Canopy Height Maps v2 (CHMv2) is a global canopy height mapping model based on a DINOv3 depth estimation architecture trained with airborne laser scanning data to estimate forest canopy height from optical satellite imagery."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/chmv2> ;
    skos:related dlt:DINOv3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ConditionalDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Conditional DETR"@en ;
    skos:definition "Conditional DETR presents a conditional cross-attention mechanism for fast DETR training. Conditional DETR converges 6.7× to 10× faster than DETR."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/conditional_detr> ;
    skos:related dlt:DETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ConvNeXT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ConvNeXT"@en ;
    skos:definition "ConvNeXT is a family of pure convolutional neural networks (ConvNets) that modernizes the classical ResNet architecture using design principles inspired by Vision Transformers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/convnext> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ConvNeXtV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ConvNeXt V2"@en ;
    skos:definition "ConvNeXt V2 is a family of pure convolutional neural networks (ConvNets) that extends ConvNeXt with a fully convolutional masked autoencoder framework and a Global Response Normalization layer"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/convnextv2> ;
    skos:related dlt:ConvNeXT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CvT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CvT"@en ;
    skos:definition "Convolutional Vision Transformer (CvT) is a model that combines the strengths of convolutional neural networks (CNNs) and Vision transformers for the computer vision tasks. It introduces convolutional layers into the vision transformer architecture, allowing it to capture local patterns in images while maintaining the global context provided by self-attention mechanisms."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cvt> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DFINE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "D-FINE"@en ;
    skos:definition "D-FINE is a family of real-time object detection models that extends the DETR architecture by redifining the bounding box regression. D-FINE comprises two key components: Fine-grained Distribution Refinement (FDR) and Global Optimal Localization Self-Distillation (GO-LSD)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/d_fine> ;
    skos:related dlt:DETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DABDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DAB-DETR"@en ;
    skos:definition "DAB-DETR is an enhanced variant of Conditional DETR. It utilizes dynamically updated anchor boxes to provide both a reference query point (x, y) and a reference anchor size (w, h), improving cross-attention computation. This new approach achieves 45.7% AP when trained for 50 epochs with a single ResNet-50 model as the backbone."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dab-detr> ;
    skos:related dlt:ConditionalDETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeformableDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Deformable DETR"@en ;
    skos:definition "Deformable DETR improves on the original DETR by using a deformable attention module. This mechanism selectively attends to a small set of key sampling points around a reference. It improves training speed and improves accuracy."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deformable_detr> ;
    skos:related dlt:DETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DEIMv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DEIMv2"@en ;
    skos:definition "DEIMv2 (DETR with Improved Matching v2) is based on DEIM (DETR-based model with Dense O2O Matching) but uses DINOv3 features, Spatial Tuning Adapters, and improved Dense O2O detection mechanisms to enhance object detection accuracy and efficiency."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deimv2> ;
    skos:related dlt:DETR, dlt:DINOv3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeiT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DeiT"@en ;
    skos:definition "DeiT is based on the Vision Transformer architecture but uses a more data-efficient training strategy to reduce the data and computational requirements of Transformer models for image classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deit> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DepthAnything a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Depth Anything"@en ;
    skos:definition "Depth Anything is designed to be a foundation model for monocular depth estimation (MDE). It is jointly trained on labeled and ~62M unlabeled images to enhance the dataset. It uses a pretrained DINOv2 model as an image encoder to inherit its existing rich semantic priors, and DPT as the decoder. A teacher model is trained on unlabeled images to create pseudo-labels. The student model is trained on a combination of the pseudo-labels and labeled images. To improve the student model's performance, strong perturbations are added to the unlabeled images to challenge the student model to learn more visual knowledge from the image."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/depth_anything> ;
    skos:related dlt:DINOv2, dlt:DPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DepthAnythingV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Depth Anything V2"@en ;
    skos:definition "Depth Anything V2 uses the same architecture as the original Depth Anything model, but uses synthetic data and a larger capacity teacher model to achieve much finer and robust depth predictions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/depth_anything_v2> ;
    skos:related dlt:DepthAnything ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DepthPro a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Depth Pro"@en ;
    skos:definition "DepthPro is a foundation model for zero-shot metric monocular depth estimation, designed to generate high-resolution depth maps with remarkable sharpness and fine-grained details. It employs a multi-scale Vision Transformer (ViT)-based architecture, where images are downsampled, divided into patches, and processed using a shared Dinov2 encoder. The extracted patch-level features are merged, upsampled, and refined using a DPT-like fusion stage, enabling precise depth estimation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/depth_pro> ;
    skos:related dlt:ViT, dlt:DINOv2, dlt:DPT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DETR"@en ;
    skos:definition "DETR consists of a convolutional backbone followed by an encoder-decoder Transformer which can be trained end-to-end for object detection. It greatly simplifies a lot of the complexity of models like Faster-R-CNN and Mask-R-CNN, which use things like region proposals, non-maximum suppression procedure and anchor generation. Moreover, DETR can also be naturally extended to perform panoptic segmentation, by simply adding a mask head on top of the decoder outputs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/detr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DiNAT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DiNAT"@en ;
    skos:definition "DiNAT extends NAT by adding a Dilated Neighborhood Attention pattern to capture global context, and shows significant performance improvements over it."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dinat> ;
    skos:related dlt:NAT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DINOv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DINOv2"@en ;
    skos:definition "DINOv2 is a vision foundation model that uses ViT as a feature extractor for multiple downstream tasks like image classification and depth estimation. It focuses on stabilizing and accelerating training through techniques like a faster memory-efficient attention, sequence packing, improved stochastic depth, Fully Sharded Data Parallel (FSDP), and model distillation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dinov2> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DINOv2WithRegisters a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DINOv2 with Registers"@en ;
    skos:definition "DINOv2 with Registers is based on DINOv2 but adds learnable register tokens to improve feature quality by reducing artifacts in the learned visual representations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dinov2_with_registers> ;
    skos:related dlt:DINOv2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DINOv3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DINOv3"@en ;
    skos:definition "DINOv3 is a family of versatile vision foundation models that outperforms the specialized state of the art across a broad range of settings, without fine-tuning. DINOv3 produces high-quality dense features that achieve outstanding performance on various vision tasks, significantly surpassing previous self- and weakly-supervised foundation models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dinov3> ;
    skos:related dlt:DINOv2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DiT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DiT"@en ;
    skos:definition "DiT is an image transformer pretrained on large-scale unlabeled document images. It learns to predict the missing visual tokens from a corrupted input image. The pretrained DiT model can be used as a backbone in other models for visual document tasks like document image classification and table detection."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dit> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DPT"@en ;
    skos:definition "DPT is a model that leverages the Vision Transformer (ViT) as backbone for dense prediction tasks like semantic segmentation and depth estimation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dpt> ;
    skos:related dlt:ViT;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EfficientLoFTR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EfficientLoFTR"@en ;
    skos:definition "EfficientLoFTR is an efficient detector-free local feature matching method that produces semi-dense matches across images with sparse-like speed. It builds upon the original LoFTR architecture but introduces significant improvements for both efficiency and accuracy. The key innovation is an aggregated attention mechanism with adaptive token selection that makes the model ~2.5× faster than LoFTR while achieving higher accuracy. EfficientLoFTR can even surpass state-of-the-art efficient sparse matching pipelines like SuperPoint + LightGlue in terms of speed, making it suitable for large-scale or latency-sensitive applications such as image retrieval and 3D reconstruction."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/efficientloftr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EfficientNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EfficientNet"@en ;
    skos:definition "EfficientNet is a family of convolutional neural networks that uses compound scaling to uniformly scale network depth, width, and input resolution."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/efficientnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EoMT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EoMT"@en ;
    skos:definition "The Encoder-only Mask Transformer (EoMT) model uses a DINOv2-pretrained Vision Transformer with register tokens as its backbone. EoMT simplifies the segmentation pipeline by relying solely on the encoder, eliminating the need for task-specific decoders commonly used in prior approaches. Architecturally, EoMT introduces a small set of learned queries and a lightweight mask prediction module. These queries are injected into the final encoder blocks, enabling joint attention between image patches and object queries. During training, masked attention is applied to constrain each query to focus on its corresponding region—effectively mimicking cross-attention. This constraint is gradually phased out via a mask annealing strategy, allowing for efficient, decoder-free inference without compromising segmentation performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/eomt> ;
    skos:related dlt:DINOv2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EoMTDINOv3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EoMT-DINOv3"@en ;
    skos:definition "The EoMT-DINOv3 family extends the Encoder-only Mask Transformer architecture with Vision Transformers that are pre-trained using DINOv3. The update delivers stronger segmentation quality across ADE20K and COCO benchmarks while preserving the encoder-only design that made EoMT attractive for real-time applications."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/eomt_dinov3> ;
    skos:related dlt:EoMT, dlt:DINOv3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FocalNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FocalNet"@en ;
    skos:definition "FocalNets completely replace self-attention (used in models like ViT and Swin) by a focal modulation mechanism for modeling token interactions in vision. The authors claim that FocalNets outperform self-attention based models with similar computational costs on the tasks of image classification, object detection, and segmentation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/focalnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLPN a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLPN"@en ;
    skos:definition "GLPN combines SegFormer's hierarchical mix-Transformer with a lightweight decoder for monocular depth estimation. The proposed decoder shows better performance than the previously proposed decoders, with considerably less computational complexity."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glpn> ;
    skos:related dlt:SegFormer ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HGNetV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HGNetV2"@en ;
    skos:definition "HGNetV2 is a next-generation convolutional neural network (CNN) backbone built for optimal accuracy-latency tradeoff on NVIDIA GPUs. Building on the original HGNet, HGNetV2 delivers high accuracy at fast inference speeds and performs strongly on tasks like image classification, object detection, and segmentation, making it a practical choice for GPU-based computer vision applications."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hgnet_v2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Hiera a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Hiera"@en ;
    skos:definition "Hiera is a hierarchical Vision Transformer that simplifies existing hierarchical Transformer architectures by removing additional vision-specific components and leveraging MAE pretraining to achieve efficient image and video recognition."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hiera> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:IJEPA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "I-JEPA"@en ;
    skos:definition "I-JEPA is a self-supervised learning method that learns semantic image representations by predicting parts of an image from other parts of the image. It compares the abstract representations of the image (rather than pixel level comparisons), which avoids the typical pitfalls of data augmentation bias and pixel-level details that don't capture semantic meaning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ijepa> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ImageGPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ImageGPT"@en ;
    skos:definition "ImageGPT (iGPT) is a GPT-2-like model trained to predict the next pixel value, allowing for both unconditional and conditional image generation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/imagegpt> ;
    skos:related dlt:GPT2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LeViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LeViT"@en ;
    skos:definition "LeViT improves the Vision Transformer (ViT) in performance and efficiency by a few architectural differences such as activation maps with decreasing resolutions in Transformers and the introduction of an attention bias to integrate positional information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/levit> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LightGlue a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LightGlue"@en ;
    skos:definition "LightGlue is a deep neural network that learns to match local features across images. It revisits multiple design decisions of SuperGlue and derives simple but effective improvements. Cumulatively, these improvements make LightGlue more efficient - in terms of both memory and computation, more accurate, and much easier to train. Similar to SuperGlue, this model consists of matching two sets of local features extracted from two images, with the goal of being faster than SuperGlue. Paired with the SuperPoint model, it can be used to match two images and estimate the pose between them."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lightglue> ;
    skos:related dlt:SuperGlue ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LWDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LW-DETR"@en ;
    skos:definition "LW-DETR proposes a light-weight Detection Transformer (DETR) architecture designed to compete with and surpass the dominant YOLO series for real-time object detection. The LW-DETR architecture is characterized by its simple and efficient structure: a plain ViT Encoder, a Projector, and a shallow DETR Decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lw_detr> ;
    skos:related dlt:DETR, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mask2Former a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mask2Former"@en ;
    skos:definition "Mask2Former is a unified framework for panoptic, instance and semantic segmentation and features significant performance and efficiency improvements over MaskFormer."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mask2former> ;
    skos:related dlt:MaskFormer ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MaskFormer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MaskFormer"@en ;
    skos:definition "MaskFormer addresses semantic segmentation with a mask classification paradigm instead of performing classic pixel-level classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/maskformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MLCD a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MLCD"@en ;
    skos:definition "The MLCD models were released by the DeepGlint-AI team in unicom, which focuses on building foundational visual models for large multimodal language models using large-scale datasets such as LAION400M and COYO700M, and employs sample-to-cluster contrastive learning to optimize performance. MLCD models are primarily used for multimodal visual large language models, such as LLaVA."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mlcd> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MobileNetV1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MobileNet V1"@en ;
    skos:definition "MobileNet V1 is a family of efficient convolutional neural networks optimized for on-device or embedded vision tasks. It achieves this efficiency by using depth-wise separable convolutions instead of standard convolutions. The architecture allows for easy trade-offs between latency and accuracy using two main hyperparameters, a width multiplier (alpha) and an image resolution multiplier."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mobilenet_v1> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MobileNetV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MobileNet V2"@en ;
    skos:definition "MobileNet V2 improves performance on mobile devices with a more efficient architecture. It uses inverted residual blocks and linear bottlenecks to start with a smaller representation of the data, expands it for processing, and shrinks it again to reduce the number of computations. The model also removes non-linearities to maintain accuracy despite its simplified design. Like MobileNet V1, it uses depthwise separable convolutions for efficiency."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mobilenet_v2> ;
    skos:related dlt:MobileNetV1 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MobileViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MobileViT"@en ;
    skos:definition "MobileViT is a lightweight vision transformer for mobile devices that merges CNNs's efficiency and inductive biases with transformers global context modeling. It treats transformers as convolutions, enabling global information processing without the heavy computational cost of standard ViTs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mobilevit> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MobileViTV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MobileViTV2"@en ;
    skos:definition "MobileViTV2 is the second version of MobileViT, constructed by replacing the multi-headed self-attention in MobileViT with separable self-attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mobilevitv2> ;
    skos:related dlt:MobileViTV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:NAT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "NAT"@en ;
    skos:definition "NAT is a hierarchical vision transformer based on Neighborhood Attention, a sliding-window self attention pattern."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/main/en/model_doc/nat> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Pixio a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Pixio"@en ;
    skos:definition "Pixio is a vision foundation model that uses ViT as a feature extractor for multiple downstream tasks like depth estimation, semantic segmentation, feed-forward 3D reconstruction, robotics, and image classification. It is built on the Masked Autoencoder (MAE) pre-training framework, with four minimal yet critical updates: 1) deeper decoder, 2) larger masking granularity, 3) more class tokens, and 4) web-scale curated training data."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pixio> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PoolFormer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PoolFormer"@en ;
    skos:definition "PoolFormer is based on the MetaFormer architecture but replaces Attention with a simple Average Pooling layer."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/poolformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PromptDepthAnything a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Prompt Depth Anything"@en ;
    skos:definition "Prompt Depth Anything is based on the Depth Anything model but incorporates low-cost LiDAR prompts through multi-scale prompt fusion to produce accurate high-resolution metric depth estimates."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/prompt_depth_anything> ;
    skos:related dlt:DepthAnything ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PVT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PVT"@en ;
    skos:definition "The PVT (Pyramid Vision Transformer) is a type of vision transformer that utilizes a pyramid structure to make it an effective backbone for dense prediction tasks. Specifically it allows for more fine-grained inputs (4 x 4 pixels per patch) to be used, while simultaneously shrinking the sequence length of the Transformer as it deepens - reducing the computational cost. Additionally, a spatial-reduction attention (SRA) layer is used to further reduce the resource consumption when learning high-resolution features."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pvt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PVTV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PVTv2"@en ;
    skos:definition "As an improved variant of PVT, it eschews position embeddings, relying instead on positional information encoded through zero-padding and overlapping patch embeddings. This lack of reliance on position embeddings simplifies the architecture, and enables running inference at any resolution without needing to interpolate them."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pvt_v2> ;
    skos:related dlt:PVT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RADIO a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RADIO"@en ;
    skos:definition "RADIO (Reduce All Domains Into One) is a family of vision foundation models from NVIDIA trained by multi-teacher distillation (e.g. CLIP, DINOv2, SAM) into a single ViT backbone. It produces both an image-level summary embedding and dense spatial features, and supports variable input resolutions through a Cropped Position Embedding (CPE) patch generator."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/radio> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RegNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RegNet"@en ;
    skos:definition "RegNet is a family of convolutional neural networks that uses a low-dimensional design space with quantized linear width and depth parameterization to generate efficient and scalable network architectures."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/regnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ResNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ResNet"@en ;
    skos:definition "ResNet is a family of convolutional neural networks that uses residual connections to learn residual functions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/resnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RFDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RF-DETR"@en ;
    skos:definition "RF-DETR proposes a Receptive Field Detection Transformer (DETR) architecture designed to compete with and surpass the dominant YOLO series for real-time object detection. The RF-DETR architecture is characterized by its simple and efficient structure: a DINOv2 Backbone, a Projector, and a shallow DETR Decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rf_detr> ;
    skos:related dlt:DETR, dlt:DINOv2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RTDETR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RT-DETR"@en ;
    skos:definition "RT-DETR is an object detection model that stands for “Real-Time DEtection Transformer.” This model is designed to perform object detection tasks with a focus on achieving real-time performance while maintaining high accuracy. Leveraging the transformer architecture, which has gained significant popularity in various fields of deep learning, RT-DETR processes images to identify and locate multiple objects within them."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rt_detr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:RTDETRV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "RT-DETRv2"@en ;
    skos:definition "RT-DETRv2 refines RT-DETR by introducing selective multi-scale feature extraction, a discrete sampling operator for broader deployment compatibility, and improved training strategies like dynamic data augmentation and scale-adaptive hyperparameters. These changes enhance flexibility and practicality while maintaining real-time performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/rt_detr_v2> ;
    skos:related dlt:RTDETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM2"@en ;
    skos:definition "SAM2 (Segment Anything Model 2) is an advanced foundation model for image and video segmentation that extends SAM. SAM2 natively supports batch processing and seamless video segmentation, while original SAM is designed for static images and simpler one-image-at-a-time workflows. SAM2 shows improved segmentation quality, robustness, and zero-shot generalization to new domains compared to the original SAM, especially with mixed prompts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam2> ;
    skos:related dlt:SAM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM3Tracker a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM3 Tracker"@en ;
    skos:definition "SAM 3 Tracker is a video object tracking model built on top of SAM 3 that focuses on maintaining object identity and segmentation consistency across video frames."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam3_tracker> ;
    skos:related dlt:SAM3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Sapiens2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Sapiens2"@en ;
    skos:definition "Sapiens2 is a family of high-resolution vision transformers pretrained on ~1 billion curated human images, designed for human-centric computer vision tasks including pose estimation, body-part segmentation, surface normal estimation, and pointmap estimation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sapiens2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SegFormer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SegFormer"@en ;
    skos:definition "SegFormer: Simple and Efficient Design for Semantic Segmentation with Transformers is a semantic segmentation model that combines a hierarchical Transformer encoder (Mix Transformer, MiT) with a lightweight all-MLP decoder. It avoids positional encodings and complex decoders and achieves state-of-the-art performance on benchmarks like ADE20K and Cityscapes. This simple and lightweight design is more efficient and scalable."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/segformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SegGPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SegGPT"@en ;
    skos:definition "SegGPT employs a decoder-only Transformer that can generate a segmentation mask given an input image, a prompt image and its corresponding prompt mask. The model achieves remarkable one-shot results with 56.1 mIoU on COCO-20 and 85.6 mIoU on FSS-1000."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/seggpt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM"@en ;
    skos:definition "SAM (Segment Anything Model) is a foundation model for image segmentation developed to to predict segmentation masks of any object of interest given an input image."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAMHQ a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM-HQ"@en ;
    skos:definition "The model is an enhancement to the original SAM model that produces significantly higher quality segmentation masks while maintaining SAM’s original promptable design, efficiency, and zero-shot generalizability."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam_hq> ;
    skos:related dlt:SAM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SuperGlue a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SuperGlue"@en ;
    skos:definition "SuperGlue is a neural network that matches two sets of local features by jointly finding correspondences and rejecting non-matchable points. Assignments are estimated by solving a differentiable optimal transport problem, whose costs are predicted by a graph neural network. SuperGlue introduces a flexible context aggregation mechanism based on attention, enabling it to reason about the underlying 3D scene and feature assignments jointly. Paired with the SuperPoint model, it can be used to match two images and estimate the pose between them. This model is useful for tasks such as image matching, homography estimation, etc."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/superglue> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SuperPoint a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SuperPoint"@en ;
    skos:definition "SuperPoint is the result of self-supervised training of a fully-convolutional network for interest point detection and description. The model is able to detect interest points that are repeatable under homographic transformations and provide a descriptor for each point. Usage on it's own is limited, but it can be used as a feature extractor for other tasks such as homography estimation and image matching."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/superpoint> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SwiftFormer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SwiftFormer"@en ;
    skos:definition "SwiftFormer is a vision Transformer architecture that uses efficient additive attention instead of quadratic self-attention to achieve faster and more efficient image recognition."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/swiftformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SwinTransformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Swin Transformer"@en ;
    skos:definition "Swin Transformer is a hierarchical vision transformer. Images are processed in patches and windowed self-attention is used to capture local information. These windows are shifted across the image to allow for cross-window connections, capturing global information more efficiently. This hierarchical approach with shifted windows allows the Swin Transformer to process images effectively at different scales and achieve linear computational complexity relative to image size, making it a versatile backbone for various vision tasks like image classification and object detection."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/swin> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SwinTransformerV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Swin Transformer V2"@en ;
    skos:definition "Swin Transformer V2 is a 3B parameter model that focuses on how to scale a vision model to billions of parameters. It introduces techniques like residual-post-norm combined with cosine attention for improved training stability, log-spaced continuous position bias to better handle varying image resolutions between pre-training and fine-tuning, and a new pre-training method (SimMIM) to reduce the need for large amounts of labeled data. These improvements enable efficiently training very large models (up to 3 billion parameters) capable of processing high-resolution images."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/swinv2> ;
    skos:related dlt:SwinTransformer ; 
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Swin2SR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Swin2SR"@en ;
    skos:definition "Swin2SR improves the SwinIR model by incorporating Swin Transformer v2 layers which mitigates issues such as training instability, resolution gaps between pre-training and fine-tuning, and hunger on data."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/swin2sr> ;
    skos:related dlt:SwinTransformerV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TableTransformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Table Transformer"@en ;
    skos:definition "Table Transformer is based on the DETR object detection architecture but is adapted for document understanding by performing table detection and table structure recognition using the PubTables-1M dataset."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/table-transformer> ;
    skos:related dlt:DETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Textnet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Textnet"@en ;
    skos:definition "TextNet is a vision backbone useful for text detection tasks. It is the result of neural architecture search (NAS) on backbones with reward function as text detection task (to provide powerful features for text detection)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/textnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UPerNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UPerNet"@en ;
    skos:definition "UPerNet is a multi-task segmentation architecture that can be built on top of vision backbones such as ConvNeXt or Swin Transformer to perform unified perceptual parsing of multiple visual concepts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/upernet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UVDoc a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UVDoc"@en ;
    skos:definition "UVDoc is a document image rectification model that applies geometric transformations to correct distortions, inclinations, and perspective deformations in document images."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/uvdoc> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VidEoMT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VidEoMT"@en ;
    skos:definition "Video Encoder-only Mask Transformer (VidEoMT) is a lightweight encoder-only model for online video segmentation built on a plain Vision Transformer (ViT). It is a minimal extension of EoMT to video which performs both spatial and temporal reasoning within the ViT encoder, without relying on dedicated tracking modules or heavy task-specific heads."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/videomt> ;
    skos:related dlt:EoMT, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViT"@en ;
    skos:definition "Vision Transformer (ViT) is a transformer adapted for computer vision tasks. An image is split into smaller fixed-sized patches which are treated as a sequence of tokens, similar to words for NLP tasks. ViT requires less resources to pretrain compared to convolutional architectures and its performance on large datasets can be transferred to smaller downstream tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vit> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViTDet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViTDet"@en ;
    skos:definition "VitDet leverages the plain Vision Transformer for the task of object detection."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vitdet> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViTMAE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViTMAE"@en ;
    skos:definition "ViTMAE is a self-supervised vision model that is pretrained by masking large portions of an image (~75%). An encoder processes the visible image patches and a decoder reconstructs the missing pixels from the encoded patches and mask tokens. After pretraining, the encoder can be reused for downstream tasks like image classification or object detection — often outperforming models trained with supervised learning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vit_mae> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViTMatte a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViTMatte"@en ;
    skos:definition "ViTMatte leverages plain Vision Transformers for the task of image matting, which is the process of accurately estimating the foreground object in images and videos."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vitmatte> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViTMSN a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViTMSN"@en ;
    skos:definition "ViT-MSN is based on the Vision Transformer architecture but introduces Masked Siamese Network self-supervised pretraining. MSN (masked siamese networks) is a method for self-supervised pre-training of Vision Transformers (ViTs). The pre-training objective is to match the prototypes assigned to the unmasked views of the images to that of the masked views of the same images."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vit_msn> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViTPose a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViTPose"@en ;
    skos:definition "ViTPose is a vision transformer-based model for keypoint (pose) estimation. It uses a simple, non-hierarchical ViT backbone and a lightweight decoder head. This architecture simplifies model design, takes advantage of transformer scalability, and can be adapted to different training strategies."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vitpose> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:YOLOS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "YOLOS"@en ;
    skos:definition "YOLOS uses a Vision Transformer (ViT) for object detection with minimal modifications and region priors. It can achieve performance comparable to specialized object detection models and frameworks with knowledge about 2D spatial structures."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/yolos> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ZoeDepth a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ZoeDepth"@en ;
    skos:definition "ZoeDepth is a depth estimation model that combines the generalization performance of relative depth estimation (how far objects are from each other) and metric depth estimation (precise depth measurement on metric scale) from a single image. It is pre-trained on 12 datasets using relative depth and 2 datasets (NYU Depth v2 and KITTI) for metric accuracy. A lightweight head with a metric bin module for each domain is used, and during inference, it automatically selects the appropriate head for each input image with a latent classifier."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/zoedepth> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AudioSpectrogramTransformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Audio Spectrogram Transformer"@en ;
    skos:definition "The Audio Spectrogram Transformer applies a Vision Transformer to audio, by turning audio into an image (spectrogram)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/audio-spectrogram-transformer> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Bark a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Bark"@en ;
    skos:definition "Bark is a transformer-based text-to-speech (TTS) model developed by Suno AI that generates realistic speech and audio from text inputs. It uses a multi-stage architecture composed of semantic, coarse acoustic, and fine acoustic transformer models to progressively convert text into audio representations before decoding them into speech. Bark supports speaker conditioning through voice embeddings and can generate expressive speech with variations in tone, style, and vocal characteristics."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bark> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CLAP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CLAP"@en ;
    skos:definition "CLAP (Contrastive Language-Audio Pretraining) is a multimodal model that combines audio data with natural language descriptions through contrastive learning. It incorporates feature fusion and keyword-to-caption augmentation to process variable-length audio inputs and to improve performance. CLAP doesn’t require task-specific training data and can learn meaningful audio representations through natural language."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/clap> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CSM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CSM"@en ;
    skos:definition "The Conversational Speech Model (CSM) is the first open-source contextual text-to-speech model released by Sesame. It is designed to generate natural-sounding speech with or without conversational context. This context typically consists of multi-turn dialogue between speakers, represented as sequences of text and corresponding spoken audio. CSM is composed of two LLaMA-style auto-regressive transformer decoders: a backbone decoder that predicts the first codebook token and a depth decoder that generates the remaining tokens. It uses the pretrained codec model Mimi, introduced by Kyutai, to encode speech into discrete codebook tokens and decode them back into audio."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/csm> ;
    skos:related dlt:Mimi, dlt:LLaMA ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DAC a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DAC"@en ;
    skos:definition "The Descript Audio Codec (DAC) model is a powerful tool for compressing audio data, making it highly efficient for storage and transmission. By compressing 44.1 KHz audio into tokens at just 8kbps bandwidth, the DAC model enables high-quality audio processing while significantly reducing the data footprint. This is particularly useful in scenarios where bandwidth is limited or storage space is at a premium, such as in streaming applications, remote conferencing, and archiving large audio datasets."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dac> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Dia a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Dia"@en ;
    skos:definition "Dia is an open-source text-to-speech (TTS) model (1.6B parameters) developed by Nari Labs. It can generate highly realistic dialogue from transcript including non-verbal communications such as laughter and coughing. Furthermore, emotion and tone control is also possible via audio conditioning (voice cloning). Dia is an encoder-decoder transformer based on the original transformer architecture. However, some more modern features such as rotational positional embeddings (RoPE) are also included. For its text portion (encoder), a byte tokenizer is utilized while for the audio portion (decoder), a pretrained codec model DAC is used - DAC encodes speech into discrete codebook tokens and decodes them back into audio."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/dia> ;
    skos:related dlt:DAC ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EnCodec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EnCodec"@en ;
    skos:definition "EnCodec is a neural audio codec based on a streaming encoder-decoder architecture with a quantized latent space that performs real-time high-fidelity audio compression and reconstruction."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/encodec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FastSpeech2Conformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FastSpeech2Conformer"@en ;
    skos:definition "FastSpeech 2 Conformer is a non-autoregressive TTS model based on FastSpeech 2 that uses Conformer blocks instead of standard Transformer blocks for improved speech synthesis quality and efficiency."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/fastspeech2_conformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLMASR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-ASR"@en ;
    skos:definition "GLM-ASR-Nano-2512 is a robust, open-source speech recognition model with 1.5B parameters. Designed for real-world complexity, it outperforms OpenAI Whisper V3 on multiple benchmarks while maintaining a compact size."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glmasr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteSpeech a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Granite Speech"@en ;
    skos:definition "The Granite Speech model is a multimodal language model, consisting of a speech encoder, speech projector, large language model, and LoRA adapter(s)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granite_speech> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteSpeechPlus a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Granite Speech Plus"@en ;
    skos:definition "Granite Speech Plus is a variant of Granite Speech whose projector consumes the concatenation of the encoder's final hidden states with an arbitrary subset of its intermediate hidden states (along the feature dimension). The selected intermediate layers are controlled by the cat_hidden_layers config field on [GraniteSpeechPlusEncoderConfig]; when it is None, the model behaves identically to Granite Speech. When it is set, the projector's encoder_hidden_size must equal encoder_config.hidden_dim * (len(cat_hidden_layers) + 1). The rest of the architecture — speech encoder, query transformer projector, language model, and optional LoRA adapter — is inherited unchanged from Granite Speech."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granite_speech_plus> ;
    skos:related dlt:GraniteSpeech ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HiggsAudioV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Higgs Audio V2"@en ;
    skos:definition "Higgs Audio V2 is a powerful audio foundation model developed by Boson AI. The model was pretrained on over 10 million hours of audio data and a diverse set of text data. Despite having no post-training or fine-tuning, Higgs Audio v2 excels in expressive audio generation, thanks to its deep language and acoustic understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/higgs_audio_v2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HiggsAudioV2Tokenizer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Higgs Audio V2 Tokenizer"@en ;
    skos:definition "Higgs Audio V2 Tokenizer is the tokeniser of the Higgs Audio V2 Model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/higgs_audio_v2_tokenizer> ;
    skos:related dlt:HiggsAudioV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:HuBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "HuBERT"@en ;
    skos:definition "HuBERT is a self-supervised speech model to cluster aligned target labels for BERT-like prediction loss and applying the prediction loss only over masked regions to force the model to learn both acoustic and language modeling over continuous inputs. It addresses the challenges of multiple sound units per utterance, no lexicon during pre-training, and variable-length sound units without explicit segmentation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/hubert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:KyutaiSpeechToText a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Kyutai Speech To Text"@en ;
    skos:definition "Kyutai STT is a speech-to-text model architecture based on the Mimi codec, which encodes audio into discrete tokens in a streaming fashion, and a Moshi-like autoregressive decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/kyutai_speech_to_text> ;
    skos:related dlt:Mimi, dlt:Moshi ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LASR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LASR"@en ;
    skos:definition "LASR is the architecture behind MedASR, a speech-to-text model from Google Health AI pre-trained for medical dictation. It's based on the Conformer architecture and designed as a starting point for developers building dictation tools with medical terminology, like radiology dictation. MedASR performs well on medical audio but can struggle with terms outside its training data, such as non-standard medication names or temporal references (dates, times, or durations)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lasr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mimi a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mimi"@en ;
    skos:definition "Mimi is a neural audio codec model with pretrained and quantized variants, designed for efficient speech representation and compression. The model operates at 1.1 kbps with a 12 Hz frame rate and uses a convolutional encoder-decoder architecture combined with a residual vector quantizer of 16 codebooks. Mimi outputs dual token streams i.e. semantic and acoustic to balance linguistic richness with high fidelity reconstruction. Key features include a causal streaming encoder for low-latency use, dual-path tokenization for flexible downstream generation, and integration readiness with large speech models like Moshi."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mimi> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MMS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MMS"@en ;
    skos:definition "MMS (Massively Multilingual Speech) is based on wav2vec 2.0 self-supervised speech models and extends them to massively multilingual speech processing, providing multilingual automatic speech recognition, speech synthesis, and language identification across thousands of languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mms> ;
    skos:related dlt:Wav2Vec2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Moonshine a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Moonshine"@en ;
    skos:definition "Moonshine is an encoder-decoder speech recognition model optimized for real-time transcription and recognizing voice command. Instead of using traditional absolute position embeddings, Moonshine uses Rotary Position Embedding (RoPE) to handle speech with varying lengths without using padding. This improves efficiency during inference, making it ideal for resource-constrained devices."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/moonshine> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MoonshineStreaming a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Moonshine Streaming"@en ;
    skos:definition "Moonshine Streaming is a streaming variant of the Moonshine speech recognition model, optimized for real-time transcription with low latency. Like the original Moonshine, it is an encoder-decoder model that uses Rotary Position Embedding (RoPE) for handling variable-length speech efficiently. The streaming architecture includes sliding window attention in the encoder and a context adapter that enables incremental processing of audio chunks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/moonshine_streaming> ;
    skos:related dlt:Moonshine ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Moshi a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Moshi"@en ;
    skos:definition "Moshi is a speech-text foundation model that casts spoken dialogue as speech-to-speech generation. Starting from a text language model backbone, Moshi generates speech as tokens from the residual quantizer of a neural audio codec, while modeling separately its own speech and that of the user into parallel streams. This allows for the removal of explicit speaker turns, and the modeling of arbitrary conversational dynamics. Moshi also predicts time-aligned text tokens as a prefix to audio tokens. This “Inner Monologue” method significantly improves the linguistic quality of generated speech and provides streaming speech recognition and text-to-speech. As a result, Moshi is the first real-time full-duplex spoken large language model, with a theoretical latency of 160ms, 200ms in practice."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/moshi> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MusicGen a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MusicGen"@en ;
    skos:definition "MusicGen is a single stage auto-regressive Transformer model capable of generating high-quality music samples conditioned on text descriptions or audio prompts. The text descriptions are passed through a frozen text encoder model to obtain a sequence of hidden-state representations. MusicGen is then trained to predict discrete audio tokens, or audio codes, conditioned on these hidden-states. These audio tokens are then decoded using an audio compression model, such as EnCodec, to recover the audio waveform."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/musicgen> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MusicGenMelody a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MusicGen Melody"@en ;
    skos:definition "MusicGen Melody extends the MusicGen architecture to generate music based on both textual descriptions and reference melodies."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/musicgen_melody> ;
    skos:related dlt:MusicGen ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Nemotron35ASR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Nemotron 3.5 ASR"@en ;
    skos:definition "Nemotron 3.5 ASR is a 600M-parameter multilingual speech recognition model from NVIDIA, built for high-quality transcription in both low-latency streaming and high-throughput batch settings, with native punctuation and capitalization. For streaming, it offers configurable chunk sizes—80ms, 160ms, 560ms, and 1120ms, letting users trade off latency against accuracy to suit their application. Its cache-aware FastConformer-RNNT architecture is central to this capability: unlike traditional buffered streaming, which repeatedly reprocesses overlapping audio windows, the model processes only each new incoming chunk while reusing cached encoder context from prior chunks. This eliminates redundant computation, significantly improves efficiency, and minimizes end-to-end delay without sacrificing accuracy, making it well suited to real-time transcription workloads."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nemotron3_5_asr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PEAudio a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PE Audio"@en ;
    skos:definition "PE Audio is the audio branch of Meta's Perception Encoder family. It contrastively aligns raw waveforms with text into a shared embedding space, trained on paired audio–caption data for cross-modal retrieval and zero-shot audio classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pe_audio> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3ASR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3 ASR"@en ;
    skos:definition "Qwen3 ASR is an automatic speech recognition model from Alibaba's Qwen team that combines a Whisper-style audio encoder with a Qwen3 language model decoder for speech-to-text transcription. The model supports automatic language detection and multilingual transcription."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_asr> ;
    skos:related dlt:Qwen3, dlt:Whisper ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SeamlessM4T a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SeamlessM4T"@en ;
    skos:definition "SeamlessM4T is a multilingual multimodal translation model that jointly supports speech and text translation through a unified encoder-decoder architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/seamless_m4t> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SeamlessM4TV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SeamlessM4T-v2"@en ;
    skos:definition "SeamlessM4T v2 is an improved version of SeamlessM4T with an updated architecture and training strategy for more accurate multilingual speech and text translation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/seamless_m4t_v2> ;
    skos:related dlt:SeamlessM4T ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SEW a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SEW"@en ;
    skos:definition "SEW (Squeezed and Efficient Wav2Vec) is a self-supervised speech representation learning model that improves upon wav2vec 2.0 by introducing a squeezed feature encoder and an efficient transformer architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sew> ;
    skos:related dlt:Wav2Vec2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SEWD a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SEW-D"@en ;
    skos:definition "SEW-D (Squeezed and Efficient Wav2Vec with Disentangled Attention) is an enhanced version of SEW that incorporates disentangled attention mechanisms into the transformer layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sew-d> ;
    skos:related dlt:SEW ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Speech2Text a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Speech2Text"@en ;
    skos:definition "The Speech2Text model is a transformer-based seq2seq (encoder-decoder) model designed for end-to-end Automatic Speech Recognition (ASR) and Speech Translation (ST). It uses a convolutional downsampler to reduce the length of speech inputs by 3/4th before they are fed into the encoder. The model is trained with standard autoregressive cross-entropy loss and generates the transcripts/translations autoregressively. Speech2Text has been fine-tuned on several datasets for ASR and ST: LibriSpeech, CoVoST 2, MuST-C."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/speech_to_text> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SpeechT5 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SpeechT5"@en ;
    skos:definition "SpeechT5 is a unified speech-text encoder-decoder model based on T5 that learns shared representations across speech and text using modality-specific networks and cross-modal pretraining."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/speecht5> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UniSpeech a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UniSpeech"@en ;
    skos:definition "UniSpeech is a unified speech representation model that combines supervised phonetic learning and self-supervised contrastive learning to produce more transferable speech representations across languages and domains."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/unispeech> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UniSpeechSAT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UniSpeech-SAT"@en ;
    skos:definition "UniSpeech-SAT is a HuBERT-based self-supervised speech representation model that incorporates speaker-aware contrastive learning and data augmentation to improve universal speech and speaker representations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/unispeech-sat> ;
    skos:related dlt:UniSpeech, dlt:HuBERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UnivNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UnivNet"@en ;
    skos:definition "The UnivNet model is a generative adversarial network (GAN) trained to synthesize high fidelity speech waveforms. The UnivNet model shared in transformers is the generator, which maps a conditioning log-mel spectrogram and optional noise sequence to a speech waveform (e.g. a vocoder). Only the generator is required for inference. The discriminator used to train the generator is not implemented."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/univnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VibeVoiceAcousticTokenizer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VibeVoice Acoustic Tokenizer"@en ;
    skos:definition "VibeVoice is a novel framework for synthesizing high-fidelity, long-form speech with multiple speakers by employing a next-token diffusion approach within a Large Language Model (LLM) structure. It's designed to capture the authentic conversational \"vibe\" and is particularly suited for generating audio content like podcasts and multi-participant audiobooks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vibevoice_acoustic_tokenizer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VibeVoiceASR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VibeVoice ASR"@en ;
    skos:definition "VibeVoice ASR is an automatic speech recognition model from Microsoft that combines acoustic and semantic audio tokenizers with a causal language model for robust speech-to-text transcription. The model uses VibeVoice's acoustic and semantic tokenizers that process audio at 24kHz, paired with a Qwen2-based language decoder for generating transcriptions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vibevoice_asr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VITS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VITS"@en ;
    skos:definition "VITS (Variational Inference with adversarial learning for end-to-end Text-to-Speech) is a end-to-end speech synthesis model, simplifying the traditional two-stage text-to-speech (TTS) systems. It's unique because it directly synthesizes speech from text using variational inference, adversarial learning, and normalizing flows to produce natural and expressive speech with diverse rhythms and intonations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vits> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Wav2Vec2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Wav2vec2"@en ;
    skos:definition "The Wav2Vec2 model is a self-supervised speech representation learning model that learns powerful audio representations directly from raw speech waveforms."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/wav2vec2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Wav2Vec2BERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Wav2Vec2-BERT"@en ;
    skos:definition "The Wav2Vec2-BERT model is a variant of wav2vec 2.0 that combines self-supervised speech learning with BERT-style masked prediction objectives."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/wav2vec2-bert> ;
    skos:related dlt:Wav2Vec2, dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Wav2Vec2Conformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Wav2Vec2-Conformer"@en ;
    skos:definition "The Wav2Vec2-Conformer model is a variant of wav2vec 2.0 that replaces the standard transformer encoder with a Conformer architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/wav2vec2-conformer> ;
    skos:related dlt:Wav2Vec2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Wav2Vec2Phoneme a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Wav2Vec2-Phoneme"@en ;
    skos:definition "The Wav2Vec2Phoneme model is a wav2vec 2.0-based speech model designed to learn phoneme-level representations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/wav2vec2_phoneme> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:WavLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Wavlm"@en ;
    skos:definition "WavLM is a HuBERT-based self-supervised speech model that enhances universal speech representations through gated relative position bias and speaker-aware utterance mixing training."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/wavlm> ;
    skos:related dlt:HuBERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Whisper a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Whisper"@en ;
    skos:definition "Whisper is an encoder-decoder (sequence-to-sequence) transformer pretrained on 680,000 hours of labeled audio data. This amount of pretraining data enables zero-shot performance on audio tasks in English and many other languages. The decoder allows Whisper to map the encoders learned speech representations to useful outputs, such as text, without additional fine-tuning. Whisper just works out of the box."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/whisper> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XCodec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "X-Codec"@en ;
    skos:definition "The X-Codec model is a neural audio codec that integrates semantic information from self-supervised models (e.g., HuBERT) alongside traditional acoustic information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xcodec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XCodec2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "X-Codec2"@en ;
    skos:definition "X-Codec2 is a neural audio codec designed to improve speech synthesis and general audio generation for large language model (LLM) pipelines. It extends the original X-Codec by refining how semantic and acoustic information is integrated and tokenized, enabling efficient and high-fidelity audio representation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xcodec2> ;
    skos:related dlt:XCodec ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLSR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLS-R"@en ;
    skos:definition "XLS-R (Cross-lingual Speech Representation Learning) is a family of multilingual self-supervised speech representation models trained on large-scale unlabeled speech data from many languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xls_r> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XLSRWav2Vec2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "XLSR-Wav2Vec2"@en ;
    skos:definition "XLS-R-wav2vec2 is a multilingual implementation of the wav2vec 2.0 architecture belonging to the XLS-R model family. It extends wav2vec 2.0 by training the model on multilingual speech corpora to learn shared speech representations across languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xlsr_wav2vec2> ;
    skos:related dlt:XLSR, dlt:Wav2Vec2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PEVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PE Video"@en ;
    skos:definition "PE Video is the video branch of Meta's Perception Encoder family. It contrastively aligns video clips with text into a shared embedding space, enabling zero-shot video classification and video–text retrieval from a single pretrained backbone."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pe_video> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM2Video a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM2 Video"@en ;
    skos:definition "SAM 2 Video is the video segmentation component of SAM 2 designed for tracking and segmenting objects across video sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam2_video> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM3TrackerVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM3 Tracker Video"@en ;
    skos:definition "Sam3TrackerVideo is the video tracking component of SAM3Tracker."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam3_tracker_video> ;
    skos:related dlt:SAM3Tracker ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TimeSformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TimeSformer"@en ;
    skos:definition "TimeSformer (Time-Space Transformer) applies the Vision Transformer (ViT) architecture to video understanding by incorporating different strategies for modeling temporal relationships across video frames. The model divides input videos into sequences of patches, processes them through transformer blocks, and classifies them using self-attention mechanisms specifically designed to capture spatial and temporal relationships."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/timesformer>, <https://deepwiki.com/facebookresearch/TimeSformer/2-model-architecture>;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VJEPA2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "V-JEPA 2"@en ;
    skos:definition "V-JEPA 2 is a self-supervised approach to training video encoders developed by FAIR, Meta. Using internet-scale video data, V-JEPA 2 attains state-of-the-art performance on motion understanding and human action anticipation tasks. V-JEPA 2-AC is a latent action-conditioned world model post-trained from V-JEPA 2 (using a small amount of robot trajectory interaction data) that solves robot manipulation tasks without environment-specific data collection or task-specific training or calibration."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vjepa2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VideoMAE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VideoMAE"@en ;
    skos:definition "VideoMAE extends masked auto encoders (MAE) to video."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/videomae> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VideoPrism a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VideoPrism"@en ;
    skos:definition "VideoPrism is a general-purpose video encoder that tackles diverse video understanding tasks with a single frozen model. The model is pretrained on a large-scale heterogeneous corpus containing 36M high-quality video-caption pairs and 582M video clips with noisy parallel text (e.g., ASR transcripts). The pretraining approach improves upon masked autoencoding through global-local distillation of semantic video embeddings and a token shuffling scheme, enabling the model to focus primarily on the video modality while leveraging text associated with videos. VideoPrism achieves state-of-the-art performance on 31 out of 33 video understanding benchmarks across four broad task groups, from web video question answering to computer vision for science."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/videoprism> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViViT"@en ;
    skos:definition "ViViT (Video Vision Transformer) is a transformer-based video understanding model that extends the Vision Transformer (ViT) architecture to handle video data. It divides videos into spatio-temporal tokens and applies transformer layers to capture both spatial appearance and temporal dynamics, enabling effective video representation learning for tasks such as action recognition and video classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vivit> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ALIGN a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ALIGN"@en ;
    skos:definition "ALIGN is pretrained on a noisy 1.8 billion alt‑text and image pair dataset to show that scale can make up for the noise. It uses a dual‑encoder architecture, EfficientNet for images and BERT for text, and a contrastive loss to align similar image–text embeddings together while pushing different embeddings apart. Once trained, ALIGN can encode any image and candidate captions into a shared vector space for zero‑shot retrieval or classification without requiring extra labels. This scale‑first approach reduces dataset curation costs and powers state‑of‑the‑art image–text retrieval and zero‑shot ImageNet classification."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/align> ;
    skos:related dlt:EfficientNet, dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AltCLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "AltCLIP"@en ;
    skos:definition "AltCLIP replaces the CLIP text encoder with a multilingual XLM-R encoder and aligns image and text representations with teacher learning and contrastive learning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/altclip> ;
    skos:related dlt:CLIP, dlt:XLMRoBERTa ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Aria a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Aria"@en ;
    skos:definition "Aria is a multimodal mixture-of-experts (MoE) model. The goal of this model is to open-source a training recipe for creating a multimodal native model from scratch. Aria has 3.9B and 3.5B activated parameters per visual and text token respectively. Text is handled by a MoE decoder and visual inputs are handled by a lightweight visual encoder. It is trained in 4 stages, language pretraining, multimodal pretraining, multimodal long-context pretraining, and multimodal post-training."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/aria> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AudioFlamingo3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "AudioFlamingo3"@en ;
    skos:definition "Audio Flamingo 3 (AF3) is a fully open large audio–language model designed for robust understanding and reasoning over speech, environmental sounds, and music. AF3 pairs a Whisper-style audio encoder with a causal language model and performs replace-in-place audio–text fusion: the processor aligns post-pool audio frames to a dedicated placeholder token and the model replaces those token slots with projected audio embeddings during the forward pass."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/audioflamingo3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AyaVision a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Aya Vision"@en ;
    skos:definition "Aya Vision is a family of open-weight multimodal vision-language models from Cohere Labs. It is trained with a synthetic annotation framework that generates high-quality multilingual image captions, improving Aya Vision's generated responses. In addition, a cross-modal model merging technique is used to prevent the model from losing its text capabilities after adding vision capabilities. The model combines a CommandR-7B language model with a SigLIP vision encoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/aya_vision> ;
    skos:related dlt:Cohere, dlt:SigLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BLIP"@en ;
    skos:definition "BLIP (Bootstrapped Language-Image Pretraining) is a vision-language pretraining (VLP) framework designed for both understanding and generation tasks. Most existing pretrained models are only good at one or the other. It uses a captioner to generate captions and a filter to remove the noisy captions. This increases training data quality and more effectively uses the messy web data."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/blip> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BLIP2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BLIP-2"@en ;
    skos:definition "BLIP-2 leverages frozen pre-trained image encoders and large language models (LLMs) by training a lightweight, 12-layer Transformer encoder in between them, achieving state-of-the-art performance on various vision-language tasks. Most notably, BLIP-2 improves upon Flamingo, an 80 billion parameter model, by 8.7% on zero-shot VQAv2 with 54x fewer trainable parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/blip-2> ;
    skos:related dlt:BLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Bridgetower a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Bridgetower"@en ;
    skos:definition "BridgeTower consists of a visual encoder, a textual encoder and cross-modal encoder with multiple lightweight bridge layers. The goal of this approach was to build a bridge between each uni-modal encoder and the cross-modal encoder to enable comprehensive and detailed interaction at each layer of the cross-modal encoder. In principle, one can apply any visual, textual or cross-modal encoder in the proposed architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bridgetower> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:BROS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "BROS"@en ;
    skos:definition "BROS stands for BERT Relying On Spatiality. It is an encoder-only Transformer model that takes a sequence of tokens and their bounding boxes as inputs and outputs a sequence of hidden states. BROS encode relative spatial information instead of using absolute spatial information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/bros> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Chameleon a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Chameleon"@en ;
    skos:definition "Chameleon is a Vision-Language Model that use vector quantization to tokenize images which enables the model to generate multimodal output. The model takes images and texts as input, including an interleaved format, and generates textual response."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/chameleon> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ChineseCLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Chinese-CLIP"@en ;
    skos:definition "Chinese-CLIP is an implementation of CLIP on a large-scale dataset of Chinese image-text pairs. It is capable of performing cross-modal retrieval and also playing as a vision backbone for vision tasks like zero-shot image classification, open-domain object detection, etc."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/chinese_clip> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CLIP"@en ;
    skos:definition "CLIP is a is a multimodal vision and language model motivated by overcoming the fixed number of object categories when training a computer vision model. CLIP learns about images directly from raw text by jointly training on 400M (image, text) pairs. Pretraining on this scale enables zero-shot transfer to downstream tasks. CLIP uses an image encoder and text encoder to get visual features and text features. Both features are projected to a latent space with the same number of dimensions and their dot product gives a similarity score."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/clip> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CLIPseg a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CLIPseg"@en ;
    skos:definition "The CLIPSeg model was proposed in Image Segmentation Using Text and Image Prompts by Timo Lüddecke and Alexander Ecker. CLIPSeg adds a minimal decoder on top of a frozen CLIP model for zero-shot and one-shot image segmentation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/clipseg> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CLVP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CLVP"@en ;
    skos:definition "CLVP (Contrastive Language–Voice Pretraining) is a multimodal model that jointly learns representations of text and speech using contrastive learning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/clvp> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:CWM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "CWM"@en ;
    skos:definition "CWM is an LLM for code generation and reasoning about code that has, in particular, been trained to better represent and reason about how code and commands affect the state of a program or system. Specifically, we mid-trained CWM on a large number of observation-action trajectories from Python execution traces and agentic interactions in containerized environments. We post-trained with extensive multi-task RL in verifiable coding, math, and multi-turn software engineering environments."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cwm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cohere2Vision a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cohere2 Vision"@en ;
    skos:definition "Command A Vision (Cohere2Vision) is a multimodal large language model developed by Cohere that extends the Cohere 2 architecture with vision capabilities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cohere2_vision> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ColModernVBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ColModernVBert"@en ;
    skos:definition "ColModernVBert is a model for efficient visual document retrieval. It leverages ModernVBert to construct multi-vector embeddings directly from document images, following the ColPali approach."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/colmodernvbert> ;
    skos:related dlt:ColPali, dlt:ModernVBert ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ColPali a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ColPali"@en ;
    skos:definition "ColPali is a model designed to retrieve documents by analyzing their visual features. Unlike traditional systems that rely heavily on text extraction and OCR, ColPali treats each page as an image. It uses Paligemma-3B to capture not only text, but also the layout, tables, charts, and other visual elements to create detailed multi-vector embeddings that can be used for retrieval by computing pairwise late interaction similarity scores. This offers a more comprehensive understanding of documents and enables more efficient and accurate retrieval."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/colpali> ;
    skos:related dlt:PaliGemma ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ColQwen2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ColQwen2"@en ;
    skos:definition "ColQwen2 is a variant of the ColPali model designed to retrieve documents by analyzing their visual features. Unlike traditional systems that rely heavily on text extraction and OCR, ColQwen2 treats each page as an image. It uses the Qwen2-VL backbone to capture not only text, but also the layout, tables, charts, and other visual elements to create detailed multi-vector embeddings that can be used for retrieval by computing pairwise late interaction similarity scores. This offers a more comprehensive understanding of documents and enables more efficient and accurate retrieval."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/colqwen2> ;
    skos:related dlt:Qwen2VL, dlt:ColPali ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cosmos3Edge a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cosmos3 Edge"@en ;
    skos:definition "Cosmos3 Edge is NVIDIA's multimodal reasoning model from the Cosmos3 family. Transformers integrates the Reasoner tower only; the checkpoint's diffusion Generator, VAE, scheduler, and other generation components remain Diffusers components. The reasoner uses a dense, Llama-compatible language tower with 28 decoder blocks, each containing attention and an MLP. Its SigLIP2 vision encoder accepts packed variable-resolution patches, uses sequence boundaries to keep images and video frames independent during vision attention, groups patches spatially in 2×2 blocks, and projects them into the language model. Image and video inputs use multimodal rotary position IDs; video prompts are expanded into one timestamped vision span per sampled frame."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cosmos3_edge> ;
    skos:related dlt:Cosmos3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Cosmos3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Cosmos3"@en ;
    skos:definition "Cosmos3 is a mixture-of-transformers (MoT) Vision Foundation Model from NVIDIA, composed of a Reasoner tower and a Generator tower. The two towers share the same input embedding and visual encoder but use disjoint MoT experts for understanding vs. generation, plus cross-modal adapters (proj_out, audio_proj_out, action_proj_out, etc.) that connect the language model to image / audio / action heads."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/cosmos3_omni> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Data2Vec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Data2Vec"@en ;
    skos:definition "Data2Vec proposes a unified framework for self-supervised learning across different data modalities - text, audio and images. Importantly, predicted targets for pre-training are contextualized latent representations of the inputs, rather than modality-specific, context-independent targets."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/data2vec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepseekVL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Deepseek-VL"@en ;
    skos:definition "Deepseek-VL is a vision-language model (VLM) designed to process both text and images for generating contextually relevant responses. The model leverages LLaMA as its text encoder, while SigLip is used for encoding images."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_vl> ;
    skos:related dlt:LLaMA, dlt:SigLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DeepseekVLHybrid a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Deepseek-VL-Hybrid"@en ;
    skos:definition "Deepseek-VL-Hybrid was introduced by the DeepSeek AI team. It is a vision-language model (VLM) designed to process both text and images for generating contextually relevant responses. The model leverages LLaMA as its text encoder, while SigLip is used for encoding low-resolution images and SAM (Segment Anything Model) is incorporated to handle high-resolution image encoding, enhancing the model's ability to process fine-grained visual details. Deepseek-VL-Hybrid is a variant of Deepseek-VL that uses SAM (Segment Anything Model) to handle high-resolution image encoding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deepseek_vl_hybrid> ;
    skos:related dlt:DeepseekVL, dlt:SAM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DePlot a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DePlot"@en ;
    skos:definition "DePlot is a vision-language model designed to convert charts and plots into structured tables."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/deplot> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DiffusionGemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "DiffusionGemma"@en ;
    skos:definition "DiffusionGemma is engineered to reduce the sequential bottlenecks of standard causal language models. It employs an encoder-decoder architecture specifically optimized for inference speed. The encoder operates in a prefill capacity, processing the initial prompt and generating the KV cache. The decoder then utilizes bidirectional attention to process an input block (a ‘canvas’) of tokens, accessing the cached context via cross-attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/diffusion_gemma> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Donut a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Donut"@en ;
    skos:definition "Donut (Document Understanding Transformer) is a visual document understanding model that doesn't require an Optical Character Recognition (OCR) engine. Unlike traditional approaches that extract text using OCR before processing, Donut employs an end-to-end Transformer-based architecture to directly analyze document images. This eliminates OCR-related inefficiencies making it more accurate and adaptable to diverse languages and formats. Donut features vision encoder (Swin) and a text decoder (BART). Swin converts document images into embeddings and BART processes them into meaningful text sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/donut> ;
    skos:related dlt:SwinTransformer, dlt:BART ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EdgeTAM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EdgeTAM"@en ;
    skos:definition "EdgeTAM is an efficient adaptation of SAM 2 that introduces a 2D Spatial Perceiver architecture to optimize memory attention mechanisms for real-time video segmentation on mobile devices."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/edgetam> ;
    skos:related dlt:SAM2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:EdgeTAMVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "EdgeTAM Video"@en ;
    skos:definition "EdgeTAM Video is an extension of EdgeTAM designed for video segmentation tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/edgetam_video> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Emu3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Emu3"@en ;
    skos:definition "Emu3 is a multimodal LLM that uses vector quantization to tokenize images into discrete tokens. Discretized image tokens are later fused with text token ids for image and text generation. The model can additionally generate images by predicting image token ids."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/emu3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ernie45VLMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ernie 4.5 VL MoE"@en ;
    skos:definition "The Ernie 4.5 VL MoE model was released in the Ernie 4.5 Model Family release by baidu. This family of models contains multiple different architectures and model sizes. The Vision-Language series in specific is composed of a novel multimodal heterogeneous structure, sharing parameters across modalities and dedicating parameters to specific modalities. This becomes especially apparent in the Mixture of Expert (MoE) which is composed of Dedicated Text Experts, Dedicated Vision Experts, Shared Experts. This architecture has the advantage to enhance multimodal understanding without compromising, and even improving, performance on text-related tasks. "@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ernie4_5_vl_moe> ;
    skos:related dlt:Ernie45 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Evolla a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Evolla"@en ;
    skos:definition "Evolla is an advanced 80-billion-parameter protein-language generative model designed to decode the molecular language of proteins. It integrates information from protein sequences, structures, and user queries to generate precise and contextually nuanced insights into protein function. Trained on an unprecedented AI-generated dataset of 546 million protein question-answer pairs and 150 billion word tokens, Evolla significantly advances research in proteomics and functional genomics, providing expert-level insights and shedding light on the molecular logic encoded in proteins."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/evolla> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FastVLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FastVLM"@en ;
    skos:definition "FastVLM is an open-source vision-language model featuring a novel hybrid vision encoder, FastViTHD. Leveraging reparameterizable convolutional layers, scaled input resolution, and a reduced number of visual tokens, FastVLM delivers high accuracy with exceptional efficiency. Its optimized architecture enables deployment even on edge devices, achieving ultra-low TTFT (time to first token) without sacrificing performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/fast_vlm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:FLAVA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "FLAVA"@en ;
    skos:definition "FLAVA is a multimodal Transformer-based foundation model that unifies vision and language learning through separate modality encoders and multimodal fusion, enabling performance across vision, language, and cross-modal tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/flava> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Florence2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Florence-2"@en ;
    skos:definition "Florence-2 is an advanced vision foundation model that uses a prompt-based approach to handle a wide range of vision and vision-language tasks. Florence-2 can interpret simple text prompts to perform tasks like captioning, object detection, and segmentation. It leverages the FLD-5B dataset, containing 5.4 billion annotations across 126 million images, to master multi-task learning. The model's sequence-to-sequence architecture enables it to excel in both zero-shot and fine-tuned settings, proving to be a competitive vision foundation model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/florence2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma4Assistant a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 4 Assistant"@en ;
    skos:definition "Gemma 4 Assistant is a small, text-only model that enables speculative decoding with for Gemma 4 models using the Multi-Token Prediction (MTP) method and associated candidate generator. Pre-trained models are provided for the IT variants of the Gemma 4 E2B, E4B, 31B and 26B-A4B (MoE) models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma4_assistant> ;
    skos:related dlt:Gemma4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma4UnifiedAssistant a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 4 Unified Assistant"@en ;
    skos:definition "Gemma 4 Unified Assistant is a small, text-only model that enables speculative decoding with for Gemma 4 Unified models using the Multi-Token Prediction (MTP) method and associated candidate generator. Pre-trained models are provided for the IT variants of the Gemma 4 12B model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma4_unified_assistant> ;
    skos:related dlt:Gemma4Unified ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 3"@en ;
    skos:definition "Gemma 3 is a multimodal model with pretrained and instruction-tuned variants, available in 1B, 13B, and 27B parameters. The architecture is mostly the same as the previous Gemma versions. The key differences are alternating 5 local sliding window self-attention layers for every global self-attention layer, support for a longer context length of 128K tokens, and a SigLip encoder that can \"pan & scan\" high-resolution images to prevent information from disappearing in high resolution images or images with non-square aspect ratios."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma3> ;
    skos:related dlt:Gemma2, dlt:SigLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma3N a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma3n"@en ;
    skos:definition "Gemma3n is a multimodal model with pretrained and instruction-tuned variants, available in E4B and E2B sizes. While large portions of the language model architecture are shared with prior Gemma releases, there are many new additions in this model, including [Alternating Updates][altup] (AltUp), [Learned Augmented Residual Layer][laurel] (LAuReL), [MatFormer][matformer], Per-Layer Embeddings (PLE), [Activation Sparsity with Statistical Top-k][spark-transformer], and KV cache sharing. The language model uses a similar attention pattern to Gemma 3 with alternating 4 local sliding window self-attention layers for every global self-attention layer with a maximum context length of 32k tokens. Gemma 3n introduces MobileNet v5 as the vision encoder, using a default resolution of 768x768 pixels, and adds a newly trained audio encoder based on the [Universal Speech Model][usm] (USM) architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma3n> ;
    skos:related dlt:Gemma3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 4"@en ;
    skos:definition "Gemma 4 is a multimodal model with pretrained and instruction-tuned variants, available in E2B, E4B, 31B and 26B-A4B (MoE) parameter sizes. The key difference from previous Gemma releases for vision is the new design to process images of different sizes using a fixed-budget number of tokens. Unlike many models that squash every image into a fixed square (like 224×224), Gemma 4 keeps the image’s natural aspect ratio while making it the right size."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma4> ;
    skos:related dlt:Gemma3;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Gemma4Unified a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Gemma 4 Unified"@en ;
    skos:definition "Gemma 4 12B Unified is an encoder-free multimodal model with pretrained and instruction-tuned variants. Unlike standard Gemma 4, which uses dedicated encoder towers, Gemma 4 12B Unified projects raw inputs directly into the language model's embedding space through lightweight linear pipelines. This results in a simpler architecture while maintaining strong multimodal performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gemma4_unified> ;
    skos:related dlt:Gemma4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GIT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GIT"@en ;
    skos:definition "GIT is a decoder-only Transformer that leverages CLIP's vision encoder to condition the model on vision inputs besides text."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/git> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM46V a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM46V"@en ;
    skos:definition "GLM-4.6V is an enhanced GLM-4V model that adds native tool use and long-context support for multimodal understanding and autonomous task execution."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm46v> ;
    skos:related dlt:GLM4V ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4V a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM4V"@en ;
    skos:definition "GLM-4V is based on the GLM-4 language model family and extends it with vision-language capabilities and multimodal reasoning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm4v> ;
    skos:related dlt:GLM4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLM4VMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM4-V MoE"@en ;
    skos:definition "GLM-4V-MoE is based on GLM-4V and extends it with a Mixture-of-Experts architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm4v_moe> ;
    skos:related dlt:GLM4V ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLMGA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLMGA"@en ;
    skos:definition "GLMGA is based on GLM-4.6V and reuses its vision-language architecture with model-specific multimodal configuration and image/video processing."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glmga> ;
    skos:related dlt:GLM46V ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GLMOCR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GLM-OCR"@en ;
    skos:definition "GLM-OCR is a multimodal OCR (Optical Character Recognition) model designed for complex document understanding from Z.ai. The model combines a CogViT visual encoder (pre-trained on large-scale image-text data), a lightweight cross-modal connector with efficient token downsampling, and a GLM-0.5B language decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/glm_ocr> ;
    skos:related dlt:GLM4 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GOTOCR2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GOT-OCR2"@en ;
    skos:definition "GOT (General OCR Theory) is an end-to-end OCR-2.0 model that unifies recognition of diverse optical characters, including text, formulas, tables, charts, and diagrams, using a vision encoder and long-context decoder architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/got_ocr2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Granite4Vision a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Granite Vision 4.1"@en ;
    skos:definition "Granite Vision 4.1 is a vision-language model from IBM Research designed for enterprise-grade document data extraction. It specializes in chart extraction (Chart2CSV, Chart2Summary, Chart2Code), table extraction (JSON, HTML, OTSL), and semantic key-value pair extraction."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granite4_vision> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GraniteVision a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Granite Vision"@en ;
    skos:definition "The Granite Vision model is a variant of LLaVA-NeXT, leveraging a Granite language model alongside a SigLIP visual encoder. It utilizes multiple concatenated vision hidden states as its image features, similar to VipLlava. It also uses a larger set of image grid pinpoints than the original LlaVa-NeXT models to support additional aspect ratios."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/granitevision> ;
    skos:related dlt:LLaVA, dlt:SigLIP, dlt:VipLlava, dlt:Granite ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GroundingDINO a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Grounding DINO"@en ;
    skos:definition "Grounding DINO extends a closed-set object detection model (DINO) with a text encoder, enabling open-set object detection. The model achieves remarkable results, such as 52.5 AP on COCO zero-shot."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/grounding-dino> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:GroupViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GroupViT"@en ;
    skos:definition "Inspired by CLIP, GroupViT is a vision-language model that can perform zero-shot semantic segmentation on any given vocabulary categories."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/groupvit> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:IDEFICS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "IDEFICS"@en ;
    skos:definition "IDEFICS is a large vision-language model based on multimodal pretraining with interleaved image-text documents, leveraging the OBELICS dataset to learn visual and textual representations for image understanding and text generation tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/idefics> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Idefics2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Idefics2"@en ;
    skos:definition "Idefics2 is an open multimodal model that accepts arbitrary sequences of image and text inputs and produces text outputs. The model can answer questions about images, describe visual content, create stories grounded on multiple images, or simply behave as a pure language model without visual inputs. It improves upon IDEFICS-1, notably on document understanding, OCR, or visual reasoning. Idefics2 is lightweight (8 billion parameters) and treats images in their native aspect ratio and resolution, which allows for varying inference efficiency."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/idefics2> ;
    skos:related dlt:IDEFICS ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Idefics3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Idefics3"@en ;
    skos:definition "Idefics3 is an adaptation of the Idefics2 model with three main differences : it uses Llama3 for the text model, it uses an updated processing logic for the images and it removes the perceiver."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/idefics3> ;
    skos:related dlt:Idefics2, dlt:Llama3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Inkling a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Inkling"@en ;
    skos:definition "Inkling is a general-purpose multimodal model from Thinking Machines Lab that accepts text, image, and audio inputs and generates text. It is a 66-layer decoder-only transformer with a sparse mixture-of-experts (MoE) feed-forward backbone — each token is routed to 6 of 256 experts alongside 2 shared experts that are always active — for 975B total parameters with 41B active per token. Image and audio inputs are projected into the language model's embedding space and interleaved with text tokens, so a single checkpoint reasons jointly over all three modalities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/inkling>, <https://huggingface.co/thinkingmachines/Inkling> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:InstructBLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "InstructBLIP"@en ;
    skos:definition "InstructBLIP leverages the BLIP-2 architecture for visual instruction tuning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/instructblip> ;
    skos:related dlt:BLIP2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:InstructBLIPVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "InstructBLIPVideo"@en ;
    skos:definition "InstructBLIPVideo uses the same architecture as InstructBLIP and works with the same checkpoints as InstructBLIP. The only difference is the ability to process videos."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/instructblipvideo> ;
    skos:related dlt:InstructBLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:InternVL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "InternVL"@en ;
    skos:definition "InternVL3 is a native multimodal large language model that jointly pretrains vision and language capabilities instead of adapting a text-only LLM, enabling scalable multimodal understanding with extended visual contexts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/internvl> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Janus a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Janus"@en ;
    skos:definition "Janus is an autoregressive multimodal model that separates visual encoding for understanding and generation while maintaining a unified Transformer architecture for multimodal tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/janus> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:KimiK25 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Kimi K2.5"@en ;
    skos:definition "Kimi K2.5 is an open-source, native multimodal agentic model that advances practical capabilities in long-horizon coding, coding-driven design, proactive autonomous execution, and swarm-based task orchestration."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/kimi_k25> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:KOSMOS2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "KOSMOS-2"@en ;
    skos:definition "KOSMOS-2 is a Transformer-based causal language model and is trained using the next-word prediction task on a web-scale dataset of grounded image-text pairs GRIT. The spatial coordinates of the bounding boxes in the dataset are converted to a sequence of location tokens, which are appended to their respective entity text spans (for example, a snowman followed by <patch_index_0044><patch_index_0863>). The data format is similar to “hyperlinks” that connect the object regions in an image to their text span in the corresponding caption."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/kosmos-2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:KOSMOS25 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Kosmos-2.5"@en ;
    skos:definition "Kosmos-2.5 is based on Kosmos-2 and extends its multimodal capabilities toward text-intensive image understanding through spatial text grounding and structured document generation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/kosmos2_5> ;
    skos:related dlt:KOSMOS2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LayoutLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LayoutLM"@en ;
    skos:definition "LayoutLM jointly learns text and the document layout rather than focusing only on text. It incorporates positional layout information and visual features of words from the document images."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/layoutlm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LayoutLMV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LayoutLMV2"@en ;
    skos:definition "LayoutLMV2 improves LayoutLM. The main difference between LayoutLMv1 and LayoutLMv2 is that the latter incorporates visual embeddings during pre-training (while LayoutLMv1 only adds visual embeddings during fine-tuning). LayoutLMv2 adds both a relative 1D attention bias as well as a spatial 2D attention bias to the attention scores in the self-attention layers."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/layoutlmv2> ;
    skos:related dlt:LayoutLM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LayoutLMV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LayoutLMV3"@en ;
    skos:definition "LayoutLMv3 simplifies LayoutLMv2 by using patch embeddings (as in ViT) instead of leveraging a CNN backbone, and pre-trains the model on 3 objectives: masked language modeling (MLM), masked image modeling (MIM) and word-patch alignment (WPA)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/layoutlmv3> ;
    skos:related dlt:LayoutLMV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LayoutXLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LayoutXLM"@en ;
    skos:definition "LayoutXLM is a multilingual extension of the LayoutLMv2 model trained on 53 languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/layoutxlm> ;
    skos:related dlt:LayoutLMV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LFM2VL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LFM2-VL"@en ;
    skos:definition "LFM2-VL extends the LFM2 family of open-weight Liquid Foundation Models (LFMs) into the vision-language space, supporting both text and image inputs with variable resolutions. LFM2-VL consists of three main components: a language model backbone, a vision encoder, and a multimodal projector. LFM2-VL builds upon the LFM2 backbone, inheriting from either LFM2-1.2B (for LFM2-VL-1.6B) or LFM2-350M (for LFM2-VL-450M). For the vision tower, LFM2-VL uses SigLIP2 NaFlex encoders to convert input images into token sequences. LFM2-VL consists of three main components: a language model backbone, a vision encoder, and a multimodal projector. LFM2-VL builds upon the LFM2 backbone, inheriting from either LFM2-1.2B (for LFM2-VL-1.6B) or LFM2-350M (for LFM2-VL-450M). For the vision tower, LFM2-VL uses SigLIP2 NaFlex encoders to convert input images into token sequences."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lfm2_vl> ;
    skos:related dlt:LFM2, dlt:SigLIP2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LightOnOcr a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LightOnOcr"@en ;
    skos:definition "LightOnOcr is a compact, end-to-end vision–language model for Optical Character Recognition (OCR) and document understanding. LightOnOcr combines a Vision Transformer encoder (Pixtral-based) with a lightweight text decoder (Qwen3-based) distilled from high-quality open VLMs. It is optimized for document parsing tasks, producing accurate, layout-aware text extraction from high-resolution pages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lighton_ocr> ;
    skos:related dlt:Pixtral, dlt:Qwen3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LiLT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LiLT"@en ;
    skos:definition "LiLT allows to combine any pre-trained RoBERTa text encoder with a lightweight Layout Transformer, to enable LayoutLM-like document understanding for many languages."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lilt> ;
    skos:related dlt:RoBERTa, dlt:LayoutLM ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Llama4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Llama 4"@en ;
    skos:definition "Llama 4 extends Llama 3 with a native multimodal Mixture-of-Experts design, enabling improved language, vision, and long-context capabilities."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llama4> ;
    skos:related dlt:Llama3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LLaVA a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LLaVA"@en ;
    skos:definition "LLaVA is an open-source chatbot trained by fine-tuning LlamA/Vicuna on GPT-generated multimodal instruction-following data. It is an auto-regressive language model, based on the transformer architecture. In other words, it is an multi-modal version of LLMs fine-tuned for chat / instructions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llava> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LLaVANeXT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LLaVA‑NeXT"@en ;
    skos:definition "LLaVA‑NeXT improves on Llava by increasing the input image resolution by 4x more pixels and supporting 3 aspect ratios (up to 672x672, 336x1344, 1344x336) to better grasp visual details. It is also trained on an improved visual instruction tuning dataset covering more scenarios and applications to improve OCR and common sense reasoning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llava_next> ;
    skos:related dlt:LLaVA ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LLaVANextVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LLaVA-NeXT-Video"@en ;
    skos:definition "LLaVa-NeXT-Video improves upon LLaVa-NeXT by fine-tuning on a mix if video and image dataset thus increasing the model's performance on videos."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llava_next_video> ;
    skos:related dlt:LLaVANeXT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LLaVAOneVision a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LLaVA-OneVision"@en ;
    skos:definition "LLaVA-OneVision is a Vision-Language Model that can generate text conditioned on one or several images/videos. The model consists of SigLIP vision encoder and a Qwen2 language backbone. The images are processed with anyres-9 technique where the image is split into 9 patches to better process high resolution images and capture as much details as possible. However, videos are pooled to a total sequence length of 196 tokens each frame for more memory efficient computation. LLaVA-OneVision is available in three sizes: 0.5B, 7B and 72B and achieves remarkable performance on benchmark evaluations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/llava_onevision> ;
    skos:related dlt:LLaVA, dlt:SigLIP, dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:LXMERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "LXMERT"@en ;
    skos:definition "The LXMERT model is a series of bidirectional transformer encoders (one for the vision modality, one for the language modality, and then one to fuse both modalities) pretrained using a combination of masked language modeling, visual-language text alignment, ROI-feature regression, masked visual-attribute modeling, masked visual-object modeling, and visual-question answering objectives. The pretraining consists of multiple multi-modal datasets: MSCOCO, Visual-Genome + Visual-Genome Question Answering, VQA 2.0, and GQA."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/lxmert> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MatCha a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MatCha"@en ;
    skos:definition "MatCha (Math reasoning and Chart derendering pretraining) is a Visual Question Answering subset of Pix2Struct architecture. It renders the input question on the image and predicts the answer. It is specialized for charts and plots through math reasoning and chart derendering pretraining."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/matcha> ;
    skos:related dlt:Pix2Struct ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MetaCLIP2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MetaCLIP 2"@en ;
    skos:definition "MetaCLIP 2 is a replication of the original CLIP model trained on 300+ languages. It achieves state-of-the-art (SOTA) results on multilingual benchmarks (e.g., XM3600, CVQA, Babel‑ImageNet), surpassing previous SOTA such as mSigLIP and SigLIP‑2. The authors show that English and non-English worlds can mutually benefit and elevate each other."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/metaclip_2> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MGPSTR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MGP-STR"@en ;
    skos:definition "MGP-STR is a conceptually simple yet powerful vision Scene Text Recognition (STR) model, which is built upon the Vision Transformer (ViT). To integrate linguistic knowledge, Multi-Granularity Prediction (MGP) strategy is proposed to inject information from the language modality into the model in an implicit way."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mgp-str> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MiniCPMV a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MiniCPM-V"@en ;
    skos:definition "MiniCPM-V is a series of efficient multimodal large language models developed by OpenBMB. The MiniCPM-V 4.6 architecture uses a SigLIP vision encoder with a window-attention merger and a Qwen3.5 language model backbone, supporting both 4x and 16x visual downsampling modes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/minicpmv4_6> ;
    skos:related dlt:SigLIP, dlt:Qwen35 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mistral3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mistral3"@en ;
    skos:definition "Mistral 3 is a latency optimized model with a lot fewer layers to reduce the time per forward pass. This model adds vision understanding and supports long context lengths of up to 128K tokens without compromising performance."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mistral3> ;
    skos:related dlt:Mistral ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mistral4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Mistral4"@en ;
    skos:definition "Mistral 4 is a powerful hybrid model with the capability of acting as both a general instruction model and a reasoning model. It unifies the capabilities of three different model families - Instruct, Reasoning ( previous called Magistral ), and Devstral - into a single, unified model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mistral4> ;
    skos:related dlt:Mistral3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Mllama a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "mllama"@en ;
    skos:definition "The Llama 3.2-Vision (mllama) collection of multimodal large language models (LLMs) is a collection of pretrained and instruction-tuned image reasoning generative models in 11B and 90B sizes (text \\+ images in / text out). The Llama 3.2-Vision instruction-tuned models are optimized for visual recognition, image reasoning, captioning, and answering general questions about an image. Llama 3.2-Vision is built on top of Llama 3.1 text-only model, which is an auto-regressive language model that uses an optimized transformer architecture. The tuned versions use supervised fine-tuning (SFT) and reinforcement learning with human feedback (RLHF) to align with human preferences for helpfulness and safety. To support image recognition tasks, the Llama 3.2-Vision model uses a separately trained vision adapter that integrates with the pre-trained Llama 3.1 language model. The adapter consists of a series of cross-attention layers that feed image encoder representations into the core LLM."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mllama> ;
    skos:related dlt:Llama3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MMGroundingDINO a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "MM Grounding DINO"@en ;
    skos:definition "MM Grounding DINO improves upon the Grounding DINO by improving the contrastive class head and removing the parameter sharing in the decoder, improving zero-shot detection performance on both COCO (50.6(+2.2) AP) and LVIS (31.9(+11.8) val AP and 41.4(+12.6) minival AP)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/mm-grounding-dino> ;
    skos:related dlt:GroundingDINO ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:MusicFlamingo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Music Flamingo"@en ;
    skos:definition "Music Flamingo is a fully open large audio–language model designed for robust understanding and reasoning over music. It builds upon the Audio Flamingo 3 architecture by including Rotary Time Embeddings (RoTE), which injects temporal position information to enable the model to handle audio sequences up to 20 minutes (1200 seconds)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/musicflamingo> ;
    skos:related dlt:AudioFlamingo3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Nougat a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Nougat"@en ;
    skos:definition "Nougat uses the same architecture as Donut, meaning an image Transformer encoder and an autoregressive text Transformer decoder to translate scientific PDFs to markdown, enabling easier access to them."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/nougat> ;
    skos:related dlt:Donut ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OmDetTurbo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OmDet-Turbo"@en ;
    skos:definition "OmDet-Turbo incorporates components from RT-DETR and introduces a swift multimodal fusion module to achieve real-time open-vocabulary object detection capabilities while maintaining high accuracy. The base model achieves performance of up to 100.2 FPS and 53.4 AP on COCO zero-shot."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/omdet-turbo> ;
    skos:related dlt:RTDETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OneFormer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OneFormer"@en ;
    skos:definition "OneFormer is a universal image segmentation framework that can be trained on a single panoptic dataset to perform semantic, instance, and panoptic segmentation tasks. OneFormer uses a task token to condition the model on the task in focus, making the architecture task-guided for training, and task-dynamic for inference."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/oneformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Ovis2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Ovis2"@en ;
    skos:definition "Ovis2 is a multimodal large language model that improves vision-language understanding through a unified architecture combining visual and textual representations for multimodal reasoning and generation tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/ovis2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OWLViT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OWL-ViT"@en ;
    skos:definition "OWL-ViT is an open-vocabulary object detection network trained on a variety of (image, text) pairs. It can be used to query an image with one or multiple text queries to search for and detect target objects described in text. OWL-ViT is a zero-shot text-conditioned object detection model. OWL-ViT uses CLIP as its multi-modal backbone, with a ViT-like Transformer to get visual features and a causal language model to get the text features. To use CLIP for detection, OWL-ViT removes the final token pooling layer of the vision model and attaches a lightweight classification and box head to each transformer output token. Open-vocabulary classification is enabled by replacing the fixed classification layer weights with the class-name embeddings obtained from the text model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/owlvit> ;
    skos:related dlt:CLIP, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:OWLv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "OWLv2"@en ;
    skos:definition "OWLv2 scales up OWL-ViT using self-training, which uses an existing detector to generate pseudo-box annotations on image-text pairs. This results in large gains over the previous state-of-the-art for zero-shot object detection."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/owlv2> ;
    skos:related dlt:OWLViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PaddleOCRVL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PaddleOCR-VL"@en ;
    skos:definition "PaddleOCR-VL is a SOTA and resource-efficient model tailored for document parsing. Its core component is PaddleOCR-VL-0.9B, a compact yet powerful vision-language model (VLM) that integrates a NaViT-style dynamic resolution visual encoder with the ERNIE-4.5-0.3B language model to enable accurate element recognition. This innovative model efficiently supports 109 languages and excels in recognizing complex elements (e.g., text, tables, formulas, and charts), while maintaining minimal resource consumption."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/paddleocr_vl> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PaliGemma a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PaliGemma"@en ;
    skos:definition "PaliGemma is a family of vision-language models (VLMs), combining SigLIP with the Gemma 2B model. PaliGemma is available in 3B, 10B, and 28B parameters. The main purpose of PaliGemma is to provide an adaptable base VLM that is easy to transfer to other tasks. The SigLIP vision encoder is a \"shape optimized\" contrastively pretrained ViT that converts an image into a sequence of tokens and prepended to an optional prompt. The Gemma 2B model is used as the decoder. PaliGemma uses full attention on all image and text tokens to maximize its capacity."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/paligemma> ;
    skos:related dlt:SigLIP, dlt:Gemma, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PEAudioVideo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PE Audio Video"@en ;
    skos:definition "PE Audio Video is the joint audio–video branch of Meta's Perception Encoder family. It encodes audio and video streams together with a shared text tower, producing contrastive embeddings for every pairwise combination, audio-text, video-text, audio-video, and audio+text-video, from a single forward pass."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pe_audio_video> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Perceiver a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Perceiver IO"@en ;
    skos:definition "Perceiver IO is a generalization of Perceiver to handle arbitrary outputs in addition to arbitrary inputs. The original Perceiver only produced a single classification label. In addition to classification labels, Perceiver IO can produce (for example) language, optical flow, and multimodal videos with audio. This is done using the same building blocks as the original Perceiver. The computational complexity of Perceiver IO is linear in the input and output size and the bulk of the processing occurs in the latent space, allowing us to process inputs and outputs that are much larger than can be handled by standard Transformers. This means, for example, Perceiver IO can do BERT-style masked language modeling directly using bytes instead of tokenized inputs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/perceiver> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PerceptionLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PerceptionLM"@en ;
    skos:definition "The PerceptionLM model is a fully open, reproducible model for transparent research in image and video understanding. PLM consists of a vision encoder with a small scale (<8B parameters) LLM decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/perception_lm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Phi4Multimodal a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Phi4 Multimodal"@en ;
    skos:definition "Phi4 Multimodal is a multimodal model capable of text, image, and speech and audio inputs or any combination of these. It features a mixture of LoRA adapters for handling different inputs, and each input is routed to the appropriate encoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/phi4_multimodal> ;
    skos:related dlt:Phi ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PI0 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PI0"@en ;
    skos:definition "PI0 is a vision-language-action model for robotics manipulation. It jointly processes visual observations and language instructions to generate robot actions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pi0> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Pix2Struct a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Pix2Struct"@en ;
    skos:definition "Pix2Struct is an image-to-text vision-language model pretrained on masked webpage screenshots to learn visual language representations for tasks such as visual question answering, image captioning, and document understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pix2struct> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Pixtral a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Pixtral"@en ;
    skos:definition "Pixtral is a multimodal model trained to understand natural images and documents. It accepts images in their natural resolution and aspect ratio without resizing or padding due to it's 2D RoPE embeddings. In addition, Pixtral has a long 128K token context window for processing a large number of images. Pixtral couples a 400M vision encoder with a 12B Mistral Nemo decoder."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pixtral> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPDocLayoutV2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-DocLayoutV2"@en ;
    skos:definition "PP-DocLayoutV2 is a dedicated lightweight model for layout analysis, focusing specifically on element detection, classification, and reading order prediction. PP-DocLayoutV2 is composed of two sequentially connected networks. The first is an RT-DETR-based detection model that performs layout element detection and classification. The detected bounding boxes and class labels are then passed to a subsequent pointer network, which is responsible for ordering these layout elements."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_doclayout_v2> ;
    skos:related dlt:RTDETR ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPDocLayoutV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-DocLayoutV3"@en ;
    skos:definition "PP-DocLayoutV3 is a unified and high-efficiency model designed for comprehensive layout analysis. It addresses the challenges of complex physical distortions—such as skewing, curving, and adverse lighting—by integrating instance segmentation and reading order prediction into a single, end-to-end framework. P-DocLayoutV3 evolves from a traditional detection-based approach to a robust instance segmentation architecture built upon the RT-DETR framework. Instead of simple bounding boxes, it utilizes a mask-based detection head to predict pixel-accurate segments for layout elements. Unlike its predecessor, PP-DocLayoutV3 eliminates decoupled stages by embedding a Global Pointer Mechanism directly within the Transformer decoder layers. This allows the model to concurrently output classification labels, precise masks, and logical reading orders in a single forward pass, significantly reducing latency while enhancing parsing precision on complex document layouts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_doclayout_v3> ;
    skos:related dlt:PPDocLayoutV2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPFormulaNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-FormulaNet"@en ;
    skos:definition "PP-FormulaNet is a vision-language model for mathematical formula recognition that converts formula images into structured LaTeX representations."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_formulanet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv5MobileDet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv5_mobile_det"@en ;
    skos:definition "PP-OCRv5_mobile_det is a dedicated lightweight model for text detection, focusing specifically on efficient detection and understanding of text elements in multi-language documents and natural scenes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv5_mobile_det> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv5MobileRec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv5_mobile_rec"@en ;
    skos:definition "PP-OCRv5_mobile_rec is a dedicated lightweight model for text recognition, focusing specifically on efficient recognition and understanding of text elements in multi-language documents and natural scenes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv5_mobile_rec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv5ServerDet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv5_server_det"@en ;
    skos:definition "PP-OCRv5_server_det is a high-performance text detection model optimized for server-side applications, focusing on accurate detection of multi-language text in documents and natural scenes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv5_server_det> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv5ServerRec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv5_server_rec"@en ;
    skos:definition "PP-OCRv5_server_rec is a dedicated lightweight model for text recognition, focusing specifically on efficient recognition and understanding of text elements in multi-language documents and natural scenes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv5_server_rec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv6MediumDet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv6_medium_det"@en ;
    skos:definition "PP-OCRv6_medium_det is the largest model in the PP-OCRv6 detection series developed by the PaddleOCR team. It uses LCNetV4 as the backbone and RepLKFPN as the feature pyramid neck, providing accurate text localization across diverse scenarios including handwritten, printed, rotated, curved, and artistic text in multiple languages. The model contains 15.5M parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv6_medium_det> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv6SmallDet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv6_small_det"@en ;
    skos:definition "PP-OCRv6_small_det is the small model in the PP-OCRv6 detection series developed by the PaddleOCR team. It uses LCNetV4 as the backbone and RepLKFPN as the feature pyramid neck, providing accurate text localization across diverse scenarios including handwritten, printed, rotated, curved, and artistic text in multiple languages. The model contains 2.48M parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv6_small_det> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv6SmallRec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv6_small_rec"@en ;
    skos:definition "PP-OCRv6_small_rec is the mid-tier recognition model in the PP-OCRv6 series. It uses LCNetV4 as the backbone and EncoderWithLightSVTR as the recognition neck, with a CTC+NRTR multi-head decoder. The model supports 50 languages and contains 5.2M parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv6_small_rec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPOCRv6TinyRec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-OCRv6_tiny_rec"@en ;
    skos:definition "PP-OCRv6_tiny_rec is the most lightweight recognition model in the PP-OCRv6 series. It uses LCNetV4 as the backbone with a direct reshape projection instead of an encoder neck, and a CTC+NRTR multi-head decoder. The model supports 49 languages and contains 1.1M parameters."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_ocrv6_tiny_rec> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPChart2Table a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-Chart2Table"@en ;
    skos:definition "PP-Chart2Table is a SOTA multimodal model developed by the PaddlePaddle team, specializing in chart parsing for both Chinese and English. Its high performance is driven by a novel \"Shuffled Chart Data Retrieval\" training task, which, combined with a refined token masking strategy, significantly improves its efficiency in converting charts to data tables. The model is further strengthened by an advanced data synthesis pipeline that uses high-quality seed data, RAG, and LLMs persona design to create a richer, more diverse training set. To address the challenge of large-scale unlabeled, out-of-distribution (OOD) data, the team implemented a two-stage distillation process, ensuring robust adaptability and generalization on real-world data. PP-Chart2Table adopts a multimodal fusion architecture that combines a vision tower for chart feature extraction and a language model for table structure generation, enabling end-to-end chart-to-table conversion."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_chart2table> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPLCNet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-LCNet"@en ;
    skos:definition "PP-LCNet PP-LCNet is a family of efficient, lightweight convolutional neural networks designed for real-world document understanding and OCR tasks. It balances accuracy, speed, and model size, making it ideal for both server-side and edge deployment. To address different document processing requirements, PP-LCNet has three main variants, each optimized for a specific task."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_lcnet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPLCNetV3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-LCNetV3"@en ;
    skos:definition "PPLCNetV3 is a lightweight CPU-optimized convolutional backbone designed for efficient image classification and downstream vision tasks. It builds on the PP-LCNet architecture with improved training strategies and structural refinements for better accuracy-latency tradeoffs on CPU hardware."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_lcnet_v3> ;
    skos:related dlt:PPLCNet ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PPLCNetV4 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PP-LCNetV4"@en ;
    skos:definition "PPLCNetV4 is provided as a backbone network only. No pre-trained image classification checkpoint has been officially released."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/pp_lcnet_v4> ;
    skos:related dlt:PPLCNetV3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:QianfanOCR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qianfan-OCR"@en ;
    skos:definition "Qianfan-OCR is a 4B-parameter end-to-end document intelligence model. Unlike traditional multi-stage OCR pipelines, Qianfan-OCR performs direct image-to-text conversion and supports a broad range of prompt-driven tasks — from structured document parsing and table extraction to chart understanding, document question answering, and key information extraction — all within one model. The model adopts a multimodal bridging architecture consisting of three components: Qianfan-ViT for the Vision Encoder, Qwen3-4B for the Language Model and 2-layer MLP with GELU activation for the Cross-Modal Adapter."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qianfan_ocr> ;
    skos:related dlt:Qwen3, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen25Omni a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2.5-Omni"@en ;
    skos:definition "Qwen2.5-Omni is based on Qwen2.5 and extends the model family with unified multimodal understanding and streaming text-and-speech generation across text, vision, audio, and video inputs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2_5_omni> ;
    skos:related dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen25VL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2.5-VL"@en ;
    skos:definition "Qwen2.5-VL is a multimodal vision-language model, available in 3B, 7B, and 72B parameters, pretrained on 4.1T tokens. The model introduces window attention in the ViT encoder to accelerate training and inference, dynamic FPS sampling on the spatial and temporal dimensions for better video understanding across different sampling rates, and an upgraded MRoPE (multi-resolutional rotary positional encoding) mechanism to better capture and learn temporal dynamics."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2_5_vl> ;
    skos:related dlt:Qwen2VL, dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen2Audio a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2-Audio"@en ;
    skos:definition "Qwen2-Audio is based on Qwen2 and extends the model family with audio understanding capabilities for voice interaction, audio analysis, and instruction following."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2_audio> ;
    skos:related dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen2VL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen2-VL"@en ;
    skos:definition "Qwen2-VL is based on the Qwen model family and extends Qwen with vision-language capabilities, enabling advanced image and video understanding, visual reasoning, and multimodal agent tasks through dynamic resolution processing and Multimodal Rotary Position Embedding (M-ROPE)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen2_vl> ;
    skos:related dlt:Qwen2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3OmniMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3-Omni-MOE"@en ;
    skos:definition "Qwen3-Omni-MoE is based on the Qwen3 model family and extends it into an omni-modal Mixture-of-Experts architecture capable of jointly processing text, images, audio, and video while generating fluent text and real-time speech responses through a Thinker-Talker MoE framework."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_omni_moe> ;
    skos:related dlt:Qwen3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3VL a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3-VL"@en ;
    skos:definition "Qwen3-VL is a multimodal vision-language model series, encompassing both dense and MoE variants, as well as Instruct and Thinking versions. Building upon its predecessors, Qwen3-VL delivers significant improvements in visual understanding while maintaining strong pure text capabilities. Key architectural advancements include: enhanced MRope with interleaved layout for better spatial-temporal modeling, DeepStack integration to effectively leverage multi-level features from the Vision Transformer (ViT), and improved video understanding through text-based time alignment—evolving from T-RoPE to text timestamp alignment for more precise temporal grounding. These innovations collectively enable Qwen3-VL to achieve superior performance in complex multimodal tasks."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_vl> ;
    skos:related dlt:Qwen25VL ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Qwen3VLMoE a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Qwen3-VL MoE"@en ;
    skos:definition "Qwen3-VL-MoE is based on Qwen3-VL and introduces a Mixture-of-Experts architecture."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/qwen3_vl_moe> ;
    skos:related dlt:Qwen3VL ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM3"@en ;
    skos:definition "SAM3 performs Promptable Concept Segmentation (PCS) on images. PCS takes text and/or image exemplars as input (e.g., “yellow school bus”), and predicts instance and semantic masks for every single object matching the concept."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam3> ;
    skos:related dlt:SAM2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM3Video a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM3 Video"@en ;
    skos:definition "SAM3 Video performs Promptable Concept Segmentation (PCS) on videos. PCS takes text as input (e.g., “yellow school bus”), and predicts instance and semantic masks for every single object matching the concept, while preserving object identities across video frames. The model combines a detection module (SAM3) with a tracking module (SAM2-style tracker) to enable robust object tracking across video frames using text prompts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam3_video> ;
    skos:related dlt:SAM3, dlt:SAM2 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SAM3LiteText a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SAM3-LiteText"@en ;
    skos:definition "SAM3-LiteText is a lightweight variant of SAM3 that replaces the heavy SAM3 text encoder (353M parameters) with a compact MobileCLIP-based text encoder optimized through knowledge distillation. The SAM3 ViT-H image encoder is kept intact. This reduces text encoder parameters by up to 88% while maintaining segmentation performance comparable to the original model."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/sam3_lite_text> ;
    skos:related dlt:SAM3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ShieldGemma2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ShieldGemma2"@en ;
    skos:definition "ShieldGemma 2, built on Gemma 3, is a 4 billion (4B) parameter model that checks the safety of both synthetic and natural images against key categories (e.g., sexually explicit content, dangerous content, violence/gore content) to help you build robust datasets and models."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/shieldgemma2> ;
    skos:related dlt:Gemma3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SigLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SigLIP"@en ;
    skos:definition "SigLIP is a multimodal image-text model similar to CLIP. It uses separate image and text encoders to generate representations for both modalities. Unlike CLIP, SigLIP employs a pairwise sigmoid loss on image-text pairs during training. This training loss eliminates the need for a global view of all pairwise similarities between images and texts within a batch. Consequently, it enables more efficient scaling to larger batch sizes while also delivering superior performance with smaller batch sizes."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/siglip> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SigLIP2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SigLIP2"@en ;
    skos:definition "SigLIP2 is a family of multilingual vision-language encoders that builds on the SigLIP training recipe. It includes decoder-based pretraining, self-distillation, and masked prediction to improve dense prediction tasks (segmentation, depth estimation, etc.)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/siglip2> ;
    skos:related dlt:SigLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SLANet a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SLANet"@en ;
    skos:definition "SLANet is a table structure recognition model developed by Baidu PaddlePaddle Vision Team. The model significantly improves the accuracy and inference speed of table structure recognition by adopting a CPU-friendly lightweight backbone network PP-LCNet, a high-low-level feature fusion module CSP-PAN, and a feature decoding module SLA Head that aligns structural and positional information."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/slanet> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SLANeXt a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SLANeXt"@en ;
    skos:definition "The SLANeXt series is a new generation of table structure recognition models independently developed by the Baidu PaddlePaddle Vision Team. SLANeXt focuses on table structure recognition, and trains dedicated weights for wired and wireless tables separately. The recognition ability for all types of tables has been significantly improved, especially for wired tables."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/slanext> ;
    skos:related dlt:SLANet ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:SmolVLM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "SmolVLM2"@en ;
    skos:definition "SmolVLM2 is an adaptation of the Idefics3 model with two main differences: it uses SmolLM2 for the text model and it supports multi-image and video inputs."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/smolvlm> ;
    skos:related dlt:Idefics3 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TAPAS a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TAPAS"@en ;
    skos:definition "The TAPAS model is a BERT-based model specifically designed (and pre-trained) for answering questions about tabular data. Compared to BERT, TAPAS uses relative position embeddings and has 7 token types that encode tabular structure. TAPAS is pre-trained on the masked language modeling (MLM) objective on a large dataset comprising millions of tables from English Wikipedia and corresponding texts."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/tapas> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TIPSv2 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TIPSv2"@en ;
    skos:definition "TIPSv2 (Text-Image Pre-training with Spatial awareness) is a family of image-text encoder models that improves vision-language pretraining through enhanced patch-text alignment, using patch-level distillation, an upgraded iBOT++ masked image objective, and improved training strategies."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/tipsv2> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TIPSv2DPT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TIPSv2 DPT"@en ;
    skos:definition "TIPSv2 DPT is a variant of the TIPSv2 model with a dense prediction transformer head (DPT)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/tipsv2_dpt> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TrOCR a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TrOCR"@en ;
    skos:definition "TrOCR is a text recognition model for both image understanding and text generation. It doesn't require separate models for image processing or character generation. TrOCR is a simple single end-to-end system that uses a transformer to handle visual understanding and text generation."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/trocr> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TVP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TVP"@en ;
    skos:definition "The text-visual prompting (TVP) is a text-visual prompting framework for temporal video grounding that introduces learnable prompts into visual and textual inputs to enable efficient video-text alignment using low-complexity 2D visual features instead of computationally expensive 3D CNN features."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/tvp> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:UDOP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "UDOP"@en ;
    skos:definition "UDOP (Universal Document Processing) adopts an encoder-decoder Transformer architecture based on T5 for document AI tasks like document image classification, document parsing and document visual question answering."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/udop> ;
    skos:related dlt:T5 ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VideoLLaMA3 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Video LLaMA 3"@en ;
    skos:definition "VideoLLaMA3 is a vision-centric multimodal foundation model for image and video understanding that combines a vision encoder with a large language model and uses large-scale image-text and video-text training to improve multimodal reasoning."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/video_llama_3> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VideoLLaVa a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Video-LLaVa"@en ;
    skos:definition "Video-LLaVa is an open-source multimodal LLM trained by fine-tuning LlamA/Vicuna on multimodal instruction-following data generated by Llava1.5 and VideChat. It is an auto-regressive language model, based on the transformer architecture. Video-LLaVa unifies visual representations to the language feature space, and enables an LLM to perform visual reasoning capabilities on both images and videos simultaneously."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/video_llava> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ViLT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "ViLT"@en ;
    skos:definition "ViLT incorporates text embeddings into a Vision Transformer (ViT), allowing it to have a minimal design for Vision-and-Language Pre-training (VLP)."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vilt> ;
    skos:related dlt:ViT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VipLlava a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VipLlava"@en ;
    skos:definition "VipLlava enhances the training protocol of Llava by marking images and interact with the model using natural cues like a “red bounding box” or “pointed arrow” during training."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/vipllava> ;
    skos:related dlt:LLaVA ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VisualBERT a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "VisualBERT"@en ;
    skos:definition "VisualBERT is a vision-and-language model. It uses an approach called \"early fusion\", where inputs are fed together into a single Transformer stack initialized from BERT. Self-attention implicitly aligns words with their corresponding image objects. It processes text with visual features from object-detector regions instead of raw pixels."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/visual_bert> ;
    skos:related dlt:BERT ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Voxtral a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Voxtral"@en ;
    skos:definition "Voxtral is an upgrade of Ministral 3B and Mistral Small 3B, extending its language capabilities with audio input support. It is designed to handle tasks such as speech transcription, translation, and audio understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/voxtral> ;
    skos:related dlt:Mistral, dlt:Ministral ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:VoxtralRealtime a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Voxtral Realtime"@en ;
    skos:definition "Voxtral Realtime is an optimized version of Voxtral, designed for real-time audio processing and understanding."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/voxtral_realtime> ;
    skos:related dlt:Voxtral ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:XCLIP a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "X-CLIP"@en ;
    skos:definition "X-CLIP is a minimal extension of CLIP for video. The model consists of a text encoder, a cross-frame vision encoder, a multi-frame integration Transformer, and a video-specific prompt generator."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/xclip> ;
    skos:related dlt:CLIP ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:DecisionTransformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Decision Transformer"@en ;
    skos:definition "Decision Transformer is a Transformer-based reinforcement learning model that formulates offline RL as a conditional sequence modeling problem, generating actions by conditioning on desired returns, past states, and actions."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/decision_transformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Autoformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Autoformer"@en ;
    skos:definition "This model augments the Transformer as a deep decomposition architecture, which can progressively decompose the trend and seasonal components during the forecasting process."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/autoformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Informer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Informer"@en ;
    skos:definition "This method introduces a Probabilistic Attention mechanism to select the “active” queries rather than the “lazy” queries and provides a sparse Transformer thus mitigating the quadratic compute and memory requirements of vanilla attention."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/informer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PatchTSMixer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PatchTSMixer"@en ;
    skos:definition "PatchTSMixer is a lightweight time-series modeling approach based on the MLP-Mixer architecture. In this HuggingFace implementation, we provide PatchTSMixer’s capabilities to effortlessly facilitate lightweight mixing across patches, channels, and hidden features for effective multivariate time-series modeling. It also supports various attention mechanisms starting from simple gated attention to more complex self-attention blocks that can be customized accordingly. The model can be pretrained and subsequently used for various downstream tasks such as forecasting, classification and regression."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/patchtsmixer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:PatchTST a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "PatchTST"@en ;
    skos:definition "The PatchTST model vectorizes time series into patches of a given size and encodes the resulting sequence of vectors via a Transformer that then outputs the prediction length forecast via an appropriate head. The model is illustrated in the following figure:"@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/patchtst> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TimeSeriesTransformer a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Time Series Transformer"@en ;
    skos:definition "The Time Series Transformer model is a vanilla encoder-decoder Transformer for time series forecasting."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/time_series_transformer> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TimesFM a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TimesFM"@en ;
    skos:definition "TimesFM (Time Series Foundation Model) is a pretrained time-series foundation model. It is a decoder only model that uses non-overlapping patches of time-series data as input and outputs some output patch length prediction in an autoregressive fashion."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/timesfm> ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:TimesFM25 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "TimesFM 2.5"@en ;
    skos:definition "TimesFM 2.5 (Time Series Foundation Model) is a pretrained time-series foundation model. It builds on the original TimesFM architecture with rotary attention, QK normalization, per-dimension attention scaling, and continuous quantile prediction."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/timesfm2_5> ;
    skos:related dlt:TimesFM ;
    skos:inScheme dlt:ModelFamilyScheme .