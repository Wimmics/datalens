dlt:GPT2LMHeadModel a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "GPT2LMHead Model"@en ;
    skos:definition "GPT-2 is a scaled up version of GPT, a causal transformer language model, with 10x more parameters and training data. The model was pretrained on a 40GB dataset to predict the next word in a sequence based on all the previous words. This approach enabled the model to perform many downstream tasks in a zero-shot setting. The blog post released by OpenAI can be found here."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/gpt2> ;
    skos:inScheme dlt:ModelFamilyScheme .

