      skos:broader dlt:ObjectDetection , dlt:ImageSegmentation ;
      skos:definition "Instance segmentation is the task of predicting exact pixel-wise boundaries of each individual object instance in an image."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Instance Segmentation"@en .

dlt:IntentClassification
      a       skos:Concept , dlo:SubTask ;
