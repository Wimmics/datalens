dlt:OpenBookQA
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://huggingface.co/tasks/question-answering> ;
      skos:broader dlt:QuestionAnswering , dlt:TextGeneration ;
      skos:definition "Open book question answering is the task of generating an answer directly based on context that correctly answers the question."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Open Book QA"@en .

dlt:TaskPlanning
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://en.wikipedia.org/wiki/Automated_planning_and_scheduling> ;
