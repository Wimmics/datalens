dlt:ClosedDomainQA
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://huggingface.co/tasks/question-answering> ;
      skos:broader dlt:QuestionAnswering ;
      skos:definition "Closed domain question answering is the task of generating or extracting an answer from context that correctly answers the question while being restricted to a specific domain."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Closed Domain QA"@en .

dlt:FaceDetection
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
