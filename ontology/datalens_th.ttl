dlt:AcceptabilityClassification
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      skos:broader dlt:TextClassification ;
      skos:definition "Acceptability classification is the task of predicting sentence acceptability based on grammatical correctness."@en ;
