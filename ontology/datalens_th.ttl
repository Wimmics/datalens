dlt:OpenDomainQA
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://www.wikidata.org/wiki/Q121409954> , <https://huggingface.co/tasks/question-answering> ;
      skos:broader dlt:QuestionAnswering ;
      skos:definition "Open domain question answering is the task of generating or extracting an answer from context that correctly answers the question without being restricted to a specific domain."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Open Domain QA"@en .

dlt:FactCheckingRetrieval
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://www.wikidata.org/wiki/Q59555084> , <https://www.wikidata.org/wiki/Q816826> ;
      skos:broader dlt:TextRetrieval ;
      skos:definition "Fact checking retrieval is the task of verifying information in non-fictional text to determine veracity and factual correctness by obtaining relevant information resources from a collection."@en ;
      skos:inScheme dlt:TaskScheme ;
      skos:prefLabel "Fact Checking Retrieval"@en .

