    skos:inScheme dlt:ModelFamilyScheme .

dlt:A194LogitEnsemble a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "A 194 Logit Ensemble"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:A2DGptNeox a skos:Concept, dlo:ModelFamily ;
