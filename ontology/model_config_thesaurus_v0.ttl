    skos:prefLabel "Abc Transformer"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:Abia a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Abia"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:AbirSlm a skos:Concept, dlo:ModelFamily ;
