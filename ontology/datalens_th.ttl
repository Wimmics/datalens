      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://huggingface.co/docs/transformers/tasks/multiple_choice> ;
      skos:broader dlt:MultipleChoice ;
