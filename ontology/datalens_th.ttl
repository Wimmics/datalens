dlt:SentimentAnalysis
      a       skos:Concept , dlo:SubTask ;
      dcterms:source <https://huggingface.co/api/datasets-tags-by-type?type=task_ids> ;
      owl:seeAlso <https://www.wikidata.org/wiki/Q2271421> ;
      skos:broader dlt:TextClassification ;
      skos:definition "Sentiment analysis is the task of determining the emotional tone or sentiment behind a piece of text."@en ;
      skos:inScheme dlt:TaskScheme ;
