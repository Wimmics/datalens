dlt:AutoModel a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Auto Model"@en ;
    skos:definition "In many cases, the architecture you want to use can be guessed from the name or the path of the pretrained model you are supplying to the from_pretrained() method. AutoClasses are here to do this job for you so that you automatically retrieve the relevant model given the name/path to the pretrained weights/config/vocabulary."@en ;
    skos:seeAlso <https://huggingface.co/docs/transformers/model_doc/auto> ;
    skos:inScheme dlt:ModelFamilyScheme .

