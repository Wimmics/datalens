dlt:ActionCodec a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Action Codec"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ActionPlanningAssistantV1 a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Action Planning Assistant V 1"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ActivationsGptNeo a skos:Concept, dlo:ModelFamily ;
    skos:prefLabel "Activations Gpt Neo"@en ;
    skos:inScheme dlt:ModelFamilyScheme .

dlt:ActivationsRoberta a skos:Concept, dlo:ModelFamily ;
